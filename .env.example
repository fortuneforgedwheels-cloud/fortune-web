# Copy this file to .env and fill in values from Shopify Theme Access.
# Never commit .env — it is gitignored.

# Your store's myshopify domain (already known for Fortune Forged)
SHOPIFY_FLAG_STORE=bb6223-6f.myshopify.com

# Password from the Shopify Theme Access app (starts with shptka_)
# Create at: Shopify Admin → Apps → Theme Access → Create theme password
SHOPIFY_CLI_THEME_TOKEN=

# Default push/preview target = DRAFT Fortune-Cursor-Rebuild (not live)
SHOPIFY_FLAG_THEME=188539207955
SHOPIFY_DRAFT_THEME_ID=188539207955
SHOPIFY_LIVE_THEME_ID=178099421459

# Optional: skip interactive CLI prompts in automation
SHOPIFY_FLAG_FORCE=1
