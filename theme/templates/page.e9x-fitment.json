      "blocks": {
        "tier_agg_a": {
          "type": "tier",
          "settings": {
            "tier_title": "Aggressive Street — Staggered A",
            "tier_intro": "<p>Ideal for the driver who wants to fill out the wheel wells with the widest possible rubber and perfectly flush offsets. Sometimes these fitments are a direct bolt-on, but oftentimes require small spacers, negative camber, or rolled fenders for the sake of dialing in the perfect blend of function and form.</p><p>Staggered setups maintain stock-like handling characteristics; tires can only be rotated left to right. Maximizes both front and rear tire width.</p>",
            "a_label": "Staggered · 18x9.5 / 18x10.5",
            "a_front": "18x9.5 ET22",
            "a_rear": "18x10.5 ET22",
            "a_notes": "Popular fitment. Front 275/35-18 tires can also be used. Rear 295/35-18 tires can be used but may require rolled fenders to prevent rubbing.",
            "a_tire_pick": "Front 265/35-18 // Rear 285/35-18",
            "a_tire_flags": "Direct fit · Popular fitment",
            "b_label": "Staggered · 18x10 / 18x11",
            "b_front": "18x10 ET25",
            "b_rear": "18x11 ET25",
            "b_notes": "Another popular staggered fitment that is a touch more aggressive than the 9.5/10.5 setup. About as wide as the front and rear fenders will take without extensive modifications — typically bolt-on. We typically do not recommend exceeding a 295 rear tire unless the car has a substantial power bump (supercharged / stroker). 5mm front spacers may be required with certain aftermarket suspensions for inner clearance. Front tires may lightly scrub inner fender liners at full lock; this usually self-clears over time.",
            "b_tire_pick": "Front 275/35-18 // Rear 295/35-18",
            "b_tire_flags": "May require rolled rear fenders · Popular aggressive stagger"
          }
        },
        "tier_agg_b": {
          "type": "tier",
          "settings": {
            "tier_title": "Aggressive Street — Staggered B",
            "tier_intro": "<p>19\" aggressive staggered options for E90 / E92 / E93 M3 and non-M builds.</p>",
            "a_label": "Staggered · 19x9.5 / 19x10.5",
            "a_front": "19x9.5 ET22",
            "a_rear": "19x10.5 ET22",
            "a_notes": "Rear can also be run at ET25 depending on design. Rear 295/30-19 tires can be used but may require rolled fenders to prevent rubbing.",
            "a_tire_pick": "Front 265/30-19 // Rear 285/30-19",
            "a_tire_flags": "Direct fit",
            "b_label": "Staggered · 19x10 / 19x10.5",
            "b_front": "19x10 ET25",
            "b_rear": "19x10.5 ET25",
            "b_notes": "5mm or larger front spacers may be required with certain aftermarket suspensions for inner clearance. A 19x9.5 ET22 front can be used to avoid those spacers. Rear rolled fenders may be required to prevent rubbing.",
            "b_tire_pick": "Front 275/30-19 // Rear 295/30-19",
            "b_tire_flags": "May require rolled rear fenders"
          }
        },
        "tier_agg_20": {
          "type": "tier",
          "settings": {
            "tier_title": "Aggressive Street — 20\"",
            "tier_intro": "<p>Flush 20\" staggered package. Specs below use a native rear offset so no rear spacers are required for flush fitment.</p>",
            "a_label": "Staggered · 20\"",
            "a_front": "20x9.5 ET22",
            "a_rear": "20x11 ET28",
            "a_notes": "Native ET28 rear replaces the common ET44 + 15–18mm rear spacer flush package (ET44 − 16mm ≈ ET28), so the wheel sits flush without spacers. 305/25-20 rear tires can also be used but rear fender rolling and/or additional negative camber may be required.",
            "a_tire_pick": "Front 255/30-20 // Rear 295/25-20",
            "a_tire_flags": "Flush without rear spacers · native ET28 rear"
          }
        },
        "tier_perf_square": {
          "type": "tier",
          "settings": {
            "tier_title": "Performance Street & Track — Square",
            "tier_intro": "<p>These fitments are effective for performance-oriented street cars, weekend track warriors, or even a dedicated race car. Suspension type, alignment, and tire brand/size can be changed to work for nearly any scenario.</p><p>Square setups are recommended for most street and performance driving — they allow proper front-to-rear tire rotation to extend tire life and improve handling balance.</p>",
            "a_label": "Square · 18x10\"",
            "a_front": "18x10 ET25",
            "a_rear": "18x10 ET25",
            "a_notes": "Popular fitment. Direct fit, but a 5mm front spacer may be required with certain aftermarket suspensions for inner clearance.",
            "a_tire_pick": "275/35-18 Front & Rear",
            "a_tire_flags": "Direct fit · Popular fitment",
            "b_label": "Square · 18x10.5\"",
            "b_front": "18x10.5 ET22",
            "b_rear": "18x10.5 ET22",
            "b_notes": "Uses all available real estate under the fender arches — coilovers with linear race springs are a must for inner clearance (JRZ, MCS, Ground Control, AST, Moton, etc.). Also popular with 275/35-18 R-compounds or slicks for sidewall support.",
            "b_tire_pick": "295/30-18 Front & Rear",
            "b_tire_flags": "Requires −3° or more front camber · race-spring coilovers required"
          }
        },
