    "ff_value_props_main": {
      "type": "ff-value-props",
      "blocks": {
        "value_tailored": {
          "type": "value",
          "settings": {
            "title": "FEA ANALYZED",
            "image": "shopify://shop_images/Screenshot_2026-07-27_at_11.35.47_PM.png",
            "text": "Every Fortune Forged wheel is engineered from the ground up using advanced Finite Element Analysis (FEA) to optimize strength, rigidity, and weight before production ever begins. Each design is digitally tested to simulate real-world cornering, braking, impact, and load forces, allowing us to remove unnecessary material while reinforcing high-stress areas. The result is a forged wheel that delivers maximum performance, uncompromising safety, and exceptional durability—custom-built for your vehicle rather than adapted from a generic off-the-shelf design.",
            "link_label": "VIRTUALLY TESTED. REAL-WORLD PROVEN.",
            "link": "shopify://collections/monoblock-wheels"
          }
        },
        "value_lighter": {
          "type": "value",
          "settings": {
            "title": "LIGHTER",
            "image": "shopify://shop_images/IMG_2128.jpg",
            "text": "Each wheel is machined from true aerospace grade 6061-T6 forged aluminum. Not cast or flow-formed construction. The forging process produces a denser, stronger grain structure, allowing our engineers to remove unnecessary material while maintaining exceptional structural integrity. The result is a wheel that is up to 25–30% lighter than a comparable cast wheel, reducing unsprung and rotational mass to improve acceleration, braking, steering response, and overall driving performance without compromising strength or durability.",
            "link_label": "FORGED STRENGTH WITHOUT EXCESS WEIGHT",
            "link": "shopify://collections/two-piece-wheels"
          }
        },
        "value_exclusive": {
          "type": "value",
          "settings": {
            "title": "Bespoke",
            "image": "shopify://shop_images/IMG_2125.jpg",
            "text": "We offer a virtually limitless customization to complement your vehicle's aesthetic. Choose from hand brushed, polished, chrome, satin, gloss, or custom powder-coated finishes, paired with bespoke hardware, center caps, and accent options. Whether configured as a monoblock, two-piece, or a beadlock design, each set is crafted to reflect your vision.",
            "link_label": "CUSTOM FINISHES & ONE-OFF BUILDS",
            "link": "shopify://collections/beadlock-wheels"
          }
        }
      },
      "block_order": [
        "value_tailored",
        "value_lighter",
        "value_exclusive"
