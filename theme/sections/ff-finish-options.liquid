{{ 'ff-finish-options.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section class="ff-fo" id="ff-fo-{{ section.id }}" data-ff-finish-options>
    {%- comment -%} 1) Hero {%- endcomment -%}
    <header class="ff-fo__hero">
      <div class="ff-fo__hero-media" aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-fo__hero-img',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              alt: ''
          }}
        {%- else -%}
          <div class="ff-fo__hero-fallback"></div>
        {%- endif -%}
        <div class="ff-fo__hero-shade"></div>
      </div>
      <div class="ff-fo__hero-copy">
        <h1 class="ff-fo__hero-title">{{ section.settings.hero_title | default: 'Finish Options' | escape }}</h1>
        {%- if section.settings.hero_logo != blank -%}
          {{
            section.settings.hero_logo
            | image_url: width: 480
            | image_tag:
              class: 'ff-fo__hero-logo',
              loading: 'eager',
              widths: '240, 360, 480',
              sizes: '180px',
              alt: section.settings.hero_logo_alt | default: 'Forged Club'
          }}
        {%- elsif section.settings.hero_brand != blank -%}
          <p class="ff-fo__hero-brand">{{ section.settings.hero_brand | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- liquid
      assign ff_fo_group_open = false
      assign ff_fo_swatches_open = false
    -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'color_group' -%}
          {%- if ff_fo_swatches_open -%}
              </div>
            {%- assign ff_fo_swatches_open = false -%}
          {%- endif -%}
          {%- if ff_fo_group_open -%}
              </div>
            </div>
            {%- assign ff_fo_group_open = false -%}
          {%- endif -%}

          <div class="ff-fo__group" id="ff-fo-group-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="ff-fo__group-inner">
              {%- if block.settings.heading != blank -%}
                <h2 class="ff-fo__group-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="ff-fo__group-copy">{{ block.settings.description }}</div>
              {%- endif -%}
              <div class="ff-fo__swatches">
          {%- assign ff_fo_group_open = true -%}
          {%- assign ff_fo_swatches_open = true -%}

        {%- when 'swatch' -%}
          {%- unless ff_fo_group_open -%}
            <div class="ff-fo__group">
              <div class="ff-fo__group-inner">
                <div class="ff-fo__swatches">
            {%- assign ff_fo_group_open = true -%}
            {%- assign ff_fo_swatches_open = true -%}
          {%- endunless -%}
          {%- if block.settings.name != blank or block.settings.image != blank -%}
            <figure class="ff-fo__swatch" {{ block.shopify_attributes }}>
              <div
                class="ff-fo__swatch-disc{% if block.settings.image != blank %} has-image{% endif %}"
                style="{% if block.settings.color != blank %}--ff-fo-swatch: {{ block.settings.color }};{% endif %}"
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 640
                    | image_tag:
                      class: 'ff-fo__swatch-img',
                      loading: 'lazy',
                      widths: '240, 360, 480, 640',
                      sizes: '(max-width: 749px) 30vw, 140px',
                      alt: block.settings.name | default: 'Finish swatch'
                  }}
                {%- else -%}
                  <span class="ff-fo__swatch-fallback" aria-hidden="true">
                    <svg viewBox="0 0 64 64" class="ff-fo__swatch-mark"><path d="M18 14h10l8 18 8-18h10L38 50H26L18 14z" fill="currentColor"/></svg>
                  </span>
                {%- endif -%}
              </div>
              {%- if block.settings.name != blank -%}
                <figcaption class="ff-fo__swatch-name">{{ block.settings.name | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}

        {%- when 'premium_intro' -%}
          {%- if ff_fo_swatches_open -%}
              </div>
            {%- assign ff_fo_swatches_open = false -%}
          {%- endif -%}
          {%- if ff_fo_group_open -%}
              </div>
            </div>
            {%- assign ff_fo_group_open = false -%}
          {%- endif -%}

          <div class="ff-fo__premium" id="ff-fo-premium-{{ block.id }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ff-fo__premium-media">
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'ff-fo__premium-img',
                    loading: 'lazy',
                    widths: '800, 1200, 1600, 2000',
                    sizes: '100vw',
                    alt: block.settings.image_alt | default: block.settings.heading | default: 'Premium Finish'
                }}
              </div>
            {%- endif -%}
            <div class="ff-fo__premium-copy">
              {%- if block.settings.heading != blank -%}
                <h2 class="ff-fo__premium-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="ff-fo__premium-sub">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.copy != blank -%}
                <div class="ff-fo__premium-body">{{ block.settings.copy }}</div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'divider_image' -%}
          {%- if ff_fo_swatches_open -%}
              </div>
            {%- assign ff_fo_swatches_open = false -%}
          {%- endif -%}
          {%- if ff_fo_group_open -%}
              </div>
            </div>
            {%- assign ff_fo_group_open = false -%}
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            <div class="ff-fo__divider" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 2200
                | image_tag:
                  class: 'ff-fo__divider-img',
                  loading: 'lazy',
                  widths: '900, 1400, 1800, 2200',
                  sizes: '100vw',
                  alt: block.settings.image_alt | default: ''
              }}
            </div>
          {%- endif -%}

        {%- when 'closing' -%}
          {%- if ff_fo_swatches_open -%}
              </div>
            {%- assign ff_fo_swatches_open = false -%}
          {%- endif -%}
          {%- if ff_fo_group_open -%}
              </div>
            </div>
            {%- assign ff_fo_group_open = false -%}
          {%- endif -%}

          <div class="ff-fo__closing" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ff-fo__closing-media">
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'ff-fo__closing-img',
                    loading: 'lazy',
                    widths: '800, 1200, 1600, 2000',
                    sizes: '(max-width: 989px) 100vw, 920px',
                    alt: block.settings.image_alt | default: 'Forged Club finish samples'
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="ff-fo__closing-caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- if ff_fo_swatches_open -%}
        </div>
    {%- endif -%}
    {%- if ff_fo_group_open -%}
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Finish Options",
  "tag": "section",
  "class": "section-ff-finish-options",
  "max_blocks": 80,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Tray of finish discs works best (edge-to-edge)."
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Finish Options"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero brand logo (Forged Club)"
    },
    {
      "type": "text",
      "id": "hero_logo_alt",
      "label": "Logo alt text",
      "default": "Forged Club"
    },
    {
      "type": "text",
      "id": "hero_brand",
      "label": "Brand text fallback",
      "default": "FORGED CLUB"
    },
    {
      "type": "paragraph",
      "content": "Add a Color group, then add Swatch blocks under it. Each swatch has its own image upload."
    }
  ],
  "blocks": [
    {
      "type": "color_group",
      "name": "Color group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "STANDARD COLOR"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Our standard opaque color finishes include gloss/satin Black, White, Gunmetal Grey, Champagne, Bronze, and Silver. All of our finishes are constructed of a solid color layer and a high-strength clear powder coat. Resulting in a finish that is stunning and guarantees quality.</p>"
        }
      ]
    },
    {
      "type": "swatch",
      "name": "Finish swatch",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Finish name",
          "default": "Black"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload swatch photo",
          "info": "Square crop of your finish disc / puck works best."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Fallback color (if no photo)",
          "default": "#888888"
        }
      ]
    },
    {
      "type": "premium_intro",
      "name": "Premium intro",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload feature image",
          "info": "Car / lifestyle image above the Premium Finish copy."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "PREMIUM FINISH"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "BRUSHED / POLISH"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Copy",
          "default": "<p>Step into the realm of sophistication with our Premium Finish. Either brushed or polished, each with a transparent top coat to provide protection and complete the look.</p><p>Brushed finish offers timeless, premium, hand-crafted aesthetics done by the most skilled technicians.</p><p>Polished finish provides an immaculate, mirror-like shine that reflects a clean and high-class aesthetic.</p>"
        }
      ]
    },
    {
      "type": "divider_image",
      "name": "Full-bleed image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text"
        }
      ]
    },
    {
      "type": "closing",
      "name": "Closing visual",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload closing image",
          "info": "Forged Club sample box / palette shot."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text",
          "default": "Forged Club finish samples"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "FORGED CLUB — Get Ready"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Finish Options",
      "blocks": [
        { "type": "color_group", "settings": { "heading": "STANDARD COLOR" } },
        { "type": "swatch", "settings": { "name": "Black", "color": "#111111" } },
        { "type": "swatch", "settings": { "name": "White", "color": "#EDE8DF" } },
        { "type": "swatch", "settings": { "name": "Silver", "color": "#C5C8CC" } },
        { "type": "swatch", "settings": { "name": "Gunmetal Grey", "color": "#4B4F55" } },
        { "type": "swatch", "settings": { "name": "Champagne", "color": "#C4B08A" } },
        { "type": "swatch", "settings": { "name": "Bronze", "color": "#8A5A2B" } },
        {
          "type": "color_group",
          "settings": {
            "heading": "SPECIAL COLOR",
            "description": "<p>Upgrade your wheel aesthetics with our exclusive Special Color Finishes, a premium selection that offers a wide variety of color choices beyond our standard palette. These showcase an array of both metallic and flat colors to give your vehicle a unique and personal edge.</p>"
          }
        },
        { "type": "swatch", "settings": { "name": "Pearl White", "color": "#EFE6D8" } },
        { "type": "swatch", "settings": { "name": "24K Gold", "color": "#C6A24A" } },
        { "type": "swatch", "settings": { "name": "Candy Red", "color": "#9B1C1C" } },
        { "type": "swatch", "settings": { "name": "Indigo Blue", "color": "#3A4F7A" } },
        { "type": "swatch", "settings": { "name": "Ambergold", "color": "#8A6A2F" } },
        { "type": "swatch", "settings": { "name": "Rose Gold", "color": "#C9A7A0" } },
        { "type": "swatch", "settings": { "name": "Olive", "color": "#6B6B3A" } },
        { "type": "swatch", "settings": { "name": "Dusty Blue", "color": "#6F8599" } },
        { "type": "swatch", "settings": { "name": "Navy", "color": "#1C2A44" } },
        { "type": "swatch", "settings": { "name": "Burnt Orange", "color": "#C45A1A" } },
        { "type": "swatch", "settings": { "name": "Lime", "color": "#A8C23A" } },
        { "type": "swatch", "settings": { "name": "Gloss Black", "color": "#0A0A0A" } },
        { "type": "premium_intro" },
        {
          "type": "color_group",
          "settings": {
            "heading": "BRUSHED / POLISH",
            "description": "<p>Step into the realm of sophistication with our Premium Finish. Either brushed or polished, each with a transparent top coat to provide protection and complete the look.</p><p>Brushed finish offers timeless, premium, hand-crafted aesthetics done by the most skilled technicians.</p><p>Polished finish provides an immaculate, mirror-like shine that reflects a clean and high-class aesthetic.</p>"
          }
        },
        { "type": "swatch", "settings": { "name": "Polish Clear", "color": "#D7DADF" } },
        { "type": "swatch", "settings": { "name": "Brushed Clear", "color": "#B8BDC4" } },
        { "type": "swatch", "settings": { "name": "Satin Clear", "color": "#8E949B" } },
        { "type": "swatch", "settings": { "name": "Dark Clear", "color": "#3A3D42" } },
        { "type": "swatch", "settings": { "name": "Blue Clear", "color": "#2F4D7A" } },
        { "type": "swatch", "settings": { "name": "Bronze Clear", "color": "#7A5530" } },
        { "type": "closing" }
      ]
    }
  ]
}
{% endschema %}
