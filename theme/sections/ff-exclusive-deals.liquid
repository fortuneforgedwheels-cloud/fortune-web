{{ 'ff-exclusive-deals-v3.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-exclusive-deals-v3.js' | asset_url }}" defer></script>

{%- liquid
  assign brand_title = section.settings.heading | default: 'Exclusive deals'
  if brand_title == blank
    assign brand_title = 'Exclusive deals'
  endif
  assign gloss_finishes = 'Gloss Black,Gloss Bronze,Gloss Gunmetal,Gloss Silver,Gloss White,Gloss Champagne Gold' | split: ','
  assign satin_finishes = 'Satin Black,Satin Gunmetal,Satin Bronze,Motorsport Gold,OEM 827M CS Satin Gold,Satin Titanium,Satin Graphite,Satin Silver,Satin Anthracite,Satin White' | split: ','
  assign brushed_finishes = 'Brushed Clear (#1 Best Seller),Brushed Titanium,Brushed Bronze,Brushed Champagne,Brushed Light Gold,Brushed Gunmetal,Brushed Graphite,Brushed Black,Brushed Silver,Brushed Copper' | split: ','
  assign polished_finishes = 'Polished' | split: ','
  assign specs_example = section.settings.specs_example | default: 'Front: 20x10 ET10 / Rear 20x11 ET12'

  assign deal_price_cents = section.settings.deal_price | times: 100
  assign compare_price_cents = section.settings.compare_at_price | times: 100
  if deal_price_cents == blank or deal_price_cents == 0
    assign deal_price_cents = 205000
  endif
  if compare_price_cents == blank or compare_price_cents == 0
    assign compare_price_cents = 337900
  endif

  assign checkout_product = section.settings.checkout_product
  if checkout_product == blank
    assign checkout_product = all_products['exclusive-deals-full-set']
  endif
  assign checkout_variant = blank
  if checkout_product != blank
    assign checkout_variant = checkout_product.selected_or_first_available_variant
  endif
-%}

<section
  class="ff-xd"
  id="ff-xd-{{ section.id }}"
  data-ff-exclusive-deals
  data-money-format="{{ shop.money_format | escape }}"
  data-full-set-label="{{ section.settings.full_set_label | default: 'Full set' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="ff-xd__hero">
    <div class="ff-xd__hero-media" data-ff-autoplay-video aria-hidden="true">
      {%- if section.settings.hero_video != blank -%}
        {% render 'ff-autoplay-video',
          video: section.settings.hero_video,
          poster: section.settings.hero_image,
          class: 'ff-xd__hero-video'
        %}
      {%- elsif section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'ff-xd__hero-img',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: brand_title
        }}
      {%- else -%}
        <span class="ff-xd__hero-fallback">
          {%- if request.design_mode -%}
            <span class="ff-xd__hero-fallback-note">Add a Hero video (MP4) in this section’s settings.</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
    <div class="ff-xd__hero-shade" aria-hidden="true"></div>
    <div class="ff-xd__hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ff-xd__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="ff-xd__title">{{ brand_title | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="ff-xd__lede">{{ section.settings.description }}</div>
      {%- elsif request.design_mode -%}
        <p class="ff-xd__lede">Add a description and hero video in this section’s settings.</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ff-xd__deals" id="ff-xd-deals">
    <div class="ff-xd__deals-inner">
      {%- if section.settings.deals_heading != blank -%}
        <header class="ff-xd__deals-header">
          {%- if section.settings.deals_eyebrow != blank -%}
            <p class="ff-xd__eyebrow">{{ section.settings.deals_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="ff-xd__deals-heading">{{ section.settings.deals_heading | escape }}</h2>
          {%- if section.settings.deals_copy != blank -%}
            <p class="ff-xd__deals-copy">{{ section.settings.deals_copy | escape }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="ff-xd__grid">
        {%- assign deal_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'deal' -%}
            {%- assign deal_count = deal_count | plus: 1 -%}
            {%- liquid
              assign deal = block.settings.product
              assign deal_title = block.settings.title
              assign deal_image = block.settings.image
              assign deal_blurb = block.settings.blurb
              if deal_title == blank and deal != blank
                assign deal_title = deal.title
              endif
              if deal_image == blank and deal != blank
                assign deal_image = deal.featured_image
              endif

              assign atc_variant = checkout_variant
              if atc_variant == blank and deal != blank
                assign atc_variant = deal.selected_or_first_available_variant
              endif
            -%}

            <article
              class="ff-xd__card{% if deal == blank or atc_variant == blank %} is-disabled{% endif %}"
              data-ff-xd-card
              {% if deal != blank and atc_variant != blank %}
                data-ff-xd-open
                data-design="{{ deal_title | escape }}"
                data-product-id="{{ deal.id }}"
                data-variant-id="{{ atc_variant.id }}"
                data-product-url="{{ deal.url }}"
                {% if deal_image != blank %}data-image="{{ deal_image | image_url: width: 900 }}"{% endif %}
                tabindex="0"
                role="button"
                aria-haspopup="dialog"
                aria-controls="ff-xd-modal-{{ section.id }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge != blank -%}
                <p class="ff-xd__badge">{{ block.settings.badge | escape }}</p>
              {%- endif -%}

              <div class="ff-xd__card-media">
                {%- if deal_image != blank -%}
                  {{
                    deal_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ff-xd__card-img',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1200',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      alt: deal_title
                  }}
                {%- else -%}
                  <span class="ff-xd__card-media-empty" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              <div class="ff-xd__card-body">
                <h3 class="ff-xd__card-title">{{ deal_title | default: 'Monoblock design' | escape }}</h3>
                {%- if deal_blurb != blank -%}
                  <p class="ff-xd__card-blurb">{{ deal_blurb | escape }}</p>
                {%- elsif deal != blank and deal.description != blank -%}
                  <p class="ff-xd__card-blurb">{{ deal.description | strip_html | truncate: 120 }}</p>
                {%- endif -%}

                {%- if deal != blank -%}
                  <div class="ff-xd__card-footer">
                    <div class="ff-xd__price-stack">
                      <p class="ff-xd__compare-price">{{ compare_price_cents | money }}</p>
                      <p class="ff-xd__deal-price">{{ deal_price_cents | money }}</p>
                      <p class="ff-xd__set-note">{{ section.settings.full_set_label | default: 'Full set' | escape }}</p>
                    </div>
                    <span class="ff-xd__select-cta">{{ section.settings.card_cta | default: 'Select design' | escape }}</span>
                  </div>
                {%- else -%}
                  <p class="ff-xd__missing">
                    {%- if request.design_mode -%}
                      Select a monoblock product in this deal block’s settings.
                    {%- else -%}
                      {{ section.settings.missing_product_message | default: 'Deal unavailable.' | escape }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}

        {%- if deal_count == 0 and request.design_mode -%}
          <p class="ff-xd__missing">Add up to 7 Deal blocks and pick a monoblock product for each.</p>
        {%- endif -%}
      </div>

      {%- if checkout_product == blank and request.design_mode -%}
        <p class="ff-xd__missing">
          Set the Full-set checkout product in section settings (handle <code>exclusive-deals-full-set</code>), priced at {{ deal_price_cents | money }} with compare-at {{ compare_price_cents | money }}.
        </p>
      {%- endif -%}
    </div>
  </div>

  <div
    class="ff-xd__modal"
    id="ff-xd-modal-{{ section.id }}"
    data-ff-xd-modal
    data-submit-specialist-label="{{ section.settings.submit_specialist_label | default: 'Add full set to cart' | escape }}"
    data-submit-specs-label="{{ section.settings.submit_specs_label | default: 'Add full set to cart' | escape }}"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="ff-xd-modal-title-{{ section.id }}"
  >
    <button type="button" class="ff-xd__modal-backdrop" data-ff-xd-close aria-label="Close"></button>
    <div class="ff-xd__dialog" role="document">
      <button type="button" class="ff-xd__modal-close" data-ff-xd-close aria-label="Close">×</button>

      <div class="ff-xd__dialog-top">
        <div class="ff-xd__dialog-media">
          <img class="ff-xd__dialog-img" data-ff-xd-dialog-img src="" alt="" width="600" height="600" hidden>
          <span class="ff-xd__dialog-img-empty" data-ff-xd-dialog-img-empty aria-hidden="true"></span>
        </div>
        <div class="ff-xd__dialog-intro">
          <p class="ff-xd__eyebrow">{{ section.settings.modal_eyebrow | default: 'EXCLUSIVE DEAL' | escape }}</p>
          <h2 class="ff-xd__dialog-title" id="ff-xd-modal-title-{{ section.id }}" data-ff-xd-dialog-title>Design</h2>
          <div class="ff-xd__modal-price" aria-label="Deal pricing">
            <span class="ff-xd__compare-price">{{ compare_price_cents | money }}</span>
            <span class="ff-xd__deal-price">{{ deal_price_cents | money }}</span>
            <span class="ff-xd__price-today">{{ section.settings.today_price_label | default: "Today’s price" | escape }}</span>
          </div>
          <p class="ff-xd__dialog-lead">{{ section.settings.modal_lead | default: 'One add-to-cart = the full set. Same exclusive price on every design. Choose finish + fitment path, then checkout.' | escape }}</p>
        </div>
      </div>

      <form class="ff-xd__form" data-ff-xd-form novalidate>
        <input type="hidden" data-ff-xd-design-input value="">
        <input type="hidden" data-ff-xd-product-id value="">
        <input type="hidden" data-ff-xd-variant-id value="{% if checkout_variant != blank %}{{ checkout_variant.id }}{% endif %}">
        <input type="hidden" data-ff-xd-help-preference value="Let a specialist handle it">
        <input type="hidden" data-ff-xd-finish-input value="">

        <div class="ff-xd__path" role="radiogroup" aria-label="How should we help?">
          <p class="ff-xd__label">How should we help?</p>
          <button
            type="button"
            class="ff-xd__choice is-selected"
            data-ff-xd-help-mode="specialist"
            aria-pressed="true"
          >
            <span>
              <strong>{{ section.settings.path_specialist_title | default: 'Let a specialist handle it' | escape }}</strong>
              <em>{{ section.settings.path_specialist_copy | default: 'Pick a finish and your vehicle — we’ll follow up after checkout to sort proper fitment.' | escape }}</em>
            </span>
          </button>
          <button
            type="button"
            class="ff-xd__choice"
            data-ff-xd-help-mode="specs"
            aria-pressed="false"
          >
            <span>
              <strong>{{ section.settings.path_specs_title | default: 'I know my specs' | escape }}</strong>
              <em>{{ section.settings.path_specs_copy | default: 'Pick a finish, enter your sizes, and your year / make / model.' | escape }}</em>
            </span>
          </button>
        </div>

        <div class="ff-xd__fields">
          <div class="ff-xd__field ff-xd__field--full">
            <p class="ff-xd__label" id="ff-xd-finish-label-{{ section.id }}">{{ section.settings.finish_label | default: 'Wheel finish' | escape }}*</p>
            <div
              class="ff-xd__sheens"
              role="group"
              aria-labelledby="ff-xd-finish-label-{{ section.id }}"
              data-ff-xd-finishes
            >
              {%- assign sheen_families = 'Brushed,Satin,Gloss,Polished' | split: ',' -%}
              <div class="ff-xd__sheen-grid">
                {%- for sheen in sheen_families -%}
                  {%- assign sheen_key = sheen | downcase -%}
                  <div class="ff-xd__sheen" data-ff-xd-sheen="{{ sheen_key | escape }}">
                    <button
                      type="button"
                      class="ff-xd__sheen-trigger"
                      data-ff-xd-sheen-trigger
                      aria-expanded="false"
                      aria-controls="ff-xd-sheen-panel-{{ sheen_key }}-{{ section.id }}"
                    >
                      <span class="ff-xd__sheen-name">{{ sheen | escape }}</span>
                      <span class="ff-xd__sheen-picked" data-ff-xd-sheen-picked hidden></span>
                    </button>
                  </div>
                {%- endfor -%}
              </div>

              <div class="ff-xd__sheen-panels">
                {%- for sheen in sheen_families -%}
                  {%- assign sheen_key = sheen | downcase -%}
                  {%- if sheen_key == 'gloss' -%}
                    {%- assign sheen_options = gloss_finishes -%}
                  {%- elsif sheen_key == 'satin' -%}
                    {%- assign sheen_options = satin_finishes -%}
                  {%- elsif sheen_key == 'brushed' -%}
                    {%- assign sheen_options = brushed_finishes -%}
                  {%- else -%}
                    {%- assign sheen_options = polished_finishes -%}
                  {%- endif -%}
                  <div
                    class="ff-xd__sheen-panel"
                    id="ff-xd-sheen-panel-{{ sheen_key }}-{{ section.id }}"
                    data-ff-xd-sheen-panel="{{ sheen_key | escape }}"
                  >
                    {%- for finish in sheen_options -%}
                      {%- assign finish_name = finish | strip -%}
                      {%- if finish_name != blank -%}
                        <button
                          type="button"
                          class="ff-xd__sheen-option"
                          data-ff-xd-finish="{{ finish_name | escape }}"
                          data-finish-family="{{ sheen_key | escape }}"
                        >
                          {{ finish_name | escape }}
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <div class="ff-xd__field ff-xd__field--full" data-ff-xd-specs-wrap hidden>
            <label class="ff-xd__label" for="ff-xd-specs-{{ section.id }}">{{ section.settings.specs_label | default: 'Wheel specs' | escape }}*</label>
            <input
              class="ff-xd__input"
              id="ff-xd-specs-{{ section.id }}"
              type="text"
              data-ff-xd-specs
              placeholder="{{ specs_example | escape }}"
              autocomplete="off"
            >
            <p class="ff-xd__hint">Example: {{ specs_example | escape }}</p>
          </div>

          <div class="ff-xd__field ff-xd__field--full">
            <label class="ff-xd__label" for="ff-xd-ymm-{{ section.id }}">{{ section.settings.ymm_label | default: 'Year / Make / Model' | escape }}*</label>
            <input
              class="ff-xd__input"
              id="ff-xd-ymm-{{ section.id }}"
              type="text"
              required
              data-ff-xd-ymm
              placeholder="{{ section.settings.ymm_placeholder | default: 'e.g. 2024 BMW G80 M3' | escape }}"
              autocomplete="off"
            >
          </div>

          <div class="ff-xd__field ff-xd__field--full">
            <label class="ff-xd__label" for="ff-xd-notes-{{ section.id }}">Notes</label>
            <textarea
              class="ff-xd__input ff-xd__textarea"
              id="ff-xd-notes-{{ section.id }}"
              data-ff-xd-notes
              rows="3"
              placeholder="{{ section.settings.notes_placeholder | default: 'Anything else about your build (optional).' | escape }}"
            ></textarea>
          </div>
        </div>

        <p class="ff-xd__assist" data-ff-xd-assist>
          {{ section.settings.specialist_note | default: 'Adds 1 full set to cart at today’s exclusive price. A specialist will follow up after checkout to confirm fitment.' | escape }}
        </p>
        <p class="ff-xd__error" data-ff-xd-error hidden role="alert"></p>

        <button type="submit" class="ff-xd__submit" data-ff-xd-submit {% unless checkout_variant %}disabled{% endunless %}>
          {{ section.settings.submit_specialist_label | default: 'Add full set to cart' | escape }}
        </button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Exclusive Deals",
  "tag": "div",
  "class": "ff-xd-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video (MP4)",
      "info": "Full-bleed autoplay video at the top of the page. Theme Editor media wins — re-select after theme updates if it goes blank."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero poster / fallback image",
      "info": "Optional. Used as the video poster, or as the hero if no video is set."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRIVATE ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exclusive deals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Private monoblock deals — pick a design and add the full set to cart at today’s exclusive price.</p>"
    },
    {
      "type": "header",
      "content": "Exclusive pricing (same for every design)"
    },
    {
      "type": "number",
      "id": "compare_at_price",
      "label": "Original / compare-at price",
      "default": 3379,
      "info": "Shown crossed out. Example: 3379"
    },
    {
      "type": "number",
      "id": "deal_price",
      "label": "Today’s deal price",
      "default": 2050,
      "info": "Shown as today’s price. Checkout uses the Full-set checkout product below — keep that product priced the same."
    },
    {
      "type": "text",
      "id": "today_price_label",
      "label": "Today’s price label",
      "default": "Today’s price"
    },
    {
      "type": "text",
      "id": "full_set_label",
      "label": "Full-set label",
      "default": "Full set"
    },
    {
      "type": "product",
      "id": "checkout_product",
      "label": "Full-set checkout product",
      "info": "ONE line item added to cart for any design. Price this product at today’s deal price with compare-at set to the original. Default handle: exclusive-deals-full-set"
    },
    {
      "type": "header",
      "content": "Deals grid"
    },
    {
      "type": "text",
      "id": "deals_eyebrow",
      "label": "Deals eyebrow",
      "default": "TOP MONOBLOCKS"
    },
    {
      "type": "text",
      "id": "deals_heading",
      "label": "Deals heading",
      "default": "Choose your design"
    },
    {
      "type": "textarea",
      "id": "deals_copy",
      "label": "Deals supporting copy",
      "default": "Each design is the same exclusive full-set price. One add to cart = the complete set."
    },
    {
      "type": "text",
      "id": "card_cta",
      "label": "Card CTA",
      "default": "Select design"
    },
    {
      "type": "text",
      "id": "missing_product_message",
      "label": "Missing product message",
      "default": "Deal unavailable."
    },
    {
      "type": "header",
      "content": "Checkout modal"
    },
    {
      "type": "text",
      "id": "modal_eyebrow",
      "label": "Modal eyebrow",
      "default": "EXCLUSIVE DEAL"
    },
    {
      "type": "textarea",
      "id": "modal_lead",
      "label": "Modal lead",
      "default": "One add-to-cart = the full set. Same exclusive price on every design. Choose finish + fitment path, then checkout."
    },
    {
      "type": "text",
      "id": "path_specialist_title",
      "label": "Specialist path title",
      "default": "Let a specialist handle it"
    },
    {
      "type": "text",
      "id": "path_specialist_copy",
      "label": "Specialist path description",
      "default": "Pick a finish and your vehicle — we’ll follow up after checkout to sort proper fitment."
    },
    {
      "type": "text",
      "id": "path_specs_title",
      "label": "Specs path title",
      "default": "I know my specs"
    },
    {
      "type": "text",
      "id": "path_specs_copy",
      "label": "Specs path description",
      "default": "Pick a finish, enter your sizes, and your year / make / model."
    },
    {
      "type": "text",
      "id": "finish_label",
      "label": "Finish label",
      "default": "Wheel finish"
    },
    {
      "type": "paragraph",
      "content": "Finish choices are fixed as Gloss / Satin / Brushed / Polished dropdowns on this page."
    },
    {
      "type": "text",
      "id": "specs_label",
      "label": "Specs label",
      "default": "Wheel specs"
    },
    {
      "type": "text",
      "id": "specs_example",
      "label": "Specs example / placeholder",
      "default": "Front: 20x10 ET10 / Rear 20x11 ET12"
    },
    {
      "type": "text",
      "id": "ymm_label",
      "label": "Vehicle label",
      "default": "Year / Make / Model"
    },
    {
      "type": "text",
      "id": "ymm_placeholder",
      "label": "Vehicle placeholder",
      "default": "e.g. 2024 BMW G80 M3"
    },
    {
      "type": "text",
      "id": "notes_placeholder",
      "label": "Notes placeholder",
      "default": "Anything else about your build (optional)."
    },
    {
      "type": "textarea",
      "id": "specialist_note",
      "label": "Specialist assist note",
      "default": "Adds 1 full set to cart at today’s exclusive price. A specialist will follow up after checkout to confirm fitment."
    },
    {
      "type": "text",
      "id": "submit_specialist_label",
      "label": "Add to cart label (specialist)",
      "default": "Add full set to cart"
    },
    {
      "type": "text",
      "id": "submit_specs_label",
      "label": "Add to cart label (specs)",
      "default": "Add full set to cart"
    }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Deal",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Monoblock design product",
          "info": "Used for the card image/title. Checkout always adds the Full-set checkout product (qty 1 = full set)."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Optional. Example: Exclusive, Limited"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Short description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exclusive Deals",
      "blocks": [
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" }
      ]
    }
  ]
}
{% endschema %}
