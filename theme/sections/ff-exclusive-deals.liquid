{{ 'ff-exclusive-deals.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-exclusive-deals.js' | asset_url }}" defer></script>

{%- liquid
  assign brand_title = section.settings.heading | default: 'Exclusive deals'
  if brand_title == blank
    assign brand_title = 'Exclusive deals'
  endif
-%}

<section
  class="ff-xd"
  id="ff-xd-{{ section.id }}"
  data-ff-exclusive-deals
  {{ section.shopify_attributes }}
>
  <div class="ff-xd__hero">
    <div class="ff-xd__hero-media" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'ff-xd__hero-img',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: brand_title
        }}
      {%- else -%}
        <span class="ff-xd__hero-fallback"></span>
      {%- endif -%}
    </div>
    <div class="ff-xd__hero-shade" aria-hidden="true"></div>
    <div class="ff-xd__hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ff-xd__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="ff-xd__title">{{ brand_title | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="ff-xd__lede">{{ section.settings.description }}</div>
      {%- elsif request.design_mode -%}
        <p class="ff-xd__lede">Add a description and hero image in this section’s settings.</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ff-xd__deals" id="ff-xd-deals">
    <div class="ff-xd__deals-inner">
      {%- if section.settings.deals_heading != blank -%}
        <header class="ff-xd__deals-header">
          {%- if section.settings.deals_eyebrow != blank -%}
            <p class="ff-xd__eyebrow">{{ section.settings.deals_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="ff-xd__deals-heading">{{ section.settings.deals_heading | escape }}</h2>
          {%- if section.settings.deals_copy != blank -%}
            <p class="ff-xd__deals-copy">{{ section.settings.deals_copy | escape }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="ff-xd__grid">
        {%- assign deal_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'deal' -%}
            {%- assign deal_count = deal_count | plus: 1 -%}
            {%- liquid
              assign deal = block.settings.product
              assign deal_title = block.settings.title
              assign deal_image = block.settings.image
              assign deal_blurb = block.settings.blurb
              if deal_title == blank and deal != blank
                assign deal_title = deal.title
              endif
              if deal_image == blank and deal != blank
                assign deal_image = deal.featured_image
              endif
              assign current_variant = blank
              if deal != blank
                assign current_variant = deal.selected_or_first_available_variant
              endif
            -%}

            <article class="ff-xd__card" data-ff-xd-card {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <p class="ff-xd__badge">{{ block.settings.badge | escape }}</p>
              {%- endif -%}

              <div class="ff-xd__card-media">
                {%- if deal_image != blank -%}
                  {{
                    deal_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ff-xd__card-img',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1200',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      alt: deal_title
                  }}
                {%- else -%}
                  <span class="ff-xd__card-media-empty" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              <div class="ff-xd__card-body">
                <h3 class="ff-xd__card-title">{{ deal_title | escape }}</h3>
                {%- if deal_blurb != blank -%}
                  <p class="ff-xd__card-blurb">{{ deal_blurb | escape }}</p>
                {%- elsif deal != blank and deal.description != blank -%}
                  <p class="ff-xd__card-blurb">{{ deal.description | strip_html | truncate: 140 }}</p>
                {%- endif -%}

                {%- if deal != blank and current_variant != blank -%}
                  <div
                    class="ff-xd__buy"
                    data-ff-xd-buy
                    data-product-id="{{ deal.id }}"
                    data-money-format="{{ shop.money_format | escape }}"
                  >
                    <script type="application/json" data-ff-xd-variants>
                      [
                        {%- for variant in deal.variants -%}
                          {
                            "id": {{ variant.id | json }},
                            "available": {{ variant.available | json }},
                            "price": {{ variant.price | json }},
                            "compare_at_price": {{ variant.compare_at_price | json }},
                            "title": {{ variant.title | json }},
                            "option1": {{ variant.option1 | json }},
                            "option2": {{ variant.option2 | json }},
                            "option3": {{ variant.option3 | json }},
                            "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}
                          }{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ]
                    </script>

                    {%- unless deal.has_only_default_variant -%}
                      {%- for option in deal.options_with_values -%}
                        {%- assign option_index = forloop.index0 -%}
                        <div class="ff-xd__option" data-ff-xd-option data-option-index="{{ option_index }}">
                          <p class="ff-xd__option-label">{{ option.name | escape }}</p>
                          <div class="ff-xd__option-values" role="listbox" aria-label="{{ option.name | escape }}">
                            {%- liquid
                              assign active_value = current_variant.options[option_index]
                            -%}
                            {%- for value in option.values -%}
                              {%- liquid
                                assign is_active = false
                                if value == active_value
                                  assign is_active = true
                                endif
                              -%}
                              <button
                                type="button"
                                class="ff-xd__chip{% if is_active %} is-active{% endif %}"
                                role="option"
                                aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                                data-ff-xd-option-value="{{ value | escape }}"
                              >
                                {{ value | escape }}
                              </button>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- endunless -%}

                    <div class="ff-xd__price-row">
                      <p class="ff-xd__price" data-ff-xd-price>
                        {{ current_variant.price | money }}
                        {%- if current_variant.compare_at_price > current_variant.price -%}
                          <span class="ff-xd__compare">{{ current_variant.compare_at_price | money }}</span>
                        {%- endif -%}
                      </p>
                      <div class="ff-xd__qty">
                        <button type="button" class="ff-xd__qty-btn" data-ff-xd-qty-minus aria-label="Decrease quantity">−</button>
                        <input
                          class="ff-xd__qty-input"
                          type="number"
                          value="1"
                          min="1"
                          max="20"
                          step="1"
                          inputmode="numeric"
                          data-ff-xd-qty
                          aria-label="Quantity"
                        >
                        <button type="button" class="ff-xd__qty-btn" data-ff-xd-qty-plus aria-label="Increase quantity">+</button>
                      </div>
                    </div>

                    <p class="ff-xd__error" data-ff-xd-error hidden role="alert"></p>

                    <button
                      type="button"
                      class="ff-xd__atc"
                      data-ff-xd-atc
                      data-variant-id="{{ current_variant.id }}"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ section.settings.atc_label | default: 'Add to cart' | escape }}
                      {%- else -%}
                        Sold out
                      {%- endif -%}
                    </button>
                  </div>
                {%- else -%}
                  <p class="ff-xd__missing">
                    {%- if request.design_mode -%}
                      Select a monoblock product in this deal block’s settings.
                    {%- else -%}
                      {{ section.settings.missing_product_message | default: 'Deal unavailable.' | escape }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}

        {%- if deal_count == 0 and request.design_mode -%}
          <p class="ff-xd__missing">Add up to 5 Deal blocks and pick a monoblock product for each.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Exclusive Deals",
  "tag": "div",
  "class": "ff-xd-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRIVATE ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exclusive deals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Private monoblock deals — five designs, special pricing. Pick your options and check out.</p>"
    },
    {
      "type": "header",
      "content": "Deals grid"
    },
    {
      "type": "text",
      "id": "deals_eyebrow",
      "label": "Deals eyebrow",
      "default": "TOP 5 MONOBLOCKS"
    },
    {
      "type": "text",
      "id": "deals_heading",
      "label": "Deals heading",
      "default": "Choose your design"
    },
    {
      "type": "textarea",
      "id": "deals_copy",
      "label": "Deals supporting copy"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "missing_product_message",
      "label": "Missing product message",
      "default": "Deal unavailable."
    }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Deal",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Monoblock product",
          "info": "Each product can have different Shopify options/variants — they show automatically."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Optional. Example: Exclusive, 15% off"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Short description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exclusive Deals",
      "blocks": [
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" }
      ]
    }
  ]
}
{% endschema %}
