{{ 'ff-new-products.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- liquid
    assign left_collection = collections[section.settings.left_collection]
    assign right_collection = collections[section.settings.right_collection]
    assign product_limit = section.settings.product_limit | default: 8
    assign interval_ms = section.settings.cycle_ms | default: 5 | times: 1000
  -%}

  <section
    class="ff-new"
    id="ff-new-{{ section.id }}"
    data-ff-new
    style="
      --ff-new-pad-top: {{ section.settings.padding_top }}px;
      --ff-new-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ff-new__inner">
      {%- if section.settings.bar_left != blank or section.settings.bar_right != blank -%}
        <div class="ff-new__bar">
          {%- if section.settings.bar_left != blank -%}
            <p class="ff-new__bar-left">{{ section.settings.bar_left | escape }}</p>
          {%- else -%}
            <span></span>
          {%- endif -%}
          {%- if section.settings.bar_right != blank -%}
            <p class="ff-new__bar-right">{{ section.settings.bar_right | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ff-new__grid">
        {%- for side in (1..2) -%}
          {%- liquid
            if side == 1
              assign col_collection = left_collection
              assign col_label = section.settings.left_label
              assign col_empty = section.settings.left_empty
              assign col_view_label = section.settings.left_view_label
              assign col_view_link = section.settings.left_view_link
              if col_view_link == blank and col_collection != blank
                assign col_view_link = col_collection.url
              endif
            else
              assign col_collection = right_collection
              assign col_label = section.settings.right_label
              assign col_empty = section.settings.right_empty
              assign col_view_label = section.settings.right_view_label
              assign col_view_link = section.settings.right_view_link
              if col_view_link == blank and col_collection != blank
                assign col_view_link = col_collection.url
              endif
            endif
          -%}

          <article class="ff-new__col" data-ff-new-col data-ff-new-interval="{{ interval_ms }}">
            {%- if col_label != blank -%}
              <h3 class="ff-new__label">{{ col_label | escape }}</h3>
            {%- endif -%}

            <div class="ff-new__stage">
              {%- if col_collection != blank and col_collection.products_count > 0 -%}
                {%- for product in col_collection.products limit: product_limit -%}
                  {%- liquid
                    assign slide_image = product.featured_media
                    if slide_image == blank
                      assign slide_image = product.featured_image
                    endif
                  -%}
                  <a
                    class="ff-new__slide{% if forloop.first %} is-active{% endif %}"
                    href="{{ product.url }}"
                    data-ff-new-slide
                    data-ff-new-title="{{ product.title | escape }}"
                    {% unless forloop.first %}tabindex="-1" aria-hidden="true"{% endunless %}
                  >
                    {%- if slide_image != blank -%}
                      {{
                        slide_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '500, 700, 900, 1200',
                          sizes: '(max-width: 749px) 100vw, 50vw',
                          alt: product.title
                      }}
                    {%- else -%}
                      <span class="ff-new__slide-placeholder">{{ product.title | escape }}</span>
                    {%- endif -%}
                  </a>
                {%- endfor -%}

                {%- if col_collection.products.size > 1 or product_limit > 1 -%}
                  {%- assign slide_count = col_collection.products.size -%}
                  {%- if slide_count > product_limit -%}
                    {%- assign slide_count = product_limit -%}
                  {%- endif -%}
                  {%- if slide_count > 1 -%}
                    <div class="ff-new__dots" aria-hidden="true">
                      {%- for product in col_collection.products limit: product_limit -%}
                        <button
                          type="button"
                          class="ff-new__dot{% if forloop.first %} is-active{% endif %}"
                          data-ff-new-dot
                          aria-label="Show product {{ forloop.index }}"
                        ></button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- else -%}
                <div class="ff-new__slide is-active">
                  <span class="ff-new__slide-placeholder">{{ col_empty | default: 'Add a collection' | escape }}</span>
                </div>
              {%- endif -%}
            </div>

            <div class="ff-new__meta">
              {%- if col_collection != blank and col_collection.products_count > 0 -%}
                <p class="ff-new__caption" data-ff-new-caption>
                  {{ col_collection.products.first.title | escape }}
                </p>
              {%- elsif col_empty != blank -%}
                <p class="ff-new__caption">{{ col_empty | escape }}</p>
              {%- endif -%}
            </div>

            {%- if col_view_label != blank and col_view_link != blank -%}
              <a class="ff-new__view" href="{{ col_view_link }}">{{ col_view_label | escape }}</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script src="{{ 'ff-new-products.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF New Products",
  "tag": "section",
  "class": "section-ff-new-products",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "bar_left",
      "label": "Left bar text",
      "default": "New products"
    },
    {
      "type": "text",
      "id": "bar_right",
      "label": "Right bar text",
      "default": "New designs"
    },
    {
      "type": "header",
      "content": "Left column — Monoblock"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "Column label",
      "default": "Monoblock"
    },
    {
      "type": "collection",
      "id": "left_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "left_empty",
      "label": "Empty state text",
      "default": "Select a monoblock collection"
    },
    {
      "type": "text",
      "id": "left_view_label",
      "label": "View-all label",
      "default": "Shop monoblock"
    },
    {
      "type": "url",
      "id": "left_view_link",
      "label": "View-all link",
      "info": "Defaults to the selected collection if blank."
    },
    {
      "type": "header",
      "content": "Right column — Two piece"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Column label",
      "default": "Two piece"
    },
    {
      "type": "collection",
      "id": "right_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "right_empty",
      "label": "Empty state text",
      "default": "Select a two-piece collection"
    },
    {
      "type": "text",
      "id": "right_view_label",
      "label": "View-all label",
      "default": "Shop two piece"
    },
    {
      "type": "url",
      "id": "right_view_link",
      "label": "View-all link",
      "info": "Defaults to the selected collection if blank."
    },
    {
      "type": "header",
      "content": "Cycling"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to cycle per column",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "cycle_ms",
      "label": "Seconds between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "FF New Products"
    }
  ]
}
{% endschema %}
