{{ 'ff-offer-popup.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_popup -%}
  {%- liquid
    assign offer_image = section.settings.image
    assign delay_ms = section.settings.delay_seconds | default: 5 | times: 1000
  -%}
  <div
    class="ff-offer"
    id="ff-offer-{{ section.id }}"
    data-ff-offer
    data-ff-offer-delay="{{ delay_ms }}"
    data-ff-offer-expire="{{ section.settings.expire_days | default: 14 }}"
    hidden
    aria-hidden="true"
  >
    <div class="ff-offer__backdrop" data-ff-offer-close tabindex="-1"></div>
    <div class="ff-offer__dialog" role="dialog" aria-modal="true" aria-labelledby="ff-offer-title-{{ section.id }}">
      <button type="button" class="ff-offer__close" data-ff-offer-close aria-label="Close offer">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="ff-offer__media" aria-hidden="true">
        {%- if offer_image != blank -%}
          {{
            offer_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200',
              sizes: '(max-width: 749px) 100vw, 42vw',
              alt: ''
          }}
        {%- else -%}
          <div class="ff-offer__media-placeholder"></div>
        {%- endif -%}
      </div>
      <div class="ff-offer__panel">
        <h2 class="ff-offer__title" id="ff-offer-title-{{ section.id }}">
          {{ section.settings.heading | default: 'Get $100 Off Your Entire Order' | escape }}
        </h2>
        <p class="ff-offer__sub">
          {{ section.settings.subheading | default: 'Limited time offer for first-time customers. Premium mods, fast support and zero regrets. Built for real enthusiasts.' | escape }}
        </p>
        {%- form 'customer', class: 'ff-offer__form' -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags | default: 'newsletter, first-time-100-off' | escape }}">
          <input class="ff-offer__input" type="text" name="contact[first_name]" placeholder="{{ section.settings.first_name_placeholder | default: 'First name' | escape }}" autocomplete="given-name">
          <input class="ff-offer__input" type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder | default: 'Email' | escape }}" autocomplete="email" required>
          <button type="submit" class="ff-offer__submit">{{ section.settings.button_label | default: 'Claim Offer' | escape }}</button>
        {%- endform -%}
        <p class="ff-offer__disclaimer">
          {{ section.settings.disclaimer | default: 'By signing up, you agree to receive marketing emails. View our privacy policy and terms of service for more info.' | escape }}
        </p>
        <p class="ff-offer__success" data-ff-offer-success hidden>
          {{ section.settings.success_message | default: "You're in - check your email for your $100 off code." | escape }}
        </p>
      </div>
    </div>
  </div>
  <script src="{{ 'ff-offer-popup.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Offer Popup",
  "tag": "section",
  "class": "section-ff-offer-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_popup",
      "label": "Show offer popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Seconds before popup appears",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "expire_days",
      "label": "Days before showing again after close",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get $100 Off Your Entire Order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited time offer for first-time customers. Premium mods, fast support and zero regrets. Built for real enthusiasts."
    },
    {
      "type": "text",
      "id": "first_name_placeholder",
      "label": "First name placeholder",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Claim Offer"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags",
      "default": "newsletter, first-time-100-off"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "By signing up, you agree to receive marketing emails. View our privacy policy and terms of service for more info."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in - check your email for your $100 off code."
    }
  ],
  "presets": [{ "name": "FF Offer Popup" }]
}
{% endschema %}
