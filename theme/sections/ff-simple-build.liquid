{{ 'ff-simple-build.css' | asset_url | stylesheet_tag }}

<section class="ff-build" id="order" data-ff-build>
  <div class="ff-build__inner">
    <header class="ff-build__intro">
      <p class="ff-build__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="ff-build__title">{{ section.settings.title | escape }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="ff-build__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </header>

    <ol class="ff-build__steps" aria-label="Order steps">
      <li class="ff-build__step is-active" data-step="1">
        <span class="ff-build__step-num">1</span>
        <span class="ff-build__step-label">{{ section.settings.step1_label | escape }}</span>
      </li>
      <li class="ff-build__step" data-step="2">
        <span class="ff-build__step-num">2</span>
        <span class="ff-build__step-label">{{ section.settings.step2_label | escape }}</span>
      </li>
      <li class="ff-build__step" data-step="3">
        <span class="ff-build__step-num">3</span>
        <span class="ff-build__step-label">{{ section.settings.step3_label | escape }}</span>
      </li>
    </ol>

    <div class="ff-build__panel is-active" data-panel="1">
      <h2 class="ff-build__panel-title">{{ section.settings.step1_heading | escape }}</h2>
      <p class="ff-build__panel-copy">{{ section.settings.step1_copy | escape }}</p>
      <div class="ff-build__manual">
        <label class="ff-build__label" for="ff-vehicle-manual-{{ section.id }}">Year / make / model</label>
        <input
          class="ff-build__input"
          id="ff-vehicle-manual-{{ section.id }}"
          type="text"
          name="ff_vehicle_manual"
          placeholder="{{ section.settings.vehicle_placeholder | escape }}"
          autocomplete="off"
          required
        >
      </div>
      <button type="button" class="ff-build__next button button--primary" data-next="2" disabled>
        {{ section.settings.continue_label | escape }}
      </button>
    </div>

    <div class="ff-build__panel" data-panel="2" hidden>
      <h2 class="ff-build__panel-title">{{ section.settings.step2_heading | escape }}</h2>
      <p class="ff-build__panel-copy">{{ section.settings.step2_copy | escape }}</p>
      <p class="ff-build__pricing-note">{{ section.settings.step2_hint | escape }}</p>

      {% if section.settings.hottest_link != blank %}
        <a class="ff-build__hottest" href="{{ section.settings.hottest_link }}" data-style="Hottest designs">
          <span class="ff-build__style-name">{{ section.settings.hottest_label | escape }}</span>
          <span class="ff-build__style-desc">{{ section.settings.hottest_desc | escape }}</span>
        </a>
      {% endif %}

      <div class="ff-build__styles">
        <button type="button" class="ff-build__style" data-style="Monoblock" data-style-select>
          <span class="ff-build__style-name">Monoblock</span>
          <span class="ff-build__style-desc">{{ section.settings.monoblock_desc | escape }}</span>
        </button>
        <button type="button" class="ff-build__style" data-style="2-Piece" data-style-select>
          <span class="ff-build__style-name">2-Piece</span>
          <span class="ff-build__style-desc">{{ section.settings.twopiece_desc | escape }}</span>
        </button>
        <button type="button" class="ff-build__style" data-style="Beadlock" data-style-select>
          <span class="ff-build__style-name">Beadlock</span>
          <span class="ff-build__style-desc">{{ section.settings.beadlock_desc | escape }}</span>
        </button>
      </div>

      <div class="ff-build__browse-links" hidden data-browse-links>
        <p class="ff-build__panel-copy">Browse that setup, or continue to quote with it selected.</p>
        <div class="ff-build__nav-row">
          <a class="ff-build__browse button button--primary" href="{{ section.settings.monoblock_link }}" data-browse-for="Monoblock">Browse Monoblock</a>
          <a class="ff-build__browse button button--primary" href="{{ section.settings.twopiece_link }}" data-browse-for="2-Piece" hidden>Browse 2-Piece</a>
          <a class="ff-build__browse button button--primary" href="{{ section.settings.beadlock_link }}" data-browse-for="Beadlock" hidden>Browse Beadlock</a>
          <button type="button" class="ff-build__next button button--secondary" data-next="3">Continue to quote</button>
        </div>
      </div>

      <div class="ff-build__nav-row ff-build__nav-row--split">
        <button type="button" class="ff-build__back" data-back="1">Back</button>
        <button type="button" class="ff-build__next button button--primary" data-next="3" data-skip-quote>
          {{ section.settings.quote_cta | escape }}
        </button>
      </div>
    </div>

    <div class="ff-build__panel" data-panel="3" hidden>
      <h2 class="ff-build__panel-title">{{ section.settings.step3_heading | escape }}</h2>
      <p class="ff-build__panel-copy">{{ section.settings.step3_copy | escape }}</p>
      {% render 'ff-quote-form', section: section %}
      <button type="button" class="ff-build__back" data-back="2">Back</button>
    </div>
  </div>

  <div
    class="ff-media-modal"
    id="ff-media-modal-{{ section.id }}"
    data-ff-media-modal
    hidden
  >
    <div class="ff-media-modal__backdrop" data-ff-modal-close tabindex="-1"></div>
    <div
      class="ff-media-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ff-media-modal-title-{{ section.id }}"
      tabindex="-1"
      data-ff-modal-dialog
    >
      <button type="button" class="ff-media-modal__close" data-ff-modal-close aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
      <p class="ff-media-modal__eyebrow">{{ section.settings.modal_eyebrow | escape }}</p>
      <h2 class="ff-media-modal__title" id="ff-media-modal-title-{{ section.id }}">
        {{ section.settings.modal_title | escape }}
      </h2>
      <p class="ff-media-modal__lead">{{ section.settings.modal_lead | escape }}</p>
      <div class="ff-media-modal__offer">
        <p class="ff-media-modal__offer-label">{{ section.settings.modal_offer_label | escape }}</p>
        <p class="ff-media-modal__offer-copy">{{ section.settings.modal_offer_copy | escape }}</p>
      </div>
      <p class="ff-media-modal__social">{{ section.settings.modal_social_copy | escape }}</p>
      <div class="ff-media-modal__actions">
        <button type="button" class="button button--primary ff-media-modal__cta" data-ff-modal-interested>
          {{ section.settings.modal_cta | escape }}
        </button>
        <button type="button" class="ff-media-modal__dismiss" data-ff-modal-close>
          {{ section.settings.modal_dismiss | escape }}
        </button>
      </div>
      <p class="ff-media-modal__thanks" data-ff-modal-thanks hidden>
        {{ section.settings.modal_thanks | escape }}
      </p>
    </div>
  </div>
</section>

<script src="{{ 'ff-simple-build.js' | asset_url }}" defer></script>

