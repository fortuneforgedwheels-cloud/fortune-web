{{ 'ff-contact-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign contact_form_title = section.settings.contact_form_title | default: 'Send us a message'
  assign contact_form_text = section.settings.contact_form_text | default: 'Questions about fitment, finishes, lead times, or an existing order? Fill out the form and our team will get back to you.'
  assign contact_email = section.settings.contact_email | default: 'FortuneForgedWheels@gmail.com'
  assign instagram_handle = section.settings.instagram_handle | default: '@fortuneforgedwheels'
  assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/fortuneforgedwheels/'
  assign business_hours = section.settings.business_hours | default: 'Monday – Friday: 9 AM – 5 PM\nSaturday – Sunday: Closed'
  assign response_note = section.settings.response_note | default: 'We typically respond within one business day. For order updates, include your order number in the message.'
  assign page_heading = section.settings.page_heading | default: page.title
-%}

<section
  class="ff-contact"
  id="ContactSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="contact"
>
  <div class="ff-contact__atmosphere" aria-hidden="true"></div>
  <div class="ff-contact__inner">
    <header class="ff-contact__header">
      <p class="ff-contact__eyebrow">{{ section.settings.eyebrow | default: 'Contact' | escape }}</p>
      <h1 class="ff-contact__title">{{ page_heading | escape }}</h1>
      {%- if section.settings.page_intro != blank -%}
        <p class="ff-contact__intro">{{ section.settings.page_intro | escape }}</p>
      {%- else -%}
        <p class="ff-contact__intro">Premium forged wheels, built to order. Reach out for fitment help, custom quotes, or order support.</p>
      {%- endif -%}
    </header>

    <div class="ff-contact__grid">
      <div class="ff-contact__panel">
        <h2 class="ff-contact__panel-title">{{ contact_form_title | escape }}</h2>
        {%- if contact_form_text != blank -%}
          <p class="ff-contact__panel-text">{{ contact_form_text | escape }}</p>
        {%- endif -%}
        {% render 'halo-contact-form', section: section %}
      </div>

      {%- if section.settings.show_contact_info -%}
        <aside class="ff-contact__info">
          <div class="ff-contact__card">
            <span class="ff-contact__card-label">Email</span>
            <a class="ff-contact__card-value" href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>
          </div>

          <div class="ff-contact__card">
            <span class="ff-contact__card-label">Business hours</span>
            <p class="ff-contact__card-text">{{ business_hours | newline_to_br }}</p>
          </div>

          <div class="ff-contact__card">
            <span class="ff-contact__card-label">Instagram</span>
            <a class="ff-contact__card-value" href="{{ instagram_url | escape }}" target="_blank" rel="noopener noreferrer">{{ instagram_handle | escape }}</a>
          </div>

          {%- if response_note != blank -%}
            <p class="ff-contact__card-note">{{ response_note | escape }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-contact-page.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "page_heading",
      "label": "Page heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "page_intro",
      "label": "Page intro",
      "default": "Premium forged wheels, built to order. Reach out for fitment help, custom quotes, or order support."
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "text",
      "id": "contact_form_title",
      "label": "Form title",
      "default": "Send us a message"
    },
    {
      "type": "textarea",
      "id": "contact_form_text",
      "label": "Form description",
      "default": "Questions about fitment, finishes, lead times, or an existing order? Fill out the form and our team will get back to you."
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_contact_info",
      "label": "Show contact information",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "FortuneForgedWheels@gmail.com"
    },
    {
      "type": "textarea",
      "id": "business_hours",
      "label": "Business hours",
      "default": "Monday – Friday: 9 AM – 5 PM\nSaturday – Sunday: Closed"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle",
      "default": "@fortuneforgedwheels"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "textarea",
      "id": "response_note",
      "label": "Response note",
      "default": "We typically respond within one business day. For order updates, include your order number in the message."
    }
  ]
}
{% endschema %}
