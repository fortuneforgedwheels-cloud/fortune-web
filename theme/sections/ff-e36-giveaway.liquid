{{ 'ff-e36-giveaway-v3.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-e36-giveaway-v3.js' | asset_url }}" defer></script>

{%- liquid
  assign giveaway = section.settings.product
  if giveaway == blank and section.settings.product_handle != blank
    assign giveaway = all_products[section.settings.product_handle]
  endif
  if giveaway == blank
    assign giveaway = all_products['1998-bmw-m3']
  endif
  if giveaway == blank
    assign giveaway = all_products['giveaway']
  endif

  assign variant = blank
  if giveaway != blank
    assign variant = giveaway.selected_or_first_available_variant
  endif

  assign rules_html = section.settings.official_rules
  if rules_html == blank
    assign rules_html = section.settings.fine_print
  endif
  if rules_html == blank and page.content != blank
    assign rules_html = page.content
  endif

  assign brand_title = section.settings.brand_title | default: 'WIN OUR E36 M3'
  if brand_title == blank
    assign brand_title = 'WIN OUR E36 M3'
  endif
  assign cta_label = section.settings.cta_label | default: 'GET MY ENTRY'
  if cta_label == blank
    assign cta_label = 'GET MY ENTRY'
  endif
  assign checkout_label = section.settings.checkout_label | default: 'ENTER NOW'
  if checkout_label == blank
    assign checkout_label = 'ENTER NOW'
  endif
  assign terms_version = section.settings.terms_version | default: '1'
  if terms_version == blank
    assign terms_version = '1'
  endif
  assign rules_link_label = section.settings.terms_link_label | default: 'Official Rules & Terms'
  if rules_link_label == blank
    assign rules_link_label = 'Official Rules & Terms'
  endif
  assign build_highlights = section.settings.build_highlights | default: 'S52 INLINE-SIX · 5-SPEED ZF · COILOVERS · REINFORCED REAR · FORTUNE FORGED F-05X'
  assign story_more_label = section.settings.story_more_label | default: 'VIEW FULL BUILD'
  if story_more_label == blank
    assign story_more_label = 'VIEW FULL BUILD'
  endif
  assign how_heading = section.settings.how_heading | default: 'HOW IT WORKS'
  assign how_1_title = section.settings.how_1_title | default: 'ENTER'
  assign how_1_body = section.settings.how_1_body | default: '$20 per entry. Unlimited entries.'
  assign how_2_title = section.settings.how_2_title | default: 'BE THERE'
  assign how_2_body = section.settings.how_2_body | default: 'Entry is exclusive to eligible Bimmer Invasion attendees.'
  assign how_3_title = section.settings.how_3_title | default: 'WIN'
  assign how_3_body = section.settings.how_3_body | default: 'Winner selected at the event.'
  assign sticky_cta_label = section.settings.sticky_cta_label | default: 'ENTER NOW'
  if sticky_cta_label == blank
    assign sticky_cta_label = 'ENTER NOW'
  endif
-%}

  <section
    class="ff-e36"
    id="ff-e36-{{ section.id }}"
    data-ff-e36-giveaway
    {{ section.shopify_attributes }}
  >
    <div class="ff-e36__hero">
      <div class="ff-e36__video-wrap" data-ff-autoplay-video data-ff-e36-video-wrap>
        {%- if section.settings.hero_video != blank -%}
          {% render 'ff-autoplay-video',
            video: section.settings.hero_video,
            poster: section.settings.hero_poster,
            class: 'ff-e36__video'
          %}
        {%- elsif section.settings.hero_poster != blank -%}
          {{
            section.settings.hero_poster
            | image_url: width: 2000
            | image_tag:
              class: 'ff-e36__poster',
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '100vw',
              loading: 'eager',
              alt: brand_title
          }}
        {%- else -%}
          <div class="ff-e36__poster ff-e36__poster--empty">
            <p>
              {%- if request.design_mode -%}
                Left sidebar → <strong>Hero video (MP4)</strong> → select your video → Save.
              {%- else -%}
                Video coming soon.
              {%- endif -%}
            </p>
          </div>
        {%- endif -%}
      </div>

      <div class="ff-e36__cta-bar" data-ff-e36-hero-cta>
        <div class="ff-e36__hero-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ff-e36__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="ff-e36__title">{{ brand_title | escape }}</h1>
          {%- if section.settings.subtitle != blank -%}
            <p class="ff-e36__subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>
        <button type="button" class="ff-e36__cta" data-ff-e36-scroll-entry>
          {{ cta_label | escape }}
        </button>
      </div>
    </div>

    <div class="ff-e36__entry" id="ff-e36-entry" data-ff-e36-entry>
      {%- if giveaway != blank and variant != blank -%}
        <div class="ff-e36__entry-intro">
          <h2 class="ff-e36__entry-heading">{{ section.settings.entry_heading | default: giveaway.title | escape }}</h2>
          <p class="ff-e36__entry-price">
            {%- if variant.price == 0 -%}
              {{ section.settings.free_price_label | default: 'FREE ENTRY' | escape }}
            {%- else -%}
              <span data-ff-e36-unit-price>{{ variant.price | money }}</span><span class="ff-e36__entry-price-suffix"> / ENTRY</span>
            {%- endif -%}
          </p>
        </div>
      {%- else -%}
        <p class="ff-e36__soldout">
          {%- if request.design_mode -%}
            Left sidebar → <strong>Giveaway product</strong> → pick product → Save. The product must also be <strong>Active</strong> and published to the <strong>Online Store</strong> sales channel.
          {%- else -%}
            {{ section.settings.missing_product_message | default: 'Entry product unavailable. Publish the giveaway product to your Online Store channel, then select it in Theme Editor.' | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if giveaway != blank and variant != blank and variant.available -%}
        {% form 'product', giveaway, data-ff-e36-form: '', id: 'ff-e36-form' %}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="properties[Sweepstakes Terms Accepted]" value="" data-ff-e36-accepted-flag>
          <input type="hidden" name="properties[Sweepstakes Terms Accepted At]" value="" data-ff-e36-accepted-at>
          <input type="hidden" name="properties[Sweepstakes Terms Version]" value="{{ terms_version | escape }}" data-ff-e36-terms-version>
          <input type="hidden" name="properties[Sweepstakes Entry Page]" value="{{ request.path | escape }}">
          <input type="hidden" name="properties[Sweepstakes Giveaway]" value="{{ brand_title | escape }}">

          {%- liquid
            assign qty_max = section.settings.max_entries | default: 20
            if qty_max < 1
              assign qty_max = 20
            endif
            if qty_max > 99
              assign qty_max = 99
            endif
          -%}
          <div
            class="ff-e36__qty"
            data-ff-e36-qty
            data-unit-cents="{{ variant.price }}"
            data-money-format="{{ shop.money_format | escape }}"
            data-cta-prefix="ENTER NOW — "
          >
            <div class="ff-e36__qty-label-row">
              <label class="ff-e36__qty-label" for="ff-e36-qty-{{ section.id }}">
                {{ section.settings.qty_label | default: 'HOW MANY ENTRIES?' | escape }}
              </label>
            </div>
            <div class="ff-e36__qty-ctrl">
              <button type="button" class="ff-e36__qty-btn" data-ff-e36-qty-minus aria-label="Fewer entries">−</button>
              <input
                id="ff-e36-qty-{{ section.id }}"
                class="ff-e36__qty-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="{{ qty_max }}"
                step="1"
                inputmode="numeric"
                data-ff-e36-qty-input
                aria-label="Number of entries"
              >
              <button type="button" class="ff-e36__qty-btn" data-ff-e36-qty-plus aria-label="More entries">+</button>
            </div>
            <p class="ff-e36__qty-meta" aria-live="polite">
              <span data-ff-e36-qty-count>1 ENTRY</span><span class="ff-e36__qty-meta-sep" aria-hidden="true"> · </span><span class="ff-e36__qty-total" data-ff-e36-qty-total>{{ variant.price | money }}</span>
            </p>
          </div>

          <div class="ff-e36__terms">
            <div class="ff-e36__terms-head">
              <div class="ff-e36__terms-row">
                <input
                  type="checkbox"
                  id="ff-e36-terms-{{ section.id }}"
                  class="ff-e36__terms-input"
                  name="properties[Official Rules Accepted]"
                  value="Yes"
                  data-ff-e36-terms
                  required
                  aria-required="true"
                  aria-invalid="true"
                  aria-describedby="ff-e36-terms-error-{{ section.id }}"
                >
                <label class="form-label--checkbox ff-e36__terms-label" for="ff-e36-terms-{{ section.id }}">
                  <span class="ff-e36__terms-label-text">
                    I agree to the
                    <button
                      type="button"
                      class="ff-e36__rules-link"
                      data-ff-e36-open-rules
                      aria-haspopup="dialog"
                      aria-controls="ff-e36-rules-dialog-{{ section.id }}"
                    >{{ rules_link_label | escape }}</button>
                  </span>
                </label>
              </div>
              <p
                class="ff-e36__terms-error"
                id="ff-e36-terms-error-{{ section.id }}"
                data-ff-e36-terms-error
                data-message="{{ section.settings.terms_error | default: 'Please accept the Official Rules to continue.' | escape }}"
                hidden
                role="alert"
              ></p>
            </div>
          </div>

          <button
            type="submit"
            class="ff-e36__cta ff-e36__cta--checkout"
            data-ff-e36-cta
            disabled
            aria-disabled="true"
          >ENTER NOW — {{ variant.price | money }}</button>
        {% endform %}
      {%- else -%}
        {%- if giveaway != blank and variant != blank and variant.available == false -%}
          <p class="ff-e36__soldout">{{ section.settings.soldout_message | default: 'Entries are closed for now.' | escape }}</p>
        {%- endif -%}

        <div class="ff-e36__terms">
          <div class="ff-e36__terms-head">
            <div class="ff-e36__terms-row">
              <input
                type="checkbox"
                id="ff-e36-terms-{{ section.id }}"
                class="ff-e36__terms-input"
                disabled
                aria-invalid="true"
              >
              <label class="form-label--checkbox ff-e36__terms-label" for="ff-e36-terms-{{ section.id }}">
                <span class="ff-e36__terms-label-text">
                  I agree to the
                  <button
                    type="button"
                    class="ff-e36__rules-link"
                    data-ff-e36-open-rules
                    aria-haspopup="dialog"
                    aria-controls="ff-e36-rules-dialog-{{ section.id }}"
                  >{{ rules_link_label | escape }}</button>
                </span>
              </label>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="ff-e36__section ff-e36__section--prize" id="ff-e36-prize">
      <div class="ff-e36__section-inner">
        {%- if section.settings.story_kicker != blank -%}
          <p class="ff-e36__story-kicker">{{ section.settings.story_kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.story_title != blank -%}
          <h2 class="ff-e36__story-title">{{ section.settings.story_title | escape }}</h2>
        {%- endif -%}

        {%- if giveaway != blank -%}
          {%- liquid
            assign entry_images = giveaway.media | where: 'media_type', 'image'
            assign entry_image_count = entry_images.size
            if entry_image_count == 0 and giveaway.featured_media != blank
              assign entry_image_count = 1
            endif
          -%}
          <div
            class="ff-e36__prize-media{% if entry_image_count > 1 %} ff-e36__prize-media--gallery{% endif %}"
            data-ff-e36-gallery
            {% if entry_image_count > 1 %}
              role="region"
              aria-roledescription="carousel"
              aria-label="{{ giveaway.title | escape }} photos"
            {% endif %}
          >
            {%- if entry_images.size > 0 -%}
              <div class="ff-e36__gallery-viewport">
                <div class="ff-e36__gallery-track" data-ff-e36-gallery-track>
                  {%- for media in entry_images -%}
                    {%- liquid
                      assign entry_alt = media.alt | default: giveaway.title
                    -%}
                    <div
                      class="ff-e36__gallery-slide{% if forloop.first %} is-active{% endif %}"
                      data-ff-e36-gallery-slide
                      {% unless forloop.first %}aria-hidden="true"{% endunless %}
                    >
                      {%- if forloop.first -%}
                        {{
                          media
                          | image_url: width: 1600
                          | image_tag:
                            loading: 'eager',
                            widths: '400, 600, 900, 1200, 1600',
                            sizes: '(min-width: 750px) 720px, 100vw',
                            alt: entry_alt,
                            class: 'ff-e36__gallery-img'
                        }}
                      {%- else -%}
                        {{
                          media
                          | image_url: width: 1600
                          | image_tag:
                            loading: 'lazy',
                            widths: '400, 600, 900, 1200, 1600',
                            sizes: '(min-width: 750px) 720px, 100vw',
                            alt: entry_alt,
                            class: 'ff-e36__gallery-img'
                        }}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
              {%- if entry_images.size > 1 -%}
                <button type="button" class="ff-e36__gallery-arrow ff-e36__gallery-arrow--prev" data-ff-e36-gallery-prev aria-label="Previous photo">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="ff-e36__gallery-arrow ff-e36__gallery-arrow--next" data-ff-e36-gallery-next aria-label="Next photo">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M9.5 5.5 16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <p class="ff-e36__gallery-status visually-hidden" data-ff-e36-gallery-status aria-live="polite"></p>
              {%- endif -%}
            {%- elsif giveaway.featured_media != blank -%}
              {%- liquid
                assign entry_alt = giveaway.featured_media.alt | default: giveaway.title
              -%}
              {{
                giveaway.featured_media
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900, 1200, 1600',
                  sizes: '(min-width: 750px) 720px, 100vw',
                  alt: entry_alt,
                  class: 'ff-e36__gallery-img'
              }}
            {%- elsif section.settings.hero_poster != blank -%}
              {{
                section.settings.hero_poster
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  alt: brand_title,
                  class: 'ff-e36__gallery-img'
              }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if build_highlights != blank -%}
          <p class="ff-e36__highlights">{{ build_highlights | escape }}</p>
        {%- endif -%}

        {%- if section.settings.story_body != blank -%}
          <div class="ff-e36__story-panel" data-ff-e36-story-panel>
            <div class="ff-e36__story-clip" data-ff-e36-story-clip>
              <div class="ff-e36__story-body" data-ff-e36-story-body>{{ section.settings.story_body }}</div>
            </div>
            <div class="ff-e36__story-more" data-ff-e36-story-more>
              <button type="button" class="ff-e36__story-more-btn" data-ff-e36-story-more-btn aria-expanded="false">
                {{ story_more_label | escape }}
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="ff-e36__section ff-e36__section--how">
      <div class="ff-e36__section-inner">
        {%- if how_heading != blank -%}
          <h2 class="ff-e36__how-heading">{{ how_heading | escape }}</h2>
        {%- endif -%}
        <ol class="ff-e36__how-list">
          <li class="ff-e36__how-item">
            <p class="ff-e36__how-step"><span class="ff-e36__how-num">01</span> — {{ how_1_title | escape }}</p>
            {%- if how_1_body != blank -%}<p class="ff-e36__how-body">{{ how_1_body | escape }}</p>{%- endif -%}
          </li>
          <li class="ff-e36__how-item">
            <p class="ff-e36__how-step"><span class="ff-e36__how-num">02</span> — {{ how_2_title | escape }}</p>
            {%- if how_2_body != blank -%}<p class="ff-e36__how-body">{{ how_2_body | escape }}</p>{%- endif -%}
          </li>
          <li class="ff-e36__how-item">
            <p class="ff-e36__how-step"><span class="ff-e36__how-num">03</span> — {{ how_3_title | escape }}</p>
            {%- if how_3_body != blank -%}<p class="ff-e36__how-body">{{ how_3_body | escape }}</p>{%- endif -%}
          </li>
        </ol>
      </div>
    </div>

    <div
      class="ff-e36__rules-modal"
      id="ff-e36-rules-dialog-{{ section.id }}"
      data-ff-e36-rules-modal
      hidden
    >
      <div class="ff-e36__rules-backdrop" data-ff-e36-close-rules tabindex="-1"></div>
      <div
        class="ff-e36__rules-sheet"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ff-e36-rules-title-{{ section.id }}"
        data-ff-e36-rules-sheet
      >
        <div class="ff-e36__rules-sheet-head">
          <h2 class="ff-e36__rules-sheet-title" id="ff-e36-rules-title-{{ section.id }}">
            {{ section.settings.fine_print_heading | default: 'Official Rules & Fine Print' | escape }}
          </h2>
          <button type="button" class="ff-e36__rules-close" data-ff-e36-close-rules aria-label="Close Official Rules">×</button>
        </div>
        <div
          class="ff-e36__rules-sheet-body"
          id="ff-e36-terms-scroll-{{ section.id }}"
          tabindex="0"
          data-ff-e36-terms-scroll
        >
          {%- if rules_html != blank -%}
            <div class="ff-e36__terms-scroll-body" data-ff-e36-terms-body>{{ rules_html }}</div>
          {%- else -%}
            <div class="ff-e36__terms-scroll-body" data-ff-e36-terms-body>
              <p><strong>Add your Official Rules:</strong> left sidebar → <strong>Official Rules (paste here)</strong> → paste → Save.</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="ff-e36__sticky" data-ff-e36-sticky>
      <div class="ff-e36__sticky-inner">
        <p class="ff-e36__sticky-price">
          {%- if giveaway != blank and variant != blank and variant.price == 0 -%}
            {{ section.settings.free_price_label | default: 'FREE ENTRY' | escape }}
          {%- elsif giveaway != blank and variant != blank -%}
            <span data-ff-e36-sticky-unit>{{ variant.price | money }}</span><span> / ENTRY</span>
          {%- else -%}
            ENTRY
          {%- endif -%}
        </p>
        <button type="button" class="ff-e36__sticky-cta" data-ff-e36-scroll-entry>
          {{ sticky_cta_label | escape }}
        </button>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "E36 M3 Giveaway",
  "tag": "div",
  "class": "ff-e36-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video (MP4)",
      "info": "Required for the top video. Re-select after theme updates if it goes blank."
    },
    {
      "type": "image_picker",
      "id": "hero_poster",
      "label": "Hero image fallback / poster",
      "info": "Optional. Shows if video is missing or while it loads."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FORTUNE FORGED GIVEAWAY"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Page title",
      "default": "WIN OUR E36 M3"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting line",
      "default": "$20 PER ENTRY · WINNER CHOSEN TODAY"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "GET MY ENTRY"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Note under GET MY ENTRY",
      "default": "Takes less than 60 seconds · Limited-time giveaway"
    },
    {
      "type": "header",
      "content": "Car story"
    },
    {
      "type": "text",
      "id": "story_kicker",
      "label": "Story kicker",
      "default": "THE PRIZE"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story headline",
      "default": "ONE E36 M3 — BUILT TO BE DRIVEN"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story write-up",
      "default": "<p>This is your shot at owning a classic BMW E36 M3 from Fortune Forged. Enter now, accept the Official Rules, and complete checkout to lock in your entry.</p><p>No complicated forms on this page — just watch the film, claim your entry, and check out.</p>"
    },
    {
      "type": "text",
      "id": "story_more_label",
      "label": "Story expand button",
      "default": "VIEW FULL BUILD",
      "info": "Shown under the story preview. Reveals the full write-up when tapped."
    },

    {
      "type": "textarea",
      "id": "build_highlights",
      "label": "Build highlights (short line)",
      "default": "S52 INLINE-SIX · 5-SPEED ZF · COILOVERS · REINFORCED REAR · FORTUNE FORGED F-05X"
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "How it works heading",
      "default": "HOW IT WORKS"
    },
    {
      "type": "text",
      "id": "how_1_title",
      "label": "Step 1 title",
      "default": "ENTER"
    },
    {
      "type": "text",
      "id": "how_1_body",
      "label": "Step 1 body",
      "default": "$20 per entry. Unlimited entries."
    },
    {
      "type": "text",
      "id": "how_2_title",
      "label": "Step 2 title",
      "default": "BE THERE"
    },
    {
      "type": "text",
      "id": "how_2_body",
      "label": "Step 2 body",
      "default": "Entry is exclusive to eligible Bimmer Invasion attendees."
    },
    {
      "type": "text",
      "id": "how_3_title",
      "label": "Step 3 title",
      "default": "WIN"
    },
    {
      "type": "text",
      "id": "how_3_body",
      "label": "Step 3 body",
      "default": "Winner selected at the event."
    },
    {
      "type": "text",
      "id": "sticky_cta_label",
      "label": "Sticky bar CTA",
      "default": "ENTER NOW"
    },

    {
      "type": "header",
      "content": "Entry product"
    },
    {
      "type": "product",
      "id": "product",
