{{ 'ff-chassis-picker.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section class="ff-chassis" id="ff-chassis-{{ section.id }}">
    <div class="ff-chassis__inner">
      {%- if section.settings.heading != blank -%}
        <h1 class="ff-chassis__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ff-chassis__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="ff-chassis__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chassis' -%}
            <a class="ff-chassis__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Chassis Picker",
  "tag": "section",
  "class": "section-ff-chassis-picker",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BMW Wheel & Tire Fitment Guides"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get the perfect wheel and tire fitment for your BMW. Select your chassis below to read our technical fitment notes and browse example builds."
    }
  ],
  "blocks": [
    {
      "type": "chassis",
      "name": "Chassis card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "BMW G8X (G80/G82/G87) Wheel & Tire Fitment Guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Chassis Picker",
      "blocks": [
        { "type": "chassis" },
        { "type": "chassis" },
        { "type": "chassis" }
      ]
    }
  ]
}
{% endschema %}
