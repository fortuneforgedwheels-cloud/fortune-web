{{ 'ff-hero-lifestyle-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-offer-boot-v2.js' | asset_url }}" defer></script>

{%- if section.settings.show_hero -%}
  {%- liquid
    assign content_h = section.settings.content_h_align | default: 'left'
    assign content_v = section.settings.content_v_align | default: 'bottom'
    assign content_ox = section.settings.content_offset_x | default: 0
    assign content_oy = section.settings.content_offset_y | default: 0

    case content_h
      when 'center'
        assign c_left = '50%'
        assign c_right = 'auto'
        assign c_tx = '-50%'
        assign c_items = 'center'
        assign c_text = 'center'
      when 'right'
        assign c_left = 'auto'
        assign c_right = '0'
        assign c_tx = '0'
        assign c_items = 'flex-end'
        assign c_text = 'right'
      else
        assign c_left = '0'
        assign c_right = 'auto'
        assign c_tx = '0'
        assign c_items = 'flex-start'
        assign c_text = 'left'
    endcase

    case content_v
      when 'top'
        assign c_top = '0'
        assign c_bottom = 'auto'
        assign c_ty = '0'
      when 'middle'
        assign c_top = '50%'
        assign c_bottom = 'auto'
        assign c_ty = '-50%'
      else
        assign c_top = 'auto'
        assign c_bottom = '0'
        assign c_ty = '0'
    endcase
  -%}
  <section
    class="ff-hero"
    id="ff-hero-{{ section.id }}"
    data-ff-hero data-ff-fingerprint="HERO-EDITOR-ALWAYS-20260801C" data-ff-hero-fix="arrows-v1" data-ff-rendered-at="{{ 'now' | date: '%s%N' }}"
    style="
      --ff-hero-height: {{ section.settings.height }}vh;
      --ff-hero-height-mobile: {{ section.settings.height_mobile }}vh;
      --ff-content-left: {{ c_left }};
      --ff-content-right: {{ c_right }};
      --ff-content-top: {{ c_top }};
      --ff-content-bottom: {{ c_bottom }};
      --ff-content-tx: {{ c_tx }};
      --ff-content-ty: {{ c_ty }};
      --ff-content-ox: {{ content_ox }}px;
      --ff-content-oy: {{ content_oy }}px;
      --ff-content-items: {{ c_items }};
      --ff-content-text: {{ c_text }};
    "
  >
    <div class="ff-hero__track" data-ff-hero-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- liquid
            if forloop.first
              assign img_loading = 'eager'
            else
              assign img_loading = 'lazy'
            endif
          -%}
          <article
            class="ff-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-slide
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="ff-hero__media">
              {%- comment -%}
                Theme Editor media ONLY. No hardcoded CDN fallbacks — those made
                uploads look like they "never saved" on the live site.
                Per-viewport media type (video/image) + framing (fit/position/zoom).
              {%- endcomment -%}
              {%- liquid
                assign desktop_media_type = block.settings.desktop_media_type | default: 'video'
                assign mobile_media_type = block.settings.mobile_media_type | default: 'video'
                assign slide_video = block.settings.video
                assign slide_mobile_video = block.settings.mobile_video
                assign slide_image = block.settings.image
                assign slide_mobile_image = block.settings.mobile_image

                assign desktop_fit = block.settings.desktop_media_fit | default: 'cover'
                assign desktop_pos = block.settings.desktop_media_position | default: 'center'
                assign desktop_zoom_pct = block.settings.desktop_media_zoom | default: 100
                assign desktop_zoom = desktop_zoom_pct | times: 0.01

                assign mobile_fit = block.settings.mobile_media_fit | default: 'cover'
                assign mobile_pos = block.settings.mobile_media_position | default: 'center'
                assign mobile_zoom_pct = block.settings.mobile_media_zoom | default: 100
                assign mobile_zoom = mobile_zoom_pct | times: 0.01

                assign desktop_use_video = false
                assign desktop_use_image = false
                if desktop_media_type == 'image'
                  if slide_image != blank
                    assign desktop_use_image = true
                  elsif slide_video != blank
                    assign desktop_use_video = true
                  endif
                else
                  if slide_video != blank
                    assign desktop_use_video = true
                  elsif slide_image != blank
                    assign desktop_use_image = true
                  endif
                endif

                assign mobile_use_video = false
                assign mobile_use_image = false
                if mobile_media_type == 'image'
                  if slide_mobile_image != blank
                    assign mobile_use_image = true
                  elsif slide_image != blank
                    assign mobile_use_image = true
                  elsif slide_mobile_video != blank
                    assign mobile_use_video = true
                  elsif slide_video != blank
                    assign mobile_use_video = true
                  endif
                else
                  if slide_mobile_video != blank
                    assign mobile_use_video = true
                  elsif slide_video != blank
                    assign mobile_use_video = true
                  elsif slide_mobile_image != blank
                    assign mobile_use_image = true
                  elsif slide_image != blank
                    assign mobile_use_image = true
                  endif
                endif

                assign has_desktop_media = false
                if desktop_use_video or desktop_use_image
                  assign has_desktop_media = true
                endif
                assign has_mobile_media = false
                if mobile_use_video or mobile_use_image
                  assign has_mobile_media = true
                endif

                assign mobile_image_src = slide_mobile_image
                if mobile_image_src == blank
                  assign mobile_image_src = slide_image
                endif
              -%}
              {%- if has_desktop_media or has_mobile_media -%}
                <div
                  class="ff-hero__media-desktop"
                  data-ff-desktop-layer
                  style="
                    --ff-media-fit-desktop: {{ desktop_fit }};
                    --ff-media-pos-desktop: {{ desktop_pos }};
                    --ff-media-zoom-desktop: {{ desktop_zoom }};
                  "
                >
                  {%- liquid
                    assign desktop_autoplay_mode = 'off'
                    if forloop.first
                      assign desktop_autoplay_mode = 'on'
                    endif
                  -%}
                  {%- if desktop_use_video -%}
                    {% render 'ff-autoplay-video', video: slide_video, class: 'ff-hero__video ff-hero__video--desktop', autoplay_mode: desktop_autoplay_mode %}
                  {%- elsif desktop_use_image -%}
                    <img
                      class="ff-hero__image"
                      src="{{ slide_image | image_url: width: 2400 }}"
                      srcset="
                        {{ slide_image | image_url: width: 800 }} 800w,
                        {{ slide_image | image_url: width: 1200 }} 1200w,
                        {{ slide_image | image_url: width: 1600 }} 1600w,
                        {{ slide_image | image_url: width: 2000 }} 2000w,
                        {{ slide_image | image_url: width: 2400 }} 2400w
                      "
                      sizes="100vw"
                      alt="{{ block.settings.title | escape }}"
                      loading="{{ img_loading }}"
                      width="2400"
                      height="1350"
                      data-ff-desktop-image
                    >
                  {%- else -%}
                    <div class="ff-hero__placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                </div>
                <div
                  class="ff-hero__media-mobile"
                  data-ff-mobile-layer
                  style="
                    --ff-media-fit-mobile: {{ mobile_fit }};
                    --ff-media-pos-mobile: {{ mobile_pos }};
                    --ff-media-zoom-mobile: {{ mobile_zoom }};
                  "
                >
                  {%- comment -%}
                    Only the first slide's mobile video gets HTML autoplay.
                    iOS blocks autoplay when many videos compete; JS plays the rest.
                  {%- endcomment -%}
                  {%- liquid
                    assign mobile_autoplay_mode = 'off'
                    if forloop.first
                      assign mobile_autoplay_mode = 'on'
                    endif
                    assign mobile_video_src = slide_mobile_video
                    if mobile_video_src == blank
                      assign mobile_video_src = slide_video
                    endif
                  -%}
                  {%- if mobile_use_video -%}
                    {% render 'ff-autoplay-video', video: mobile_video_src, class: 'ff-hero__video ff-hero__video--mobile', autoplay_mode: mobile_autoplay_mode %}
                  {%- elsif mobile_use_image and mobile_image_src != blank -%}
                    <img
                      class="ff-hero__image"
                      src="{{ mobile_image_src | image_url: width: 1200 }}"
                      srcset="
                        {{ mobile_image_src | image_url: width: 600 }} 600w,
                        {{ mobile_image_src | image_url: width: 900 }} 900w,
                        {{ mobile_image_src | image_url: width: 1200 }} 1200w
                      "
                      sizes="100vw"
                      alt="{{ block.settings.title | escape }}"
                      loading="{{ img_loading }}"
                      width="1200"
                      height="1600"
                      data-ff-mobile-image
                    >
                  {%- else -%}
                    <div class="ff-hero__placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                  {%- if forloop.first -%}
                    <script>
                      (function () {
                        if (window.__ffInAppBrowser || document.documentElement.classList.contains('ff-inapp')) return;
                        var layer = document.currentScript && document.currentScript.parentElement;
                        var v = layer && layer.querySelector('video.ff-hero__video--mobile');
                        if (!v) return;
                        v.muted = true;
                        v.defaultMuted = true;
                        v.playsInline = true;
                        v.autoplay = true;
                        try { v.volume = 0; } catch (e) {}
                        var p = v.play();
                        if (p && typeof p.catch === 'function') p.catch(function () {});
                      })();
                    </script>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="ff-hero__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <div class="ff-hero__shade" aria-hidden="true"></div>
            </div>

            <div class="ff-hero__content">
              {%- if block.settings.title != blank -%}
                <h2 class="ff-hero__title" {% render 'ff-type-style', size: block.settings.title_size, align: block.settings.title_align, min_ratio: 55 %}>
                  {{ block.settings.title | escape }}
                </h2>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="ff-hero__cta"
                  href="{{ block.settings.button_link | default: '#' }}"
                  {% render 'ff-type-style', size: block.settings.button_size, min_ratio: 90 %}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="ff-hero__nav ff-hero__nav--prev" data-ff-hero-prev aria-label="Previous slide">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="ff-hero__nav ff-hero__nav--next" data-ff-hero-next aria-label="Next slide">
        <span aria-hidden="true">›</span>
      </button>
      <div class="ff-hero__dots" role="tablist" aria-label="Hero slides">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ff-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
  <script src="{{ 'ff-hero-lifestyle.js' | asset_url }}" defer></script>
  <script>
    /* Immediate nudge only — do not storm play()/pause() (that froze the first frame). */
    (function () {
      if (window.__ffInAppBrowser || document.documentElement.classList.contains('ff-inapp')) return;
      var mq = window.matchMedia('(max-width: 749.98px)');
      function playing(v) {
        return v && !v.paused && !v.ended && v.readyState > 2;
      }
      function kick() {
        if (window.__ffInAppBrowser || document.documentElement.classList.contains('ff-inapp')) return;
        var isMobile = mq.matches;
        var hero = document.querySelector('[data-ff-hero]');
        if (!hero) return;
        var active = hero.querySelector('[data-ff-hero-slide].is-active') || hero.querySelector('[data-ff-hero-slide]');
        if (!active) return;
        var sel = isMobile ? '.ff-hero__video--mobile' : '.ff-hero__video--desktop';
        var v = active.querySelector(sel);
        if (!v || playing(v)) return;
        v.muted = true;
        v.defaultMuted = true;
        v.playsInline = true;
        v.autoplay = true;
        v.setAttribute('autoplay', '');
        v.setAttribute('preload', 'auto');
        try { v.preload = 'auto'; } catch (e0) {}
        try { v.volume = 0; } catch (e) {}
        var p = v.play();
        if (p && typeof p.catch === 'function') p.catch(function () {});
      }
      kick();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', kick, { once: true });
      }
    })();
  </script>
{%- endif -%}

{% render 'ff-shop-by-vehicle-bar' %}

{% schema %}
{
  "name": "FF Hero Lifestyle",
  "tag": "section",
  "class": "section-ff-hero-lifestyle",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 55,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 75
    },
    {
      "type": "header",
      "content": "Text placement (all slides)"
    },
    {
      "type": "select",
      "id": "content_h_align",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_v_align",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "content_offset_x",
      "label": "Nudge left/right",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_offset_y",
      "label": "Nudge up/down",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Desktop media"
        },
        {
          "type": "select",
          "id": "desktop_media_type",
          "label": "Desktop media type",
          "options": [
            { "value": "video", "label": "Video" },
            { "value": "image", "label": "Image" }
          ],
          "default": "video",
          "info": "Choose Image to show a still photo on desktop even if a video is also uploaded."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Used when Desktop media type is Video. Muted, looping."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Used when Desktop media type is Image (or as fallback if no desktop video is set)."
        },
        {
          "type": "select",
          "id": "desktop_media_fit",
          "label": "Desktop fit",
          "options": [
            { "value": "cover", "label": "Fill (crop to cover)" },
            { "value": "contain", "label": "Fit (show full media)" }
          ],
          "default": "cover"
        },
        {
          "type": "select",
          "id": "desktop_media_position",
          "label": "Desktop focal point",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" },
            { "value": "top left", "label": "Top left" },
            { "value": "top right", "label": "Top right" },
            { "value": "bottom left", "label": "Bottom left" },
            { "value": "bottom right", "label": "Bottom right" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "desktop_media_zoom",
          "label": "Desktop zoom",
          "min": 100,
          "max": 160,
          "step": 2,
          "unit": "%",
          "default": 100,
          "info": "Zoom in to reframe the crop on desktop."
        },
        {
          "type": "header",
          "content": "Mobile media"
        },
        {
          "type": "select",
          "id": "mobile_media_type",
          "label": "Mobile media type",
          "options": [
            { "value": "video", "label": "Video" },
            { "value": "image", "label": "Image" }
          ],
          "default": "video",
          "info": "Choose Image to show a still photo on phones even if a video is also uploaded."
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Used when Mobile media type is Video. Falls back to desktop video if empty."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Used when Mobile media type is Image. Falls back to desktop image if empty."
        },
        {
          "type": "select",
          "id": "mobile_media_fit",
          "label": "Mobile fit",
          "options": [
            { "value": "cover", "label": "Fill (crop to cover)" },
            { "value": "contain", "label": "Fit (show full media)" }
          ],
          "default": "cover"
        },
        {
          "type": "select",
          "id": "mobile_media_position",
          "label": "Mobile focal point",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" },
            { "value": "top left", "label": "Top left" },
            { "value": "top right", "label": "Top right" },
            { "value": "bottom left", "label": "Bottom left" },
            { "value": "bottom right", "label": "Bottom right" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "mobile_media_zoom",
          "label": "Mobile zoom",
          "min": 100,
          "max": 160,
          "step": 2,
          "unit": "%",
          "default": 100,
          "info": "Zoom in to reframe the crop on phones."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Monoblock Forged"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Headline size",
          "min": 18,
          "max": 84,
          "step": 2,
          "unit": "px",
          "default": 42
        },
        {
          "type": "select",
          "id": "title_align",
          "label": "Headline align",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Browse Selection"
        },
        {
          "type": "range",
          "id": "button_size",
          "label": "Button text size",
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Hero Lifestyle",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Monoblock Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Two-Piece Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Beadlock Forged",
            "button_label": "Browse Selection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
