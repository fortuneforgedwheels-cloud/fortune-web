{{ 'ff-hero-lifestyle.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_hero -%}
  <section
    class="ff-hero"
    id="ff-hero-{{ section.id }}"
    data-ff-hero
    style="--ff-hero-height: {{ section.settings.height }}vh; --ff-hero-height-mobile: {{ section.settings.height_mobile }}vh;"
  >
    <div class="ff-hero__track" data-ff-hero-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- liquid
            if forloop.first
              assign img_loading = 'eager'
            else
              assign img_loading = 'lazy'
            endif
          -%}
          <article
            class="ff-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-slide
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="ff-hero__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'ff-hero__image ff-hero__image--desktop',
                    loading: img_loading,
                    widths: '800, 1200, 1600, 2000, 2400',
                    sizes: '100vw',
                    alt: block.settings.title
                }}
              {%- else -%}
                <div class="ff-hero__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              {%- if block.settings.mobile_image != blank -%}
                {{
                  block.settings.mobile_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ff-hero__image ff-hero__image--mobile',
                    loading: img_loading,
                    widths: '600, 900, 1200',
                    sizes: '100vw',
                    alt: block.settings.title
                }}
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ff-hero__image ff-hero__image--mobile',
                    loading: img_loading,
                    widths: '600, 900, 1200',
                    sizes: '100vw',
                    alt: block.settings.title
                }}
              {%- endif -%}
              <div class="ff-hero__shade" aria-hidden="true"></div>
            </div>

            <div class="ff-hero__content">
              {%- if block.settings.title != blank -%}
                <h2 class="ff-hero__title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="ff-hero__cta"
                  href="{{ block.settings.button_link | default: '#' }}"
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="ff-hero__nav ff-hero__nav--prev" data-ff-hero-prev aria-label="Previous slide">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="ff-hero__nav ff-hero__nav--next" data-ff-hero-next aria-label="Next slide">
        <span aria-hidden="true">›</span>
      </button>
      <div class="ff-hero__dots" role="tablist" aria-label="Hero slides">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ff-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
  <script src="{{ 'ff-hero-lifestyle.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Hero Lifestyle",
  "tag": "section",
  "class": "section-ff-hero-lifestyle",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 55,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 75
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Monoblock Forged"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Browse Selection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Hero Lifestyle",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Monoblock Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Two-Piece Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Beadlock Forged",
            "button_label": "Browse Selection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
