{{ 'ff-hero-lifestyle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ff-offer-boot.js' | asset_url }}" defer></script>

{%- if section.settings.show_hero -%}
  {%- liquid
    assign content_h = section.settings.content_h_align | default: 'left'
    assign content_v = section.settings.content_v_align | default: 'bottom'
    assign content_ox = section.settings.content_offset_x | default: 0
    assign content_oy = section.settings.content_offset_y | default: 0

    case content_h
      when 'center'
        assign c_left = '50%'
        assign c_right = 'auto'
        assign c_tx = '-50%'
        assign c_items = 'center'
        assign c_text = 'center'
      when 'right'
        assign c_left = 'auto'
        assign c_right = '0'
        assign c_tx = '0'
        assign c_items = 'flex-end'
        assign c_text = 'right'
      else
        assign c_left = '0'
        assign c_right = 'auto'
        assign c_tx = '0'
        assign c_items = 'flex-start'
        assign c_text = 'left'
    endcase

    case content_v
      when 'top'
        assign c_top = '0'
        assign c_bottom = 'auto'
        assign c_ty = '0'
      when 'middle'
        assign c_top = '50%'
        assign c_bottom = 'auto'
        assign c_ty = '-50%'
      else
        assign c_top = 'auto'
        assign c_bottom = '0'
        assign c_ty = '0'
    endcase
  -%}
  <section
    class="ff-hero"
    id="ff-hero-{{ section.id }}"
    data-ff-hero data-ff-hero-fix="arrows-v1"
    style="
      --ff-hero-height: {{ section.settings.height }}vh;
      --ff-hero-height-mobile: {{ section.settings.height_mobile }}vh;
      --ff-content-left: {{ c_left }};
      --ff-content-right: {{ c_right }};
      --ff-content-top: {{ c_top }};
      --ff-content-bottom: {{ c_bottom }};
      --ff-content-tx: {{ c_tx }};
      --ff-content-ty: {{ c_ty }};
      --ff-content-ox: {{ content_ox }}px;
      --ff-content-oy: {{ content_oy }}px;
      --ff-content-items: {{ c_items }};
      --ff-content-text: {{ c_text }};
    "
  >
    <div class="ff-hero__track" data-ff-hero-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- liquid
            if forloop.first
              assign img_loading = 'eager'
            else
              assign img_loading = 'lazy'
            endif
          -%}
          <article
            class="ff-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-slide
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="ff-hero__media">
              {%- liquid
                assign slide_video = block.settings.video
                assign slide_mobile_video = block.settings.mobile_video
                assign has_desktop_media = false
                if slide_video != blank or block.settings.image != blank
                  assign has_desktop_media = true
                endif
                assign has_mobile_media = false
                if slide_mobile_video != blank or block.settings.mobile_image != blank or slide_video != blank or block.settings.image != blank
                  assign has_mobile_media = true
                endif
              -%}
              {%- if has_desktop_media or has_mobile_media -%}
                <div class="ff-hero__media-desktop" data-ff-desktop-layer>
                  {%- if slide_video != blank -%}
                    {{
                      slide_video
                      | video_tag:
                        class: 'ff-hero__video',
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        image_size: '2400x'
                    }}
                  {%- elsif block.settings.image != blank -%}
                    <img
                      class="ff-hero__image"
                      src="{{ block.settings.image | image_url: width: 2400 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 800 }} 800w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w,
                        {{ block.settings.image | image_url: width: 1600 }} 1600w,
                        {{ block.settings.image | image_url: width: 2000 }} 2000w,
                        {{ block.settings.image | image_url: width: 2400 }} 2400w
                      "
                      sizes="100vw"
                      alt="{{ block.settings.title | escape }}"
                      loading="{{ img_loading }}"
                      width="2400"
                      height="1350"
                      data-ff-desktop-image
                    >
                  {%- else -%}
                    <div class="ff-hero__placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                </div>
                <div class="ff-hero__media-mobile" data-ff-mobile-layer>
                  {%- if slide_mobile_video != blank -%}
                    {{
                      slide_mobile_video
                      | video_tag:
                        class: 'ff-hero__video',
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        image_size: '1200x'
                    }}
                  {%- elsif slide_video != blank -%}
                    {{
                      slide_video
                      | video_tag:
                        class: 'ff-hero__video',
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        image_size: '1200x'
                    }}
                  {%- elsif block.settings.mobile_image != blank -%}
                    <img
                      class="ff-hero__image"
                      src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
                      srcset="
                        {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                        {{ block.settings.mobile_image | image_url: width: 900 }} 900w,
                        {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                      "
                      sizes="100vw"
                      alt="{{ block.settings.title | escape }}"
                      loading="{{ img_loading }}"
                      width="1200"
                      height="1600"
                      data-ff-mobile-image
                    >
                  {%- elsif block.settings.image != blank -%}
                    <img
                      class="ff-hero__image"
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="{{ img_loading }}"
                      width="1200"
                      height="1600"
                      data-ff-mobile-fallback
                    >
                  {%- else -%}
                    <div class="ff-hero__placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="ff-hero__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <div class="ff-hero__shade" aria-hidden="true"></div>
            </div>

            <div class="ff-hero__content">
              {%- if block.settings.title != blank -%}
                <h2 class="ff-hero__title" {% render 'ff-type-style', size: block.settings.title_size, align: block.settings.title_align, min_ratio: 55 %}>
                  {{ block.settings.title | escape }}
                </h2>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="ff-hero__cta"
                  href="{{ block.settings.button_link | default: '#' }}"
                  {% render 'ff-type-style', size: block.settings.button_size, min_ratio: 90 %}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="ff-hero__nav ff-hero__nav--prev" data-ff-hero-prev aria-label="Previous slide">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="ff-hero__nav ff-hero__nav--next" data-ff-hero-next aria-label="Next slide">
        <span aria-hidden="true">›</span>
      </button>
      <div class="ff-hero__dots" role="tablist" aria-label="Hero slides">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ff-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-ff-hero-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
  <script src="{{ 'ff-hero-lifestyle.js' | asset_url }}" defer></script>
  <script src="{{ 'ff-hero-offer.js' | asset_url }}" defer></script>
{%- endif -%}

{% render 'ff-shop-by-vehicle-bar' %}

{% schema %}
{
  "name": "FF Hero Lifestyle",
  "tag": "section",
  "class": "section-ff-hero-lifestyle",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 55,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 75
    },
    {
      "type": "header",
      "content": "Text placement (all slides)"
    },
    {
      "type": "select",
      "id": "content_h_align",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_v_align",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "content_offset_x",
      "label": "Nudge left/right",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_offset_y",
      "label": "Nudge up/down",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Fills the hero like the image. Muted, looping, autoplay. Image is used as fallback/poster if video is empty."
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Optional. Falls back to desktop video, then mobile image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image only",
          "info": "Large screens only. Used when no desktop video is set, and as the video poster."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image only",
          "info": "Phones only. Upload here to change mobile without affecting desktop. Use the phone preview icon to verify."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Monoblock Forged"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Headline size",
          "min": 18,
          "max": 84,
          "step": 2,
          "unit": "px",
          "default": 42
        },
        {
          "type": "select",
          "id": "title_align",
          "label": "Headline align",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Browse Selection"
        },
        {
          "type": "range",
          "id": "button_size",
          "label": "Button text size",
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Hero Lifestyle",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Monoblock Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Two-Piece Forged",
            "button_label": "Browse Selection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Beadlock Forged",
            "button_label": "Browse Selection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
