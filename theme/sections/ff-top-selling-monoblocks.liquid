{{ 'ff-top-selling-monoblocks.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- liquid
    assign mono_collection = collections[section.settings.collection]
    if mono_collection == blank
      assign mono_collection = collections[section.settings.left_collection]
    endif
    assign product_limit = section.settings.product_limit | default: 8
    assign heading = section.settings.heading | default: 'Top selling monoblocks'
    assign buy_label = section.settings.buy_label | default: 'Buy Now'
    assign empty_text = section.settings.empty_text | default: 'Add monoblock products to this collection'
    assign view_label = section.settings.view_label | default: 'Shop all monoblocks'
    assign view_link = section.settings.view_link
    if view_link == blank and mono_collection != blank
      assign view_link = mono_collection.url
    endif
  -%}

  <section
    class="ff-new"
    id="ff-tsm-{{ section.id }}"
    data-ff-new
    style="
      --ff-new-pad-top: {{ section.settings.padding_top }}px;
      --ff-new-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ff-new__inner">
      {%- if heading != blank -%}
        <header class="ff-new__header">
          <h2 class="ff-new__heading">{{ heading | escape }}</h2>
          <p class="ff-pricing-note">Priced per wheel</p>
        </header>
      {%- endif -%}

      <div class="ff-new__rail-wrap">
        <button type="button" class="ff-new__nav ff-new__nav--prev" data-ff-new-prev aria-label="Previous products">
          <span aria-hidden="true">&#8249;</span>
        </button>

        <div class="ff-new__rail" data-ff-new-rail>
          {%- if mono_collection != blank and mono_collection.products_count > 0 -%}
            {%- for product in mono_collection.products limit: product_limit -%}
              {%- liquid
                assign card_image = product.featured_media
                if card_image == blank
                  assign card_image = product.featured_image
                endif
                assign card_blurb = product.description | strip_html | strip | truncate: 140
              -%}
              <article class="ff-new__card">
                <a class="ff-new__card-media" href="{{ product.url }}">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640, 900',
                        sizes: '(max-width: 749px) 70vw, 240px',
                        alt: product.title
                    }}
                  {%- else -%}
                    <span class="ff-new__card-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </a>
                <div class="ff-new__card-body">
                  <h3 class="ff-new__card-title">
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                  </h3>
                  {%- if card_blurb != blank -%}
                    <p class="ff-new__card-text">{{ card_blurb | escape }}</p>
                  {%- endif -%}
                  <a class="ff-new__buy" href="{{ product.url }}">{{ buy_label | escape }}</a>
                </div>
              </article>
            {%- endfor -%}
          {%- else -%}
            <div class="ff-new__empty">
              <p>{{ empty_text | escape }}</p>
            </div>
          {%- endif -%}
        </div>

        <button type="button" class="ff-new__nav ff-new__nav--next" data-ff-new-next aria-label="Next products">
          <span aria-hidden="true">&#8250;</span>
        </button>
      </div>

      {%- if view_label != blank and view_link != blank -%}
        <div class="ff-new__footer">
          <a class="ff-new__view-all" href="{{ view_link }}">{{ view_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  <script src="{{ 'ff-top-selling-monoblocks.js' | asset_url }}" defer></script>
  <script src="{{ 'ff-offer-boot.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Top Selling Monoblocks",
  "tag": "section",
  "class": "section-ff-top-selling-monoblocks",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top selling monoblocks",
      "info": "Saves to the homepage. In the editor, pick the “live” homepage template (top bar) for instant live updates, or click Save on the default template and run npm run theme:mirror-homepage."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Monoblock collection"
    },
    {
      "type": "collection",
      "id": "left_collection",
      "label": "Fallback collection (legacy)",
      "info": "Used if Monoblock collection is empty. Kept for existing homepage settings."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 3,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Buy button label",
      "default": "Buy Now"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add monoblock products to this collection"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "Shop all label",
      "default": "Shop all monoblocks"
    },
    {
      "type": "url",
      "id": "view_link",
      "label": "Shop all link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "FF Top Selling Monoblocks"
    }
  ]
}
{% endschema %}
