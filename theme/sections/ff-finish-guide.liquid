{{ 'ff-finish-guide.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section class="ff-finishes" id="ff-finishes-{{ section.id }}" data-ff-finishes>
    <div class="ff-finishes__inner">
      <header class="ff-finishes__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ff-finishes__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ff-finishes__page-heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ff-finishes__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      {%- if section.blocks.size > 0 -%}
        <nav class="ff-finishes__tabs" data-ff-finishes-tabs role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              <button
                type="button"
                class="ff-finishes__tab{% if forloop.first %} is-active{% endif %}"
                data-ff-finishes-tab="{{ block.id }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{ block.settings.tab_label | escape }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign b = block.settings
          -%}
          <div
            class="ff-finishes__panel{% if forloop.first %} is-active{% endif %}"
            data-ff-finishes-panel="{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if b.heading != blank -%}
              <h2 class="ff-finishes__heading">{{ b.heading | escape }}</h2>
            {%- endif -%}
            {%- if b.subheading != blank -%}
              <p class="ff-finishes__subheading">{{ b.subheading | escape }}</p>
            {%- endif -%}
            {%- if b.description != blank -%}
              <p class="ff-finishes__description">{{ b.description | escape }}</p>
            {%- endif -%}

            <div class="ff-finishes__swatches">
              {%- for i in (1..4) -%}
                {%- liquid
                  case i
                    when 1
                      assign name = b.finish_1_name
                      assign image = b.finish_1_image
                    when 2
                      assign name = b.finish_2_name
                      assign image = b.finish_2_image
                    when 3
                      assign name = b.finish_3_name
                      assign image = b.finish_3_image
                    when 4
                      assign name = b.finish_4_name
                      assign image = b.finish_4_image
                  endcase
                -%}
                {%- if name != blank -%}
                  <div class="ff-finishes__swatch">
                    <div class="ff-finishes__swatch-media">
                      {%- if image != blank -%}
                        {{
                          image
                          | image_url: width: 700
                          | image_tag:
                            loading: 'lazy',
                            widths: '350, 500, 700',
                            sizes: '(max-width: 749px) 45vw, 22vw',
                            alt: name
                        }}
                      {%- else -%}
                        <span class="ff-finishes__swatch-placeholder" aria-hidden="true"></span>
                      {%- endif -%}
                    </div>
                    <p class="ff-finishes__swatch-name">{{ name | escape }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
        <div class="ff-finishes__cta">
          <a class="button button--primary" href="{{ section.settings.quote_link }}">{{ section.settings.quote_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  <script src="{{ 'ff-finish-guide.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Finish Guide",
  "tag": "section",
  "class": "section-ff-finish-guide",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fortune Forged"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Finish Options"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every Fortune Forged wheel is available in a range of finishes. Select a category below to explore your options."
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "CTA button label",
      "default": "Get a custom quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Finish category",
      "settings": [
        {
          "type": "header",
          "content": "Category"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Standard Finishes"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Standard Finishes"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Gloss & Satin"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Included as standard options with every wheel set."
        },
        {
          "type": "header",
          "content": "Finish 1"
        },
        {
          "type": "text",
          "id": "finish_1_name",
          "label": "Name",
          "default": "Gloss"
        },
        {
          "type": "image_picker",
          "id": "finish_1_image",
          "label": "Photo"
        },
        {
          "type": "header",
          "content": "Finish 2"
        },
        {
          "type": "text",
          "id": "finish_2_name",
          "label": "Name",
          "default": "Satin"
        },
        {
          "type": "image_picker",
          "id": "finish_2_image",
          "label": "Photo"
        },
        {
          "type": "header",
          "content": "Finish 3"
        },
        {
          "type": "text",
          "id": "finish_3_name",
          "label": "Name"
        },
        {
          "type": "image_picker",
          "id": "finish_3_image",
          "label": "Photo"
        },
        {
          "type": "header",
          "content": "Finish 4"
        },
        {
          "type": "text",
          "id": "finish_4_name",
          "label": "Name"
        },
        {
          "type": "image_picker",
          "id": "finish_4_image",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Finish Guide",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "tab_label": "Standard Finishes",
            "heading": "Standard Finishes",
            "subheading": "Gloss & Satin",
            "description": "Included as standard options with every wheel set — a clean, durable finish for daily driving.",
            "finish_1_name": "Gloss",
            "finish_2_name": "Satin"
          }
        },
        {
          "type": "category",
          "settings": {
            "tab_label": "Premium Finishes",
            "heading": "Premium Finishes",
            "subheading": "Brushed, Polished & Chrome",
            "description": "Elevated finishing options for a bespoke, show-ready look.",
            "finish_1_name": "Brushed",
            "finish_2_name": "Polished",
            "finish_3_name": "Chrome"
          }
        }
      ]
    }
  ]
}
{% endschema %}
