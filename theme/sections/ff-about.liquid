{{ 'ff-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_image_mobile = section.settings.hero_image_mobile
  assign story_video = section.settings.story_video
  assign story_video_url = section.settings.story_video_url
  assign story_poster = section.settings.story_poster
  if hero_image == blank
    assign hero_image = images['IMG_2176.jpg']
  endif
-%}

<section class="ff-about" id="ff-about-{{ section.id }}">
  <div class="ff-about__hero">
    <div class="ff-about__hero-media" aria-hidden="true">
      {%- if hero_image != blank -%}
        {%- if hero_image_mobile != blank -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-about__hero-img ff-about__hero-img--desktop',
              loading: 'eager',
              widths: '800, 1200, 1600, 2400',
              sizes: '100vw',
              alt: ''
          }}
          {{
            hero_image_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'ff-about__hero-img ff-about__hero-img--mobile',
              loading: 'eager',
              widths: '600, 900, 1200',
              sizes: '100vw',
              alt: ''
          }}
        {%- else -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-about__hero-img',
              loading: 'eager',
              widths: '800, 1200, 1600, 2400',
              sizes: '100vw',
              alt: ''
          }}
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="ff-about__hero-shade" aria-hidden="true"></div>
    <div class="ff-about__hero-copy">
      <p class="ff-about__brand">{{ section.settings.brand | default: 'Fortune Forged' | escape }}</p>
      <span class="ff-about__brand-line" aria-hidden="true"></span>
      {%- if section.settings.lede != blank -%}
        <p class="ff-about__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      <div class="ff-about__cta-row">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
          <a class="ff-about__btn ff-about__btn--solid" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="ff-about__btn ff-about__btn--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ff-about__section">
    <div class="ff-about__section--story">
      <div>
        {%- if section.settings.story_eyebrow != blank -%}
          <p class="ff-about__eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.story_heading != blank -%}
          <h2 class="ff-about__heading">{{ section.settings.story_heading | escape }}</h2>
        {%- endif -%}
        <div class="ff-about__copy">
          {%- if section.settings.story_body != blank -%}
            {{ section.settings.story_body }}
          {%- endif -%}
        </div>
      </div>
      <div class="ff-about__story-media">
        {%- if story_video != blank -%}
          <div class="ff-about__story-video">
            {{
              story_video
              | video_tag:
                class: 'ff-about__story-video-el',
                image_size: '1200x',
                autoplay: section.settings.story_video_autoplay,
                loop: section.settings.story_video_loop,
                muted: section.settings.story_video_muted,
                controls: section.settings.story_video_controls
            }}
          </div>
        {%- elsif story_video_url != blank -%}
          <div class="ff-about__story-video">
            {%- if story_video_url.type == 'youtube' -%}
              <iframe
                class="ff-about__story-iframe"
                src="https://www.youtube.com/embed/{{ story_video_url.id }}?rel=0&modestbranding=1{% if section.settings.story_video_autoplay %}&autoplay=1&mute=1{% endif %}{% if section.settings.story_video_loop %}&loop=1&playlist={{ story_video_url.id }}{% endif %}"
                title="{{ section.settings.story_heading | default: 'Fortune Forged' | escape }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- elsif story_video_url.type == 'vimeo' -%}
              <iframe
                class="ff-about__story-iframe"
                src="https://player.vimeo.com/video/{{ story_video_url.id }}?{% if section.settings.story_video_autoplay %}autoplay=1&muted=1&{% endif %}{% if section.settings.story_video_loop %}loop=1&{% endif %}title=0&byline=0&portrait=0"
                title="{{ section.settings.story_heading | default: 'Fortune Forged' | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- endif -%}
          </div>
        {%- elsif story_poster != blank -%}
          <div class="ff-about__story-video ff-about__story-video--poster">
            {{
              story_poster
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200',
                sizes: '(max-width: 899px) 100vw, 46vw',
                alt: section.settings.story_heading | default: 'Fortune Forged'
            }}
            <p class="ff-about__story-video-hint">Add a video in Theme settings → FF About</p>
          </div>
        {%- else -%}
          <div class="ff-about__story-video ff-about__story-video--empty">
            <p class="ff-about__story-video-hint">Square video area — upload a Shopify video or paste a YouTube/Vimeo link in FF About settings.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ff-about__section ff-about__section--build">
    <div class="ff-about__build-inner">
      <header class="ff-about__build-header">
        {%- if section.settings.build_eyebrow != blank -%}
          <p class="ff-about__eyebrow">{{ section.settings.build_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.build_heading != blank -%}
          <h2 class="ff-about__heading">{{ section.settings.build_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.build_intro != blank -%}
          <p class="ff-about__copy" style="margin:0;">{{ section.settings.build_intro | escape }}</p>
        {%- endif -%}
      </header>

      <ol class="ff-about__points">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <li class="ff-about__point" data-ff-about-point {{ block.shopify_attributes }}>
              <span class="ff-about__point-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="ff-about__point-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="ff-about__point-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>

  <div class="ff-about__section ff-about__section--mission">
    {%- if section.settings.mission != blank -%}
      <p class="ff-about__mission">{{ section.settings.mission | escape }}</p>
    {%- endif -%}
    {%- if section.settings.mission_note != blank -%}
      <p class="ff-about__mission-note">{{ section.settings.mission_note | escape }}</p>
    {%- endif -%}
  </div>

  <div class="ff-about__section ff-about__section--close">
    {%- if section.settings.close_text != blank -%}
      <p class="ff-about__close-copy">{{ section.settings.close_text | escape }}</p>
    {%- endif -%}
    <div class="ff-about__cta-row ff-about__cta-row--center">
      {%- if section.settings.close_label != blank and section.settings.close_link != blank -%}
        <a class="ff-about__btn ff-about__btn--solid" href="{{ section.settings.close_link }}">{{ section.settings.close_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'ff-about.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FF About",
  "tag": "section",
  "class": "section-ff-about",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "paragraph",
      "content": "Hero is the full-bleed top photo. The story column uses a square video area instead of a still image."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (desktop + mobile)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile only, optional)",
      "info": "Leave blank to reuse the main hero image on mobile."
    },
    {
      "type": "header",
      "content": "Story video (square)"
    },
    {
      "type": "paragraph",
      "content": "Add a Shopify-hosted video, or a YouTube/Vimeo link. Shopify video takes priority if both are set."
    },
    {
      "type": "video",
      "id": "story_video",
      "label": "Shopify video"
    },
    {
      "type": "video_url",
      "id": "story_video_url",
      "label": "YouTube or Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "story_poster",
      "label": "Placeholder image (optional)",
      "info": "Shown only when no video is set yet."
    },
    {
      "type": "checkbox",
      "id": "story_video_autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_muted",
      "label": "Muted (required for autoplay on most browsers)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero text"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "Fortune Forged"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Hero supporting line",
      "default": "Custom forged wheels, factory-backed builds, and fitment that holds up on the street."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Start a build"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "Talk to us"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story eyebrow",
      "default": "The shop"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Built from the factory floor"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story body",
      "default": "<p>We’re not a badge slapped on someone else’s wheels. Fortune Forged owns a stake in the factory that machines every set—so design, materials, finishing, and QC stay under one roof.</p><p>That means tighter control, clearer answers, and wheels that match what you ordered. From first sketch to final torque spec, the same team is accountable for how it looks and how it sits.</p>"
    },
    {
      "type": "header",
      "content": "How we work"
    },
    {
      "type": "text",
      "id": "build_eyebrow",
      "label": "Build eyebrow",
      "default": "How we work"
    },
    {
      "type": "text",
      "id": "build_heading",
      "label": "Build heading",
      "default": "What we actually sweat"
    },
    {
      "type": "textarea",
      "id": "build_intro",
      "label": "Build intro",
      "default": "Less catalog fluff. More clearances, finishes, and people who answer the phone."
    },
    {
      "type": "header",
      "content": "Mission + closing"
    },
    {
      "type": "textarea",
      "id": "mission",
      "label": "Mission line",
      "default": "Look right. Sit right. Last."
    },
    {
      "type": "textarea",
      "id": "mission_note",
      "label": "Mission note",
      "default": "Forged strength, custom finishes, and fitment support from people who actually care how your car rolls out of the bay."
    },
    {
      "type": "textarea",
      "id": "close_text",
      "label": "Closing text",
      "default": "Ready to spec a set? Tell us the car, the look, and how you drive—we’ll help lock the build."
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Closing CTA label",
      "default": "Get a quote"
    },
    {
      "type": "url",
      "id": "close_link",
      "label": "Closing CTA link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF About",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Real fitment",
            "text": "Specs dialed for your chassis—offsets, brake clearance, and tire package—not a generic one-size catalog guess."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Custom finishes",
            "text": "Brushed, polished, powder, one-offs. The face of the wheel gets the same attention as the face of the car."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Direct support",
            "text": "Talk to people who build and drive this stuff. Same-day answers when you need a call on sizing, finish, or install."
          }
        }
      ]
    }
  ]
}
{% endschema %}
