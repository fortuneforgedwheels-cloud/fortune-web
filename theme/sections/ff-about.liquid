{{ 'ff-about-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_image_mobile = section.settings.hero_image_mobile
  assign story_video = section.settings.story_video
  assign story_video_url = section.settings.story_video_url
  assign story_poster = section.settings.story_poster
  if hero_image == blank
    assign hero_image = images['IMG_2176.jpg']
  endif

  assign hero_h = section.settings.hero_h_align | default: 'left'
  assign hero_v = section.settings.hero_v_align | default: 'bottom'
  assign hero_ox = section.settings.hero_offset_x | default: 0
  assign hero_oy = section.settings.hero_offset_y | default: 0

  case hero_h
    when 'center'
      assign hero_left = '50%'
      assign hero_right = 'auto'
      assign hero_tx = '-50%'
      assign hero_justify = 'center'
      assign hero_items = 'center'
      assign hero_text = 'center'
    when 'right'
      assign hero_left = 'auto'
      assign hero_right = '0'
      assign hero_tx = '0'
      assign hero_justify = 'flex-end'
      assign hero_items = 'flex-end'
      assign hero_text = 'right'
    else
      assign hero_left = '0'
      assign hero_right = 'auto'
      assign hero_tx = '0'
      assign hero_justify = 'flex-start'
      assign hero_items = 'flex-start'
      assign hero_text = 'left'
  endcase

  case hero_v
    when 'top'
      assign hero_top = '0'
      assign hero_bottom = 'auto'
      assign hero_ty = '0'
    when 'middle'
      assign hero_top = '50%'
      assign hero_bottom = 'auto'
      assign hero_ty = '-50%'
    else
      assign hero_top = 'auto'
      assign hero_bottom = '0'
      assign hero_ty = '0'
  endcase

  assign mission_align = section.settings.mission_align | default: 'center'
  assign story_align = section.settings.story_align | default: 'left'
  assign build_align = section.settings.build_align | default: 'left'

  case mission_align
    when 'left'
      assign mission_items = 'flex-start'
    when 'right'
      assign mission_items = 'flex-end'
    else
      assign mission_items = 'center'
  endcase
-%}

<section
  class="ff-about"
  id="ff-about-{{ section.id }}"
  style="
    --ff-hero-left: {{ hero_left }};
    --ff-hero-right: {{ hero_right }};
    --ff-hero-top: {{ hero_top }};
    --ff-hero-bottom: {{ hero_bottom }};
    --ff-hero-tx: {{ hero_tx }};
    --ff-hero-ty: {{ hero_ty }};
    --ff-hero-ox: {{ hero_ox }}px;
    --ff-hero-oy: {{ hero_oy }}px;
    --ff-hero-justify: {{ hero_justify }};
    --ff-hero-items: {{ hero_items }};
    --ff-hero-text: {{ hero_text }};
    --ff-mission-align: {{ mission_align }};
    --ff-mission-items: {{ mission_items }};
    --ff-story-align: {{ story_align }};
    --ff-build-align: {{ build_align }};
  "
>
  <div class="ff-about__hero">
    <div class="ff-about__hero-media" aria-hidden="true">
      {%- if hero_image != blank -%}
        {%- if hero_image_mobile != blank -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-about__hero-img ff-about__hero-img--desktop',
              loading: 'eager',
              widths: '800, 1200, 1600, 2400',
              sizes: '100vw',
              alt: ''
          }}
          {{
            hero_image_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'ff-about__hero-img ff-about__hero-img--mobile',
              loading: 'eager',
              widths: '600, 900, 1200',
              sizes: '100vw',
              alt: ''
          }}
        {%- else -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-about__hero-img',
              loading: 'eager',
              widths: '800, 1200, 1600, 2400',
              sizes: '100vw',
              alt: ''
          }}
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="ff-about__hero-shade" aria-hidden="true"></div>
    <div class="ff-about__hero-copy">
      {%- if section.settings.lede != blank -%}
        <p class="ff-about__lede" {% render 'ff-type-style', size: section.settings.lede_size, align: section.settings.lede_align, min_ratio: 75 %}>
          {{ section.settings.lede | escape }}
        </p>
      {%- endif -%}
      <div class="ff-about__hero-bar">
        <div class="ff-about__brand-block">
          <p class="ff-about__brand" {% render 'ff-type-style', size: section.settings.brand_size, align: section.settings.brand_align, min_ratio: 55 %}>
            {{ section.settings.brand | default: 'Fortune Forged' | escape }}
          </p>
          <span class="ff-about__brand-line" aria-hidden="true"></span>
        </div>
        <div class="ff-about__cta-row">
          {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
            <a
              class="ff-about__btn ff-about__btn--solid"
              href="{{ section.settings.primary_link }}"
              {% render 'ff-type-style', size: section.settings.primary_size, min_ratio: 90 %}
            >{{ section.settings.primary_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
            <a
              class="ff-about__btn ff-about__btn--ghost"
              href="{{ section.settings.secondary_link }}"
              {% render 'ff-type-style', size: section.settings.secondary_size, min_ratio: 90 %}
            >{{ section.settings.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="ff-about__section">
    <div class="ff-about__section--story">
      <div class="ff-about__story-copy">
        {%- if section.settings.story_eyebrow != blank -%}
          <p class="ff-about__eyebrow" {% render 'ff-type-style', size: section.settings.story_eyebrow_size, align: section.settings.story_eyebrow_align, min_ratio: 90 %}>
            {{ section.settings.story_eyebrow | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.story_heading != blank -%}
          <h2 class="ff-about__heading" {% render 'ff-type-style', size: section.settings.story_heading_size, align: section.settings.story_heading_align, min_ratio: 70 %}>
            {{ section.settings.story_heading | escape }}
          </h2>
        {%- endif -%}
        <div class="ff-about__copy" {% render 'ff-type-style', size: section.settings.story_body_size, align: section.settings.story_body_align, min_ratio: 85 %}>
          {%- if section.settings.story_body != blank -%}
            {{ section.settings.story_body }}
          {%- endif -%}
        </div>
      </div>
      <div class="ff-about__story-media">
        {%- if story_video != blank -%}
          <div class="ff-about__story-video">
            {{
              story_video
              | video_tag:
                class: 'ff-about__story-video-el',
                image_size: '1200x',
                autoplay: section.settings.story_video_autoplay,
                loop: section.settings.story_video_loop,
                muted: section.settings.story_video_muted,
                controls: section.settings.story_video_controls
            }}
          </div>
        {%- elsif story_video_url != blank -%}
          <div class="ff-about__story-video">
            {%- if story_video_url.type == 'youtube' -%}
              <iframe
                class="ff-about__story-iframe"
                src="https://www.youtube.com/embed/{{ story_video_url.id }}?rel=0&modestbranding=1{% if section.settings.story_video_autoplay %}&autoplay=1&mute=1{% endif %}{% if section.settings.story_video_loop %}&loop=1&playlist={{ story_video_url.id }}{% endif %}"
                title="{{ section.settings.story_heading | default: 'Fortune Forged' | escape }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- elsif story_video_url.type == 'vimeo' -%}
              <iframe
                class="ff-about__story-iframe"
                src="https://player.vimeo.com/video/{{ story_video_url.id }}?{% if section.settings.story_video_autoplay %}autoplay=1&muted=1&{% endif %}{% if section.settings.story_video_loop %}loop=1&{% endif %}title=0&byline=0&portrait=0"
                title="{{ section.settings.story_heading | default: 'Fortune Forged' | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- endif -%}
          </div>
        {%- elsif story_poster != blank -%}
          <div class="ff-about__story-video ff-about__story-video--poster">
            {{
              story_poster
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200',
                sizes: '(max-width: 899px) 100vw, 46vw',
                alt: section.settings.story_heading | default: 'Fortune Forged'
            }}
          </div>
        {%- else -%}
          <div class="ff-about__story-video ff-about__story-video--empty">
            <p class="ff-about__story-video-hint">Square video area — upload a Shopify video or paste a YouTube/Vimeo link in FF About settings.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ff-about__section ff-about__section--build">
    <div class="ff-about__build-inner">
      <header class="ff-about__build-header">
        {%- if section.settings.build_eyebrow != blank -%}
          <p class="ff-about__eyebrow" {% render 'ff-type-style', size: section.settings.build_eyebrow_size, align: section.settings.build_eyebrow_align, min_ratio: 90 %}>
            {{ section.settings.build_eyebrow | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.build_heading != blank -%}
          <h2 class="ff-about__heading" {% render 'ff-type-style', size: section.settings.build_heading_size, align: section.settings.build_heading_align, min_ratio: 70 %}>
            {{ section.settings.build_heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.build_intro != blank -%}
          <p class="ff-about__copy ff-about__copy--intro" {% render 'ff-type-style', size: section.settings.build_intro_size, align: section.settings.build_intro_align, min_ratio: 85 %}>
            {{ section.settings.build_intro | escape }}
          </p>
        {%- endif -%}
      </header>

      <ol class="ff-about__points">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <li class="ff-about__point" data-ff-about-point {{ block.shopify_attributes }}>
              <span class="ff-about__point-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="ff-about__point-title" {% render 'ff-type-style', size: block.settings.title_size, align: block.settings.title_align, min_ratio: 80 %}>
                    {{ block.settings.title | escape }}
                  </h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="ff-about__point-text" {% render 'ff-type-style', size: block.settings.text_size, align: block.settings.text_align, min_ratio: 85 %}>
                    {{ block.settings.text | escape }}
                  </p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>

  <div class="ff-about__section ff-about__section--mission">
    <div class="ff-about__mission-stack">
      {%- if section.settings.mission != blank -%}
        <p class="ff-about__mission" {% render 'ff-type-style', size: section.settings.mission_size, align: section.settings.mission_line_align, min_ratio: 55 %}>
          {{ section.settings.mission | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.mission_note != blank -%}
        <p class="ff-about__mission-note" {% render 'ff-type-style', size: section.settings.mission_note_size, align: section.settings.mission_note_align, min_ratio: 70 %}>
          {{ section.settings.mission_note | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.close_text != blank -%}
        <p class="ff-about__close-copy" {% render 'ff-type-style', size: section.settings.close_text_size, align: section.settings.close_text_align, min_ratio: 75 %}>
          {{ section.settings.close_text | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.close_label != blank and section.settings.close_link != blank -%}
        <div class="ff-about__cta-row ff-about__cta-row--mission">
          <a
            class="ff-about__btn ff-about__btn--solid"
            href="{{ section.settings.close_link }}"
            {% render 'ff-type-style', size: section.settings.close_label_size, min_ratio: 90 %}
          >{{ section.settings.close_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'ff-about.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FF About",
  "tag": "section",
  "class": "section-ff-about",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "paragraph",
      "content": "Hero is the full-bleed top photo. The story column uses a square video area instead of a still image."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (desktop + mobile)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile only, optional)",
      "info": "Leave blank to reuse the main hero image on mobile."
    },
    {
      "type": "header",
      "content": "Story video (square)"
    },
    {
      "type": "paragraph",
      "content": "Add a Shopify-hosted video, or a YouTube/Vimeo link. Shopify video takes priority if both are set."
    },
    {
      "type": "video",
      "id": "story_video",
      "label": "Shopify video"
    },
    {
      "type": "video_url",
      "id": "story_video_url",
      "label": "YouTube or Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "story_poster",
      "label": "Placeholder image (optional)",
      "info": "Shown only when no video is set yet."
    },
    {
      "type": "checkbox",
      "id": "story_video_autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_muted",
      "label": "Muted (required for autoplay on most browsers)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "story_video_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero placement"
    },
    {
      "type": "select",
      "id": "hero_h_align",
      "label": "Hero horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "hero_v_align",
      "label": "Hero vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "hero_offset_x",
      "label": "Hero nudge left/right",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "hero_offset_y",
      "label": "Hero nudge up/down",
      "min": -80,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Hero text"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "Fortune Forged"
    },
    {
      "type": "range",
      "id": "brand_size",
      "label": "Brand size",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "select",
      "id": "brand_align",
