{{ 'ff-faq.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section class="ff-faq" id="ff-faq-{{ section.id }}">
    <div class="ff-faq__atmosphere" aria-hidden="true"></div>
    <div class="ff-faq__inner">
      <header class="ff-faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ff-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ff-faq__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ff-faq__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      {%- assign categories = section.blocks | where: 'type', 'category' -%}
      {%- if categories.size > 1 -%}
        <nav class="ff-faq__topics" aria-label="FAQ topics">
          <a class="ff-faq__topic is-active" href="#ff-faq-{{ section.id }}" data-ff-faq-topic="all">All</a>
          {%- for block in categories -%}
            {%- if block.settings.title != blank -%}
              <a
                class="ff-faq__topic"
                href="#ff-faq-cat-{{ block.id }}"
                data-ff-faq-topic="{{ block.id }}"
              >{{ block.settings.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="ff-faq__groups">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <div class="ff-faq__group" id="ff-faq-cat-{{ block.id }}" data-ff-faq-group="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="ff-faq__group-title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              <div class="ff-faq__items">
                {%- for i in (1..10) -%}
                  {%- liquid
                    assign q_key = 'question_' | append: i
                    assign a_key = 'answer_' | append: i
                    assign question = block.settings[q_key]
                    assign answer = block.settings[a_key]
                  -%}
                  {%- if question != blank -%}
                    <details class="ff-faq__item">
                      <summary class="ff-faq__question">
                        <span>{{ question | escape }}</span>
                        <span class="ff-faq__icon" aria-hidden="true"></span>
                      </summary>
                      <div class="ff-faq__answer">
                        {%- if answer != blank -%}
                          {{ answer }}
                        {%- endif -%}
                      </div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <div class="ff-faq__cta">
          <p class="ff-faq__cta-text">{{ section.settings.cta_text | escape }}</p>
          <a class="ff-faq__cta-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  <script src="{{ 'ff-faq.js' | asset_url }}" defer></script>
{%- endif -%}

