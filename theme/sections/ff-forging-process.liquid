{{ 'ff-forging-gold.css' | asset_url | stylesheet_tag }}
<style>
  .ff-forge {
    --ff-forge-accent: #dce1e6 !important;
    --ff-forge-text: #ffffff !important;
  }
  .ff-forge__title {
    color: #dce1e6 !important;
  }
  .ff-forge__eyebrow,
  .ff-forge__intro,
  .ff-forge__step-kicker,
  .ff-forge__step-title,
  .ff-forge__step-label,
  .ff-forge__step-text,
  .ff-forge__step-text p,
  .ff-forge__cta-text {
    color: #ffffff !important;
  }
</style>

<section class="ff-forge" id="ff-forge-{{ section.id }}" data-ff-forge-gold="1" data-ff-forge-layout="steps-v2">
  <div class="ff-forge__hero">
    <div class="ff-forge__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ff-forge__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="ff-forge__title">{{ section.settings.heading | default: 'The Forging Process' | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="ff-forge__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ff-forge__body">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'step' -%}
          {%- liquid
            assign step_index = forloop.index
            assign img1 = block.settings.image_1
            assign img2 = block.settings.image_2
            assign img3 = block.settings.image_3
            assign img4 = block.settings.image_4
            assign media_style = block.settings.media_style | default: 'grid'
            assign step_kicker = block.settings.kicker
            assign hard_urls = ''

            if step_index == 1
              if step_kicker == blank
                assign step_kicker = 'FROM BILLET TO BLANK'
              endif
              assign media_style = 'grid'
              assign hard_urls = 'https://fortuneforgedwheels.com/cdn/shop/files/forza-manufacturing_7.webp|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2128.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2125.jpg|https://fortuneforgedwheels.com/cdn/shop/files/Screenshot_2026-07-27_at_11.35.47_PM.png'
            elsif step_index == 2
              if step_kicker == blank
                assign step_kicker = 'DENSE GRAIN STRUCTURE'
              endif
              assign media_style = 'solo'
              assign hard_urls = 'https://fortuneforgedwheels.com/cdn/shop/files/forza-manufacturing_7.webp'
            elsif step_index == 3
              if step_kicker == blank
                assign step_kicker = 'WHERE DESIGN COMES TO LIFE'
              endif
              assign media_style = 'grid'
              assign hard_urls = 'https://fortuneforgedwheels.com/cdn/shop/files/IMG_2142.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2140.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2135.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2134.jpg'
            elsif step_index == 4
              if step_kicker == blank
                assign step_kicker = 'AMERICAN-MADE PRECISION'
              endif
              assign media_style = 'solo'
              assign hard_urls = 'https://fortuneforgedwheels.com/cdn/shop/files/IMG_2128.jpg'
            elsif step_index == 5
              if step_kicker == blank
                assign step_kicker = 'BUILT TO SHIP'
              endif
              assign media_style = 'grid'
              assign hard_urls = 'https://fortuneforgedwheels.com/cdn/shop/files/IMG_0840.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_2133.jpg|https://fortuneforgedwheels.com/cdn/shop/files/IMG_0857.jpg|https://fortuneforgedwheels.com/cdn/shop/files/HU9A6779.jpg'
            endif

            assign hard_list = hard_urls | split: '|'
            assign step_class = 'ff-forge__step'
            if block.settings.flip or step_index == 2 or step_index == 5
              assign step_class = step_class | append: ' ff-forge__step--flip'
            endif
            if media_style == 'solo'
              assign step_class = step_class | append: ' ff-forge__step--solo'
            endif
          -%}
          <article class="{{ step_class }}" {{ block.shopify_attributes }}>
            <div class="ff-forge__step-copy">
              {%- if step_kicker != blank -%}
                <p class="ff-forge__step-kicker">{{ step_kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="ff-forge__step-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.number != blank -%}
                <p class="ff-forge__step-label">Step {{ block.settings.number | escape }}:</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ff-forge__step-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

            <div class="ff-forge__step-media">
              {%- if media_style == 'solo' -%}
                <div class="ff-forge__solo-img">
                  {%- if img1 != blank -%}
                    {{
                      img1
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        widths: '600, 900, 1200, 1600',
                        sizes: '(max-width: 899px) 100vw, 50vw',
                        alt: block.settings.heading
                    }}
                  {%- else -%}
                    <img
                      src="{{ hard_list[0] }}"
                      alt="{{ block.settings.heading | escape }}"
                      loading="lazy"
                      width="1600"
                      height="1100"
                    >
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="ff-forge__grid">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign picked = blank
                      if i == 1
                        assign picked = img1
                      elsif i == 2
                        assign picked = img2
                      elsif i == 3
                        assign picked = img3
                      else
                        assign picked = img4
                      endif
                      assign hard_i = i | minus: 1
                      assign hard_src = hard_list[hard_i]
                    -%}
                    {%- if picked != blank or hard_src != blank -%}
                      <div class="ff-forge__grid-item">
                        {%- if picked != blank -%}
                          {{
                            picked
                            | image_url: width: 900
                            | image_tag:
                              loading: 'lazy',
                              widths: '400, 600, 900',
                              sizes: '(max-width: 899px) 50vw, 25vw',
                              alt: block.settings.heading
                          }}
                        {%- else -%}
                          <img
                            src="{{ hard_src }}"
                            alt="{{ block.settings.heading | escape }}"
                            loading="lazy"
                            width="900"
                            height="675"
                          >
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </article>

        {%- when 'cta' -%}
          <div class="ff-forge__cta" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <p class="ff-forge__cta-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="ff-forge__cta-btn" href="{{ block.settings.button_link | default: '/collections/all' }}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FF Forging Process",
  "tag": "section",
  "class": "section-ff-forging-process",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Manufacturing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (gold)",
      "default": "The Forging Process"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro (white)",
      "default": "Every Fortune Forged wheel starts as aerospace-grade billet and leaves as a precision instrument for the street and track. Here’s how we get there."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Small kicker",
          "default": "WHERE DESIGN COMES TO LIFE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "MILLING."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "default": "5"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We start with certified aluminum billet chosen for strength, weight, and finish quality.</p>"
        },
        {
          "type": "select",
          "id": "media_style",
          "label": "Media layout",
          "default": "grid",
          "options": [
            { "value": "grid", "label": "2×2 image grid" },
            { "value": "solo", "label": "Single large image" }
          ]
        },
        {
          "type": "checkbox",
          "id": "flip",
          "label": "Flip media to the left",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1 (or solo image)"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image 4"
        }
      ]
    },
    {
      "type": "cta",
      "name": "CTA",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ready to spec your set?"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop wheels"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Forging Process"
    }
  ]
}
{% endschema %}
