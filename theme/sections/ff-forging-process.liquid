{{ 'ff-forging-gold.css' | asset_url | stylesheet_tag }}
<style>
  /* Inline fallback so sticky CDN hashes cannot keep orange accents */
  .ff-forge {
    --ff-forge-accent: #dce1e6 !important;
    --ff-forge-accent-soft: rgba(220, 225, 230, 0.16) !important;
  }
  .ff-forge__eyebrow,
  .ff-forge__step-num {
    color: #dce1e6 !important;
  }
  .ff-forge__cta-btn {
    background: #dce1e6 !important;
    border-color: #dce1e6 !important;
    color: #0a0a0a !important;
  }
  .ff-forge__cta-btn:hover {
    background: #f0f3f5 !important;
    border-color: #f0f3f5 !important;
    color: #0a0a0a !important;
  }
</style>

<section class="ff-forge" id="ff-forge-{{ section.id }}" data-ff-forge-gold="1">
  <div class="ff-forge__hero">
    <div class="ff-forge__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ff-forge__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="ff-forge__title">{{ section.settings.heading | default: 'The Forging Process' | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="ff-forge__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ff-forge__body">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'step' -%}
          <article class="ff-forge__step" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <span class="ff-forge__step-num">{{ block.settings.number | escape }}</span>
            {%- endif -%}
            <div class="ff-forge__step-copy">
              {%- if block.settings.heading != blank -%}
                <h2 class="ff-forge__step-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ff-forge__step-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- when 'cta' -%}
          <div class="ff-forge__cta" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <p class="ff-forge__cta-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="ff-forge__cta-btn" href="{{ block.settings.button_link | default: '/collections/all' }}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FF Forging Process",
  "tag": "section",
  "class": "section-ff-forging-process",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Manufacturing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Forging Process"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every Fortune Forged wheel starts as aerospace-grade billet and leaves as a precision instrument for the street and track. Here’s how we get there."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Billet selection"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We start with certified aluminum billet chosen for strength, weight, and finish quality.</p>"
        }
      ]
    },
    {
      "type": "cta",
      "name": "CTA",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ready to spec your set?"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop wheels"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Forging Process"
    }
  ]
}
{% endschema %}
