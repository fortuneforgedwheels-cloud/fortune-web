{{ 'ff-fan-favorites.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="ff-fan"
    id="ff-fan-{{ section.id }}"
    data-ff-fan
    style="
      --ff-fan-pad-top: {{ section.settings.padding_top }}px;
      --ff-fan-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ff-fan__inner">
      <header class="ff-fan__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ff-fan__eyebrow" {% render 'ff-type-style', size: section.settings.eyebrow_size, align: section.settings.eyebrow_align, min_ratio: 90 %}>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ff-fan__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ff-fan__subheading" {% render 'ff-type-style', size: section.settings.subheading_size, align: section.settings.subheading_align, min_ratio: 75 %}>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <div class="ff-fan__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'vehicle_setup' -%}
            {%- liquid
              assign b = block.settings
              assign design_default_product = blank
              unless b.design_default == blank
                assign design_default_product = all_products[b.design_default]
              endunless
              assign card_image = b.card_image | default: design_default_product.featured_image
            -%}
            <div class="ff-fan__item">
              <p class="ff-fan__label">{{ b.vehicle_label | escape }}</p>
              <button
                type="button"
                class="ff-fan__card"
                data-ff-fan-open="{{ block.id }}"
                aria-haspopup="dialog"
                {{ block.shopify_attributes }}
              >
                <span class="ff-fan__thumb">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'ff-fan__thumb-img',
                        loading: 'lazy',
                        widths: '400, 600, 900',
                        sizes: '(max-width: 749px) 50vw, 25vw',
                        alt: b.vehicle_label
                    }}
                  {%- else -%}
                    <span class="ff-fan__thumb-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                  <span class="ff-fan__thumb-shade" aria-hidden="true"></span>
                  <span class="ff-fan__thumb-cta">{{ section.settings.card_cta | escape }}</span>
                </span>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="ff-fan__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'vehicle_setup' -%}
        {%- liquid
          assign b = block.settings
          assign design_default_product = blank
          unless b.design_default == blank
            assign design_default_product = all_products[b.design_default]
          endunless
          assign design_alt_1_product = blank
          unless b.design_alt_1 == blank
            assign design_alt_1_product = all_products[b.design_alt_1]
          endunless
          assign design_alt_2_product = blank
          unless b.design_alt_2 == blank
            assign design_alt_2_product = all_products[b.design_alt_2]
          endunless
          assign design_alt_3_product = blank
          unless b.design_alt_3 == blank
            assign design_alt_3_product = all_products[b.design_alt_3]
          endunless
          assign beadlock_design_product = blank
          unless b.beadlock_design == blank
            assign beadlock_design_product = all_products[b.beadlock_design]
          endunless
          assign card_image = b.card_image | default: design_default_product.featured_image
          assign has_full = false
          if b.front_spec != blank and b.rear_spec != blank
            assign has_full = true
          endif
          assign has_bead = false
          if b.beadlock_spec != blank
            assign has_bead = true
          endif
          assign fallback_link = section.settings.quote_link | default: '/#order'
        -%}
        <div class="ff-fan__modal" data-ff-fan-modal="{{ block.id }}" hidden>
          <div class="ff-fan__backdrop" data-ff-fan-close tabindex="-1"></div>
          <div
            class="ff-fan__dialog"
            role="dialog"
            aria-modal="true"
            aria-label="{{ b.vehicle_label | escape }}"
            tabindex="-1"
            data-ff-fan-dialog
          >
            <button type="button" class="ff-fan__close" data-ff-fan-close aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>

            <div class="ff-fan__dialog-grid">
              <div class="ff-fan__visual" data-ff-fan-visual>
                <div class="ff-fan__visual-group" data-ff-fan-visual-group="full">
                  {%- liquid
                    assign fslide_shown = false
                  -%}
                  {%- if b.full_image_1 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless fslide_shown %} is-active{% endunless %}" {% if fslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.full_image_1 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign fslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.full_image_2 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless fslide_shown %} is-active{% endunless %}" {% if fslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.full_image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign fslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.full_image_3 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless fslide_shown %} is-active{% endunless %}" {% if fslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.full_image_3 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign fslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.full_image_4 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless fslide_shown %} is-active{% endunless %}" {% if fslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.full_image_4 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign fslide_shown = true -%}
                  {%- endif -%}
                  {%- unless fslide_shown -%}
                    {%- assign full_fallback_image = card_image | default: design_default_product.featured_image -%}
                    {%- if full_fallback_image != blank -%}
                      <figure class="ff-fan__visual-slide is-active" data-ff-fan-visual-slide>
                        {{ full_fallback_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                      </figure>
                    {%- endif -%}
                  {%- endunless -%}
                </div>

                <div class="ff-fan__visual-group" data-ff-fan-visual-group="bead" hidden>
                  {%- liquid
                    assign bslide_shown = false
                  -%}
                  {%- if b.bead_image_1 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless bslide_shown %} is-active{% endunless %}" {% if bslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.bead_image_1 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign bslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.bead_image_2 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless bslide_shown %} is-active{% endunless %}" {% if bslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.bead_image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign bslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.bead_image_3 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless bslide_shown %} is-active{% endunless %}" {% if bslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.bead_image_3 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign bslide_shown = true -%}
                  {%- endif -%}
                  {%- if b.bead_image_4 != blank -%}
                    <figure class="ff-fan__visual-slide{% unless bslide_shown %} is-active{% endunless %}" {% if bslide_shown %}hidden{% endif %} data-ff-fan-visual-slide>
                      {{ b.bead_image_4 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                    </figure>
                    {%- assign bslide_shown = true -%}
                  {%- endif -%}
                  {%- unless bslide_shown -%}
                    {%- assign bead_fallback_image = beadlock_design_product.featured_image | default: design_default_product.featured_image -%}
                    {%- if bead_fallback_image != blank -%}
                      <figure class="ff-fan__visual-slide is-active" data-ff-fan-visual-slide>
                        {{ bead_fallback_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.vehicle_label }}
                      </figure>
                    {%- endif -%}
                  {%- endunless -%}
                </div>

                <button type="button" class="ff-fan__visual-nav ff-fan__visual-nav--prev" data-ff-fan-visual-prev hidden aria-label="Previous photo">
                  <span aria-hidden="true">&lsaquo;</span>
                </button>
                <button type="button" class="ff-fan__visual-nav ff-fan__visual-nav--next" data-ff-fan-visual-next hidden aria-label="Next photo">
                  <span aria-hidden="true">&rsaquo;</span>
                </button>
                <div class="ff-fan__visual-counter" data-ff-fan-visual-counter></div>
              </div>

              <div class="ff-fan__config" data-ff-fan-config>
                <p class="ff-fan__config-badge">{{ section.settings.badge_label | escape }}</p>
                <h3 class="ff-fan__config-title">{{ b.vehicle_label | escape }}</h3>

                {%- if has_full == false and has_bead == false -%}
                  <p class="ff-fan__config-copy">{{ section.settings.no_fitment_copy | escape }}</p>
                  <a class="button button--primary ff-fan__cta" href="{{ fallback_link }}">
                    {{ section.settings.quote_cta | escape }}
                  </a>
                {%- else -%}

                  {%- if has_full and has_bead -%}
                    <div class="ff-fan__modes" data-ff-fan-modes>
                      <button type="button" class="ff-fan__mode is-selected" data-ff-fan-mode="full">
                        {{ section.settings.mode_full_label | escape }} <span>{{ section.settings.mode_full_sublabel | escape }}</span>
                      </button>
                      <button type="button" class="ff-fan__mode" data-ff-fan-mode="bead">
                        {{ section.settings.mode_bead_label | escape }} <span>{{ section.settings.mode_bead_sublabel | escape }}</span>
                      </button>
                    </div>
                  {%- endif -%}

                  {%- if has_full -%}
                    <div class="ff-fan__setup" data-ff-fan-setup="full">
                      <dl class="ff-fan__specs">
                        <div><dt>{{ section.settings.front_label | escape }}</dt><dd>{{ b.front_spec | escape }}</dd></div>
                        <div><dt>{{ section.settings.rear_label | escape }}</dt><dd>{{ b.rear_spec | escape }}</dd></div>
                      </dl>
                      {%- if b.full_set_note != blank -%}
                        <p class="ff-fan__note">{{ b.full_set_note | escape }}</p>
                      {%- endif -%}

                      <div class="ff-fan__designs" data-ff-fan-designs="full">
                        {%- if design_default_product != blank -%}
                          <button
                            type="button"
                            class="ff-fan__design is-selected"
                            data-ff-fan-design
                            data-variant-id="{{ design_default_product.variants.first.id }}"
                            data-title="{{ design_default_product.title | escape }}"
                            data-price="{{ design_default_product.price | money }}"
                          >
                            {%- if design_default_product.featured_image != blank -%}
                              {{ design_default_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: design_default_product.title }}
                            {%- endif -%}
                            <span>{{ design_default_product.title | escape }}</span>
                          </button>
                        {%- endif -%}
                        {%- if design_alt_1_product != blank -%}
                          <button
                            type="button"
                            class="ff-fan__design"
                            data-ff-fan-design
                            data-variant-id="{{ design_alt_1_product.variants.first.id }}"
                            data-title="{{ design_alt_1_product.title | escape }}"
                            data-price="{{ design_alt_1_product.price | money }}"
                          >
                            {%- if design_alt_1_product.featured_image != blank -%}
                              {{ design_alt_1_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: design_alt_1_product.title }}
                            {%- endif -%}
                            <span>{{ design_alt_1_product.title | escape }}</span>
                          </button>
                        {%- endif -%}
                        {%- if design_alt_2_product != blank -%}
                          <button
                            type="button"
                            class="ff-fan__design"
                            data-ff-fan-design
                            data-variant-id="{{ design_alt_2_product.variants.first.id }}"
                            data-title="{{ design_alt_2_product.title | escape }}"
                            data-price="{{ design_alt_2_product.price | money }}"
                          >
                            {%- if design_alt_2_product.featured_image != blank -%}
                              {{ design_alt_2_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: design_alt_2_product.title }}
                            {%- endif -%}
                            <span>{{ design_alt_2_product.title | escape }}</span>
                          </button>
                        {%- endif -%}
                        {%- if design_alt_3_product != blank -%}
                          <button
                            type="button"
                            class="ff-fan__design"
                            data-ff-fan-design
                            data-variant-id="{{ design_alt_3_product.variants.first.id }}"
                            data-title="{{ design_alt_3_product.title | escape }}"
                            data-price="{{ design_alt_3_product.price | money }}"
                          >
                            {%- if design_alt_3_product.featured_image != blank -%}
                              {{ design_alt_3_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: design_alt_3_product.title }}
                            {%- endif -%}
                            <span>{{ design_alt_3_product.title | escape }}</span>
                          </button>
                        {%- endif -%}
                      </div>
                      {%- if design_default_product != blank and b.show_price_estimate -%}
                        <p class="ff-fan__price" data-ff-fan-price="full">
                          {{ design_default_product.price | money }} {{ section.settings.price_each_label | escape }} &middot; est.
                          {{ design_default_product.price | times: 4 | money }} {{ section.settings.price_full_set_label | escape }}
                        </p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if has_bead -%}
                    <div class="ff-fan__setup" data-ff-fan-setup="bead" {% if has_full %}hidden{% endif %}>
                      <dl class="ff-fan__specs">
                        <div><dt>{{ section.settings.rear_pair_label | escape }}</dt><dd>{{ b.beadlock_spec | escape }}</dd></div>
                      </dl>
                      {%- if b.beadlock_note != blank -%}
                        <p class="ff-fan__note">{{ b.beadlock_note | escape }}</p>
                      {%- endif -%}
                      {%- assign bead_design = beadlock_design_product | default: design_default_product -%}
                      {%- if bead_design != blank -%}
                        <div class="ff-fan__designs" data-ff-fan-designs="bead">
                          <button
                            type="button"
                            class="ff-fan__design is-selected"
                            data-ff-fan-design
                            data-variant-id="{{ bead_design.variants.first.id }}"
                            data-title="{{ bead_design.title | escape }}"
                            data-price="{{ bead_design.price | money }}"
                          >
                            {%- if bead_design.featured_image != blank -%}
                              {{ bead_design.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: bead_design.title }}
                            {%- endif -%}
                            <span>{{ bead_design.title | escape }}</span>
                          </button>
                        </div>
                        {%- if b.show_price_estimate -%}
                          <p class="ff-fan__price" data-ff-fan-price="bead">
                            {{ bead_design.price | money }} {{ section.settings.price_each_label | escape }} &middot; est.
                            {{ bead_design.price | times: 2 | money }} {{ section.settings.price_pair_label | escape }}
                          </p>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="ff-fan__field">
                    <label class="ff-fan__label-sm">{{ section.settings.finish_label | escape }}</label>
                    <div class="ff-fan__finishes" data-ff-fan-finishes>
                      {%- assign finishes = b.finish_options | split: ',' -%}
                      {%- for finish in finishes -%}
                        <button
                          type="button"
                          class="ff-fan__finish{% if forloop.first %} is-selected{% endif %}"
                          data-ff-fan-finish="{{ finish | strip | escape }}"
                        >
                          {{ finish | strip | escape }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>

                  <button
                    type="button"
                    class="button button--primary ff-fan__cta"
                    data-ff-fan-add
                    data-vehicle="{{ b.vehicle_label | escape }}"
                    data-label-default="{{ section.settings.add_to_cart_label | escape }}"
                    data-label-loading="{{ section.settings.adding_label | escape }}"
                  >
                    {{ section.settings.add_to_cart_label | escape }}
                  </button>
                  <p
                    class="ff-fan__error"
                    data-ff-fan-error
                    data-error-missing-design="{{ section.settings.error_missing_design | escape }}"
                    data-error-cart-failed="{{ section.settings.error_cart_failed | escape }}"
                    hidden
                  ></p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <script src="{{ 'ff-fan-favorites.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Fan Favorites",
  "tag": "section",
  "class": "section-ff-fan-favorites",
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fortune Forged"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "eyebrow_align",
      "label": "Eyebrow align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track tested favorites"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most requested wheel and fitment combinations — sizing already dialed in for these platforms. Pick your finish and we'll build the rest."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "subheading_align",
      "label": "Subheading align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "card_cta",
      "label": "Card hover label",
      "default": "Build this setup"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Exact fitment, pricing, and any modifications are confirmed by our team before your order ships."
    },
    {
      "type": "header",
      "content": "Popup wording"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Track Tested Favorite"
    },
    {
      "type": "text",
      "id": "mode_full_label",
      "label": "Full set mode label",
      "default": "Full Set"
    },
    {
      "type": "text",
      "id": "mode_full_sublabel",
      "label": "Full set mode sublabel",
      "default": "4 wheels"
    },
    {
      "type": "text",
      "id": "mode_bead_label",
      "label": "Beadlock mode label",
      "default": "Beadlock Rear Pair"
    },
    {
      "type": "text",
      "id": "mode_bead_sublabel",
      "label": "Beadlock mode sublabel",
      "default": "2 wheels"
    },
    {
      "type": "text",
      "id": "front_label",
      "label": "Front spec label",
      "default": "Front"
    },
    {
      "type": "text",
      "id": "rear_label",
      "label": "Rear spec label",
      "default": "Rear"
    },
    {
      "type": "text",
      "id": "rear_pair_label",
      "label": "Beadlock rear pair spec label",
      "default": "Rear pair"
    },
    {
      "type": "text",
      "id": "finish_label",
      "label": "Finish field label",
      "default": "Finish"
    },
    {
      "type": "text",
      "id": "price_each_label",
      "label": "Price 'each' label",
      "default": "per wheel"
    },
    {
      "type": "text",
      "id": "price_full_set_label",
      "label": "Price full-set estimate label",
      "default": "for a full set of 4"
    },
    {
      "type": "text",
      "id": "price_pair_label",
      "label": "Price pair estimate label",
      "default": "priced by the pair"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add My Setup to Cart"
    },
    {
      "type": "text",
      "id": "adding_label",
      "label": "Add to cart loading label",
      "default": "Adding…"
    },
    {
      "type": "text",
      "id": "error_missing_design",
      "label": "Error — no design selected",
      "default": "Please choose a wheel design before adding to cart."
    },
    {
      "type": "text",
      "id": "error_cart_failed",
      "label": "Error — cart add failed",
      "default": "Something went wrong adding this to your cart. Please try again."
    },
    {
      "type": "header",
      "content": "No fitment configured yet"
    },
    {
      "type": "textarea",
      "id": "no_fitment_copy",
      "label": "Fallback copy",
      "default": "We're dialing in the exact fitment for this platform. Get a custom quote and a fitment specialist will confirm your perfect spec."
    },
    {
      "type": "text",
      "id": "quote_cta",
      "label": "Fallback quote button label",
      "default": "Get a custom quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Fallback quote link",
      "info": "Used when a vehicle has no fitment configured yet. Defaults to the quote section."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
