{{ 'ff-value-props.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- liquid
    assign video_id = section.settings.youtube_id | strip
    assign show_feature = false
    if section.settings.show_feature_media
      if video_id != blank or section.settings.feature_image != blank or section.settings.video != blank
        assign show_feature = true
      endif
    endif
  -%}
  <section
    class="ff-values"
    id="ff-values-{{ section.id }}"
    style="
      --ff-values-pad-top: {{ section.settings.padding_top }}px;
      --ff-values-pad-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.background_image != blank %}
        --ff-values-bg: url({{ section.settings.background_image | image_url: width: 2400 }});
      {% endif %}
    "
  >
    <div class="ff-values__shade" aria-hidden="true"></div>
    <div class="ff-values__inner">
      {%- if section.settings.heading != blank -%}
        <header class="ff-values__header">
          <h2 class="ff-values__heading">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="ff-values__subheading" {% render 'ff-type-style', size: section.settings.subheading_size, align: section.settings.subheading_align, min_ratio: 75 %}>{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if show_feature -%}
        <div class="ff-values__feature">
          {%- if section.settings.video != blank -%}
            <div class="ff-values__feature-frame">
              {{
                section.settings.video
                | video_tag:
                  class: 'ff-values__feature-video',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: true,
                  image_size: '2000x'
              }}
            </div>
          {%- elsif video_id != blank -%}
            <div class="ff-values__feature-frame ff-values__feature-frame--embed">
              <iframe
                class="ff-values__feature-embed"
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1"
                title="{{ section.settings.heading | default: shop.name | escape }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {%- elsif section.settings.feature_image != blank -%}
            <div class="ff-values__feature-frame">
              {{
                section.settings.feature_image
                | image_url: width: 2000
                | image_tag:
                  class: 'ff-values__feature-image',
                  loading: 'lazy',
                  widths: '800, 1200, 1600, 2000',
                  sizes: '(max-width: 1200px) 100vw, 1200px',
                  alt: section.settings.heading
              }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ff-values__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <article class="ff-values__card" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="ff-values__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                <div class="ff-values__media">
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'ff-values__image',
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '(max-width: 749px) 100vw, 30vw',
                      alt: block.settings.title
                  }}
                </div>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="ff-values__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.link_label != blank -%}
                {%- if block.settings.link != blank -%}
                  <a class="ff-values__link" href="{{ block.settings.link }}">
                    {{ block.settings.link_label | escape }}
                  </a>
                {%- else -%}
                  <p class="ff-values__link ff-values__link--static">
                    {{ block.settings.link_label | escape }}
                  </p>
                {%- endif -%}
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Value Props",
  "tag": "section",
  "class": "section-ff-value-props",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Large heading",
      "default": "THE FORTUNE FORGED EXPERIENCE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Custom forged wheels engineered for your build."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "subheading_align",
      "label": "Subheading align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Feature video / media"
    },
    {
      "type": "checkbox",
      "id": "show_feature_media",
      "label": "Show rectangular media slot under heading",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "text",
      "id": "youtube_id",
      "label": "YouTube video ID",
      "info": "Used if no Shopify-hosted video is set. Example: S7oXlkAWxyo",
      "default": "S7oXlkAWxyo"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Fallback image",
      "info": "Shown only if no video is set"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TAILORED"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every set is built around your vehicle, fitment goals, and finish — not a one-size warehouse wheel."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Bottom line",
          "default": "BUILT-TO-ORDER FITMENT FOR YOUR VEHICLE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Bottom line link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Value Props",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "TAILORED",
            "text": "Every set is built around your vehicle, fitment goals, and finish — not a one-size warehouse wheel.",
            "link_label": "BUILT-TO-ORDER FITMENT FOR YOUR VEHICLE"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "LIGHTER",
            "text": "Forged construction delivers strength where it matters and sheds unnecessary mass for sharper response.",
            "link_label": "FORGED STRENGTH WITHOUT EXCESS WEIGHT"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "EXCLUSIVE",
            "text": "From brushed and polished to custom powder coats, finish your wheels to match the rest of the build.",
            "link_label": "CUSTOM FINISHES & ONE-OFF BUILDS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
