{{ 'ff-beadlock-packages.css' | asset_url | stylesheet_tag }}
<!-- ff-btp-bust {{ 'now' | date: '%s' }} no-hero-cta -->

{%- if section.settings.show_section -%}
  {%- liquid
    assign hero_image = section.settings.hero_image
    if hero_image == blank
      for block in section.blocks
        if block.type == 'package' and block.settings.product != blank
          assign hero_image = block.settings.product.featured_image
          break
        endif
      endfor
    endif
  -%}

  <section class="ff-btp" id="ff-btp-{{ section.id }}" data-ff-btp>
    <div class="ff-btp__hero">
      <div class="ff-btp__hero-media" aria-hidden="true">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'ff-btp__hero-img',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              alt: ''
          }}
        {%- else -%}
          <span class="ff-btp__hero-fallback"></span>
        {%- endif -%}
      </div>
      <div class="ff-btp__hero-shade" aria-hidden="true"></div>

      <div class="ff-btp__hero-copy">
        {%- if section.settings.brand != blank -%}
          <p class="ff-btp__brand">{{ section.settings.brand | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ff-btp__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <p class="ff-btp__lede">{{ section.settings.lede | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="ff-btp__cta" href="{{ section.settings.cta_link | default: '#ff-btp-packages' }}">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="ff-btp__packages" id="ff-btp-packages">
      <div class="ff-btp__packages-inner">
        <header class="ff-btp__packages-header">
          {%- if section.settings.packages_eyebrow != blank -%}
            <p class="ff-btp__eyebrow">{{ section.settings.packages_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.packages_heading != blank -%}
            <h2 class="ff-btp__packages-heading">{{ section.settings.packages_heading | escape }}</h2>
          {%- endif -%}
          <p class="ff-pricing-note">Priced by the pair</p>
          {%- if section.settings.packages_copy != blank -%}
            <p class="ff-btp__packages-copy">{{ section.settings.packages_copy | escape }}</p>
          {%- endif -%}
        </header>

        <div class="ff-btp__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'package' -%}
              {%- liquid
                assign pkg = block.settings.product
                assign card_title = block.settings.title
                assign card_image = block.settings.image
                if card_title == blank and pkg != blank
                  assign card_title = pkg.title
                endif
                if card_image == blank and pkg != blank
                  assign card_image = pkg.featured_image
                endif
                assign card_url = block.settings.link
                if card_url == blank and pkg != blank
                  assign card_url = pkg.url
                endif
                if card_url == blank
                  assign card_url = '#'
                endif
              -%}
              <a
                class="ff-btp__card"
                href="{{ card_url }}"
                {{ block.shopify_attributes }}
              >
                <span class="ff-btp__card-media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'ff-btp__card-img',
                        loading: 'lazy',
                        widths: '400, 600, 900, 1200',
                        sizes: '(max-width: 989px) 100vw, 33vw',
                        alt: card_title
                    }}
                  {%- else -%}
                    <span class="ff-btp__card-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </span>
                <span class="ff-btp__card-body">
                  {%- if block.settings.chassis != blank -%}
                    <span class="ff-btp__card-chassis">{{ block.settings.chassis | escape }}</span>
                  {%- endif -%}
                  {%- if card_title != blank -%}
                    <span class="ff-btp__card-title">{{ card_title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.note != blank -%}
                    <span class="ff-btp__card-note">{{ block.settings.note | escape }}</span>
                  {%- endif -%}
                  <span class="ff-btp__card-footer">
                    {%- if block.settings.price_override != blank -%}
                      <span class="ff-btp__card-price">{{ block.settings.price_override | escape }}</span>
                    {%- elsif pkg != blank -%}
                      <span class="ff-btp__card-price">{{ pkg.price | money }}</span>
                    {%- endif -%}
                    <span class="ff-btp__card-cta">{{ section.settings.card_cta | default: 'View package' | escape }}</span>
                  </span>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.includes_heading != blank or section.settings.includes_copy != blank -%}
          <div class="ff-btp__includes">
            {%- if section.settings.includes_heading != blank -%}
              <h3 class="ff-btp__includes-heading">{{ section.settings.includes_heading | escape }}</h3>
            {%- endif -%}
            {%- if section.settings.includes_copy != blank -%}
              <p class="ff-btp__includes-copy">{{ section.settings.includes_copy | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Beadlock Packages",
  "tag": "section",
  "class": "section-ff-beadlock-packages",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Falls back to the first package product image if blank."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "Fortune Forged"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beadlock + Tire Packages"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting sentence",
      "default": "Chassis-specific forged beadlock wheels and drag tires, built to order as a direct bolt-on pack."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Hero CTA label",
      "info": "Leave blank to hide the hero button."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Hero CTA link",
      "info": "Defaults to the chassis grid on this page."
    },
    {
      "type": "text",
      "id": "packages_eyebrow",
      "label": "Packages eyebrow",
      "default": "Built to order"
    },
    {
      "type": "text",
      "id": "packages_heading",
      "label": "Packages heading",
      "default": "Select your chassis"
    },
    {
      "type": "textarea",
      "id": "packages_copy",
      "label": "Packages supporting copy",
      "default": "Each pack ships with the correct bolt pattern, lug seat, center bore, and offsets for that platform."
    },
    {
      "type": "text",
      "id": "card_cta",
      "label": "Card CTA",
      "default": "View package"
    },
    {
      "type": "text",
      "id": "includes_heading",
      "label": "Includes heading",
      "default": "What's included"
    },
    {
      "type": "textarea",
      "id": "includes_copy",
      "label": "Includes copy",
      "default": "Four forged beadlock wheels, four drag tires, OEM TPMS compatibility, and OEM-style center caps — engineered for clearance, load rating, and rear drag-pack performance."
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "chassis",
          "label": "Chassis label",
          "default": "G8X"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Short note",
          "default": "Forged beadlock + drag tire turnkey pack"
        },
        {
          "type": "text",
          "id": "price_override",
          "label": "Price override",
          "info": "Leave blank to use the product price."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Beadlock Packages",
      "blocks": [
        { "type": "package" },
        { "type": "package" },
        { "type": "package" }
      ]
    }
  ]
}
{% endschema %}
