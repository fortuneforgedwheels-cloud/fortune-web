{{ 'ff-fitment-finder.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- assign ff_makes = 'BMW,Mercedes-Benz,Audi,Porsche,Chevrolet,Corvette,Ford,Dodge,RAM,Jeep,Toyota,Lexus,Nissan,Land Rover,Tesla,Volkswagen,GMC,Cadillac,Kia,Hyundai,Subaru,Mazda,Honda,Acura,Infiniti,Volvo,Genesis,Maserati,Ferrari,Lamborghini,McLaren,Bentley,Rolls-Royce,Jaguar,MINI,Fiat,Chrysler,Lincoln,Buick' | split: ',' -%}
  {%- assign ff_fitment_form_id = 'FFFitmentQuote-' | append: section.id -%}

  <section
    class="ff-fitment"
    id="ff-fitment-{{ section.id }}"
    data-ff-fitment
    data-product-title="{{ product.title | escape }}"
    style="
      --ff-fitment-pad-top: {{ section.settings.padding_top }}px;
      --ff-fitment-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ff-fitment__inner">
      <header class="ff-fitment__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ff-fitment__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ff-fitment__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ff-fitment__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      <div class="ff-fitment__saved" data-ff-fitment-saved hidden>
        <p class="ff-fitment__saved-text">
          Your vehicle: <strong data-ff-fitment-saved-label></strong>
        </p>
        <button type="button" class="ff-fitment__change" data-ff-fitment-change>Change vehicle</button>
      </div>

      <form class="ff-fitment__form" data-ff-fitment-form novalidate>
        <div class="ff-fitment__fields">
          <div class="ff-fitment__field">
            <label class="ff-fitment__label" for="ff-fitment-year-{{ section.id }}">Year</label>
            <select class="ff-fitment__input" id="ff-fitment-year-{{ section.id }}" data-ff-fitment-year required>
              <option value="">Select year</option>
              {%- for i in (1..42) -%}
                {%- assign ff_year = 2027 | minus: i -%}
                <option value="{{ ff_year }}">{{ ff_year }}</option>
              {%- endfor -%}
            </select>
          </div>
          <div class="ff-fitment__field">
            <label class="ff-fitment__label" for="ff-fitment-make-{{ section.id }}">Make</label>
            <select class="ff-fitment__input" id="ff-fitment-make-{{ section.id }}" data-ff-fitment-make required>
              <option value="">Select make</option>
              {%- for make in ff_makes -%}
                <option value="{{ make | strip }}">{{ make | strip }}</option>
              {%- endfor -%}
              <option value="Other">Other / not listed</option>
            </select>
          </div>
          <div class="ff-fitment__field ff-fitment__field--model">
            <label class="ff-fitment__label" for="ff-fitment-model-{{ section.id }}">Model</label>
            <input
              class="ff-fitment__input"
              id="ff-fitment-model-{{ section.id }}"
              type="text"
              data-ff-fitment-model
              placeholder="{{ section.settings.model_placeholder | escape }}"
              autocomplete="off"
              required
            >
          </div>
        </div>
        <button type="submit" class="ff-fitment__submit button button--primary">
          {{ section.settings.submit_label | escape }}
        </button>
      </form>

      <div class="ff-fitment__result" data-ff-fitment-result hidden>
        <div class="ff-fitment__panel ff-fitment__panel--match" data-ff-fitment-panel-match hidden>
          <span class="ff-fitment__badge ff-fitment__badge--match">{{ section.settings.match_badge | escape }}</span>
          <p class="ff-fitment__panel-title" data-ff-fitment-match-vehicle></p>
          <p class="ff-fitment__panel-copy" data-ff-fitment-match-sizes></p>
          <div class="ff-fitment__panel-actions">
            <a class="button button--secondary ff-fitment__guide-link" data-ff-fitment-guide-link hidden></a>
          </div>
          <p class="ff-fitment__reassure">{{ section.settings.match_reassure | escape }}</p>
        </div>

        <div class="ff-fitment__panel ff-fitment__panel--custom" data-ff-fitment-panel-custom hidden>
          <span class="ff-fitment__badge ff-fitment__badge--custom">{{ section.settings.custom_badge | escape }}</span>
          <p class="ff-fitment__panel-title">{{ section.settings.custom_heading | escape }}</p>
          <p class="ff-fitment__panel-copy">{{ section.settings.custom_copy | escape }}</p>

          {%- form 'contact', id: ff_fitment_form_id, class: 'ff-fitment__quote' -%}
            {%- if form.posted_successfully? -%}
              <div class="ff-fitment__success" role="status">
                {{ section.settings.success_message | escape }}
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="ff-fitment__error" role="alert">{{ form.errors | default_errors }}</div>
              {%- endif -%}
              <input type="hidden" name="contact[form_name]" value="Product Page Fitment Check">
              <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
              <input type="hidden" name="contact[vehicle]" data-ff-fitment-hidden-vehicle value="">
              <div class="ff-fitment__quote-grid">
                <input
                  class="ff-fitment__input"
                  type="text"
                  name="contact[name]"
                  placeholder="Name*"
                  required
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  autocomplete="name"
                >
                <input
                  class="ff-fitment__input"
                  type="email"
                  name="contact[email]"
                  placeholder="Email*"
                  required
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email"
                >
                <input
                  class="ff-fitment__input"
                  type="tel"
                  name="contact[phone]"
                  placeholder="Phone*"
                  required
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  autocomplete="tel"
                >
              </div>
              <button type="submit" class="button button--primary ff-fitment__quote-submit">
                {{ section.settings.custom_submit_label | escape }}
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

      {%- if section.settings.unsure_note != blank -%}
        <p class="ff-fitment__footnote">{{ section.settings.unsure_note | escape }}</p>
      {%- endif -%}
    </div>

    <script type="application/json" data-ff-fitment-data>
      [
        {%- for block in section.blocks -%}
          {%- if block.type == 'vehicle_match' -%}
            {
              "makes": {{ block.settings.makes | default: '' | json }},
              "models": {{ block.settings.model_keywords | default: '' | json }},
              "yearMin": {{ block.settings.year_min | default: 0 }},
              "yearMax": {{ block.settings.year_max | default: 9999 }},
              "label": {{ block.settings.match_label | default: '' | json }},
              "sizes": {{ block.settings.recommended_sizes | default: '' | json }},
              "guideUrl": {{ block.settings.guide_link | default: '' | json }},
              "guideLabel": {{ block.settings.guide_link_label | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
  </section>

  <script src="{{ 'ff-fitment-finder.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FF Fitment Finder",
  "tag": "section",
  "class": "section-ff-fitment-finder",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fortune Forged"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Fitment"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro copy",
      "default": "Tell us what you drive and we'll confirm this wheel is a perfect fit before it ever leaves the shop."
    },
    {
      "type": "text",
      "id": "model_placeholder",
      "label": "Model field placeholder",
      "default": "e.g. M3, 428i, Corvette Z06"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Check My Fitment"
    },
    {
      "type": "header",
      "content": "Confirmed fit result"
    },
    {
      "type": "text",
      "id": "match_badge",
      "label": "Confirmed badge text",
      "default": "✓ Confirmed Fit"
    },
    {
      "type": "text",
      "id": "match_reassure",
      "label": "Reassurance line",
      "default": "Add to cart with confidence — our team double-checks every spec before your order ships."
    },
    {
      "type": "header",
      "content": "Custom fit result (no match found)"
    },
    {
      "type": "text",
      "id": "custom_badge",
      "label": "Custom badge text",
      "default": "Built To Order"
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Custom result heading",
      "default": "We custom-fit every wheel to your exact vehicle"
    },
    {
      "type": "textarea",
      "id": "custom_copy",
      "label": "Custom result copy",
      "default": "We didn't find your exact vehicle in our guide, but every Fortune Forged wheel is built to order. Leave your info and a fitment specialist will confirm your perfect spec before you order."
    },
    {
      "type": "text",
      "id": "custom_submit_label",
      "label": "Custom submit button label",
      "default": "Get My Fitment Confirmed"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Got it — a Fortune Forged fitment specialist will follow up shortly to confirm your exact spec."
    },
    {
      "type": "text",
      "id": "unsure_note",
      "label": "Footnote (always shown)",
      "default": "Not sure about your specs? Our team confirms fitment on every custom order at no extra cost."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "vehicle_match",
      "name": "Vehicle match",
      "settings": [
        {
          "type": "text",
          "id": "match_label",
          "label": "Display name",
          "info": "Shown when a customer's vehicle matches this entry.",
          "default": "BMW G20/G22 3 & 4 Series"
        },
        {
          "type": "text",
          "id": "makes",
          "label": "Makes (comma separated)",
          "info": "Must match the Make dropdown exactly, e.g. BMW",
          "default": "BMW"
        },
        {
          "type": "text",
          "id": "model_keywords",
          "label": "Model keywords (comma separated)",
          "info": "Matches if the customer's model contains any of these words. Leave blank to match any model for this make + year range.",
          "default": "3 Series,4 Series,320i,330i,340i,M340i,430i,440i,M440i,G20,G22"
        },
        {
          "type": "number",
          "id": "year_min",
          "label": "Year from",
          "default": 2019
        },
        {
          "type": "number",
          "id": "year_max",
          "label": "Year to",
          "default": 2026
        },
        {
          "type": "text",
          "id": "recommended_sizes",
          "label": "Recommended fitment note",
          "default": "Direct bolt-on fitment — front and rear sizes engineered to sit flush with a clean stance."
        },
        {
          "type": "url",
          "id": "guide_link",
          "label": "Full fitment guide link"
        },
        {
          "type": "text",
          "id": "guide_link_label",
          "label": "Guide link label",
          "default": "View full fitment guide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Fitment Finder",
      "blocks": [
        {
          "type": "vehicle_match",
          "settings": {
            "match_label": "BMW G20/G22 3 & 4 Series",
            "makes": "BMW",
            "model_keywords": "3 Series,4 Series,320i,330i,340i,M340i,430i,440i,M440i,G20,G22",
            "year_min": 2019,
            "year_max": 2026,
            "recommended_sizes": "Direct bolt-on fitment — front and rear sizes engineered to sit flush with a clean stance."
          }
        },
        {
          "type": "vehicle_match",
          "settings": {
            "match_label": "BMW G80/G82 M3 & M4",
            "makes": "BMW",
            "model_keywords": "M3,M4,G80,G82,G83",
            "year_min": 2021,
            "year_max": 2026,
            "recommended_sizes": "Direct bolt-on fitment — clears M-brake packages with a flush, aggressive stance."
          }
        },
        {
          "type": "vehicle_match",
          "settings": {
            "match_label": "BMW F80/F82 M3 & M4",
            "makes": "BMW",
            "model_keywords": "M3,M4,F80,F82,F83",
            "year_min": 2015,
            "year_max": 2020,
            "recommended_sizes": "Precision-fit to sit flush, clear brakes, and perform without compromise."
          }
        },
        {
          "type": "vehicle_match",
          "settings": {
            "match_label": "BMW E90/E92/E93 3 Series",
            "makes": "BMW",
            "model_keywords": "3 Series,328i,335i,M3,E90,E92,E93",
            "year_min": 2006,
            "year_max": 2013,
            "recommended_sizes": "Balanced, direct-fit sizing for an aggressive stance without sacrificing drivability."
          }
        }
      ]
    }
  ]
}
{% endschema %}
