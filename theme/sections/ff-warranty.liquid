{{ 'ff-warranty.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section class="ff-warranty" id="ff-warranty-{{ section.id }}">
    <div class="ff-warranty__atmosphere" aria-hidden="true"></div>
    <div class="ff-warranty__inner">
      <header class="ff-warranty__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ff-warranty__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ff-warranty__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ff-warranty__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      <div class="ff-warranty__highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'highlight' -%}
            <div class="ff-warranty__highlight" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="ff-warranty__highlight-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2 class="ff-warranty__highlight-title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="ff-warranty__highlight-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ff-warranty__sections">
        {%- for block in section.blocks -%}
          {%- if block.type == 'section' -%}
            <article class="ff-warranty__section" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="ff-warranty__section-title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="ff-warranty__section-body">{{ block.settings.body }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="ff-warranty__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <div class="ff-warranty__cta">
          <a class="ff-warranty__cta-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Warranty",
  "tag": "section",
  "class": "section-ff-warranty",
  "max_blocks": 20,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fortune Forged"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warranty"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Contact support"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Coverage"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "section",
      "name": "Section",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Warranty"
    }
  ]
}
{% endschema %}
