{{ 'ff-trust-badges.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="ff-trust"
    id="ff-trust-{{ section.id }}"
    style="
      --ff-trust-pad-top: {{ section.settings.padding_top }}px;
      --ff-trust-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ff-trust__inner">
      <div class="ff-trust__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            {%- liquid
              assign icon = block.settings.icon
              assign contact_email = block.settings.contact_email | default: shop.email
            -%}
            <div class="ff-trust__card" {{ block.shopify_attributes }}>
              <span class="ff-trust__icon" aria-hidden="true">
                {%- case icon -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.6 2.6L16.4 9"/></svg>
                  {%- when 'race_car' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 14.5h17"/><path d="M5 14.5 6.8 9.8c.3-.8 1-1.3 1.8-1.3h5.3c.7 0 1.3.3 1.7.9l2.9 4.1"/><path d="M8.2 8.5h4.4l.8 2.8H7.6l.6-2.8Z"/><circle cx="7.2" cy="14.5" r="1.7"/><circle cx="16.8" cy="14.5" r="1.7"/><path d="M11.2 8.5 10.4 6.8H8.8"/><path d="M19.5 11.2h1.3v2.2"/></svg>
                  {%- when 'wheel' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6.2 6.2l2.1 2.1M15.7 15.7l2.1 2.1M17.8 6.2l-2.1 2.1M8.3 15.7l-2.1 2.1"/></svg>
                  {%- when 'phone_person' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="6.5" r="2.5"/><path d="M5.5 19.5v-1.2c0-2.4 2-4.3 4.5-4.3s4.5 1.9 4.5 4.3v1.2"/><path d="M16.5 8.5v2.2c0 1.3.8 2.3 2 2.3h.8"/><path d="M19.3 13v3.2a1.3 1.3 0 0 1-1.3 1.3h-.5"/><path d="M19.3 10.2a1.1 1.1 0 1 0 0-2.2"/></svg>
                  {%- when 'computer' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/></svg>
                  {%- when 'bolt' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 4 8 8 9 4-1 8-4 8-9V6l-8-3Z"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="10"/><path d="M15 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.6 2.6L16.4 9"/></svg>
                {%- endcase -%}
              </span>
              {%- if block.settings.heading != blank or block.id == 'badge_secure' -%}
                {%- liquid
                  assign heading_text = block.settings.heading
                  assign heading_href = block.settings.heading_link
                  assign heading_key = heading_text | strip | downcase
                  if block.id == 'badge_secure' or heading_key == 'secure checkout' or heading_key contains 'affiliate'
                    assign heading_text = 'Become an affiliate'
                    if heading_href == blank
                      assign heading_href = '/pages/become-an-affiliate'
                    endif
                  endif
                -%}
                {%- if heading_href != blank -%}
                  <p class="ff-trust__heading">
                    <a class="ff-trust__heading-link" href="{{ heading_href }}">{{ heading_text | escape }}</a>
                  </p>
                {%- else -%}
                  <p class="ff-trust__heading">{{ heading_text | escape }}</p>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ff-trust__desc">
                  {{ block.settings.description | escape }}
                  {%- if block.settings.show_email and contact_email != blank -%}
                    <a class="ff-trust__link" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FF Trust Badges",
  "tag": "section",
  "class": "section-ff-trust-badges",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "race_car", "label": "Race car" },
            { "value": "computer", "label": "Computer" },
            { "value": "wheel", "label": "Car wheel" },
            { "value": "phone_person", "label": "Person on phone" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fitment Guaranteed"
        },
        {
          "type": "text",
          "id": "heading_link",
          "label": "Heading link",
          "info": "Optional. Makes the heading an underlined clickable link (e.g. /pages/become-an-affiliate)."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Engineered for your chassis. Professional install required. If it doesn't fit, we make it right."
        },
        {
          "type": "checkbox",
          "id": "show_email",
          "label": "Show contact email link",
          "default": false
        },
        {
          "type": "text",
          "id": "contact_email",
          "label": "Contact email override",
          "info": "Leave blank to use the store's contact email automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FF Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "check",
            "heading": "Fitment Guaranteed",
            "description": "Engineered for your chassis. Professional install required. If it doesn't fit, we make it right."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "race_car",
            "heading": "Real People, Same Day",
            "description": "Questions? We answer same day. Real enthusiasts, not call centers. ",
            "show_email": true
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "computer",
            "heading": "Secure Checkout",
            "description": "256-bit encryption. Affirm available. All major cards accepted."
          }
        }
      ]
    }
  ]
}
{% endschema %}
