<!doctype html>
{%- liquid
    if settings.select_layout
        if settings.list_iso_rtl != blank
            assign locale_iso_code = request.locale.iso_code
            assign arr_list_rtl = settings.list_iso_rtl | remove:' ' | split:',' 
            if arr_list_rtl contains locale_iso_code
                assign enable_iso_rtl = true
            else
                assign enable_iso_rtl = false
            endif
        endif
    else
        assign enable_iso_rtl = false
    endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" {% if settings.select_layout and enable_iso_rtl %} dir="rtl" {% endif %}>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <meta name="theme-color" content="">
        <link rel="canonical" href="{{ canonical_url }}">
        <link canonical-shop-url="{{ shop.url }}/">
        {%- if settings.favicon != blank -%}
            <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
        {%- endif -%}
        <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

        {%- unless settings.type_font_1_shopify_name.system? and settings.type_font_2_shopify_name.system? and settings.type_font_3_shopify_name.system? -%}
            <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
        {%- endunless -%}

        <title>
            {%- if request.page_type != 'search' -%}
                {{ page_title }}
                {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
                {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
                {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
            {%- else -%}
                {{ 'general.search.title' | t }} | {{ shop.name }}
            {%- endif -%}
        </title>

        {% if page_description %}
            <meta name="description" content="{{ page_description | escape }}">
        {% endif %}

        {% render 'meta-tags' %}
        {%- if request.page_type == '404' and request.path contains 'the-forging-process' -%}
          <meta http-equiv="refresh" content="0;url=/pages/about?view=the-forging-process">
          <script>location.replace('/pages/about?view=the-forging-process');</script>
        {%- endif -%}
        {{ content_for_header }}

        <style type="text/css" media="screen">
            {% render 'variable' %}
            {% render 'global' %}
        </style>

        {{ 'base.css' | asset_url | stylesheet_tag }}
        {%- if settings.select_layout and enable_iso_rtl -%}
            {{ 'rtl-base.css' | asset_url | stylesheet_tag }}
        {%- endif -%}
        {%- unless settings.type_font_1_shopify_name.system? -%}
            <link rel="preload" as="font" href="{{ settings.type_font_1_shopify_name | font_url }}" type="font/woff2" crossorigin>
        {%- endunless -%}
        {%- unless settings.type_font_2_shopify_name.system? -%}
            <link rel="preload" as="font" href="{{ settings.type_font_2_shopify_name | font_url }}" type="font/woff2" crossorigin>
        {%- endunless -%}
        {%- unless settings.type_font_3_shopify_name.system? -%}
            <link rel="preload" as="font" href="{{ settings.type_font_3_shopify_name | font_url }}" type="font/woff2" crossorigin>
        {%- endunless -%}
        <script>
            document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
            if (Shopify.designMode) {
                document.documentElement.classList.add('shopify-design-mode');
            }
        </script>
        <script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>
        {%- liquid
      assign ff_about_redirect = false
      if request.page_type == 'page'
        if page.handle == 'about' or page.handle == 'about-us' or request.path contains '/pages/about'
          unless template.suffix == 'ff-about-copy' or template.suffix == 'ff-about'
            assign ff_about_redirect = true
          endunless
        endif
      endif
    -%}
    {%- if ff_about_redirect -%}
      <script>
        (function () {
          if (window.Shopify && Shopify.designMode) return;
          if (/[?&]view=ff-about-copy(?:&|$)/.test(location.search || '')) return;
          location.replace(location.pathname + '?view=ff-about-copy' + (location.hash || ''));
        })();
      </script>
    {%- endif -%}
    </head>
    {%- liquid
        assign page_type = request.page_type | replace: 'customers/', ''
        if settings.show_dark_mode
            assign default_dark_mode = settings.default_dark_mode
        endif
    -%}
    {%- assign ff_page_cache_bust = "now" | date: "%s%N" -%}
    <body data-ff-bust="{{ ff_page_cache_bust }}" class="body-full template-{{ page_type }} skin-{{ settings.layout }}{% if settings.select_layout and enable_iso_rtl %} rtl{% endif %}{% if default_dark_mode %} dark-mode{% endif %}">
        {%- if settings.show_dark_mode -%}
            <script>
                {%- if default_dark_mode -%}
                    localStorage.getItem('theme') === 'light' ? document.body.classList.remove('dark-mode') : document.body.classList.add('dark-mode');
                {%- else -%}
                    localStorage.getItem('theme') === 'dark' ? document.body.classList.add('dark-mode') : document.body.classList.remove('dark-mode');
                {%- endif -%}
            </script>
        {%- endif -%}
        <a class="skip-to-content-link visually-hidden" href="#MainContent">
            {{ "accessibility.skip_to_text" | t }}
        </a>
        {% render 'global-style' %}
        {% render 'global-script' %}
        {%- if settings.enable_preloading_screen -%}
            {% render 'preload-screen' %}
        {%- endif -%}
        {{ 'section-header.css' | asset_url | stylesheet_tag }}
        {{ 'component-header.css' | asset_url | stylesheet_tag }}
        {{ 'component-search.css' | asset_url | stylesheet_tag }}
        {{ 'component-menu.css' | asset_url | stylesheet_tag }}
        {% sections 'header-group' %}
        {% render 'wrapper-header', ajax_menu : false %}
        {%- if settings.enable_currencies -%}
            {% render 'halo-currency-js' %}
        {%- endif -%}
        
        <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
            {%- liquid
              assign ff_is_refund_policy = false
              assign ff_is_about_page = false
              assign ff_is_beadlock_packages = false
              if request.page_type == 'policy'
                if request.path contains 'refund-policy' or request.path contains 'refund_policy' or request.path contains 'return-policy'
                  assign ff_is_refund_policy = true
                endif
                if shop.refund_policy != blank and request.path == shop.refund_policy.url
                  assign ff_is_refund_policy = true
                endif
              endif
              if request.page_type == 'page'
                if page.handle == 'about' or page.handle == 'about-us' or request.path contains '/pages/about'
                  unless template.suffix == 'ff-about-copy' or template.suffix == 'ff-about-keep' or template.suffix == 'ff-about-now' or template.suffix == 'ff-about' or template.suffix == 'about'
                    assign ff_is_about_page = true
                  endunless
                endif
                if page.handle == 'beadlock-tire-packages' or page.handle == 'beadlock-and-tire-package' or page.handle == 'beadlock-tire-package' or request.path contains '/pages/beadlock-tire-package'
                  assign ff_is_beadlock_packages = true
                endif
              endif
            -%}
            {%- if ff_is_refund_policy -%}
              {% render 'ff-warranty-returns' %}
            {%- elsif ff_is_about_page -%}
              {% section 'ff-about' %}
            {%- elsif ff_is_beadlock_packages -%}
              {% section 'ff-beadlock-packages' %}
            {%- else -%}
              {{ content_for_layout }}
            {%- endif -%}
        </main>
        <div class="wrapper-footer">
            {{ 'section-footer.css' | asset_url | stylesheet_tag }}
            {% sections 'footer-group' %}
        </div>
        {% render 'ff-offer-popup' %}
        {{ 'ff-storefront-fix.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'ff-about-route.js' | asset_url }}" defer></script>
        <script src="{{ 'ff-offer-boot.js' | asset_url }}" defer></script>
        {% section 'halo-toolbar-mobile' %}
        {{ 'rtl-section-header.css' | asset_url | stylesheet_tag }}
        {{ 'rtl-section-footer.css' | asset_url | stylesheet_tag }}
        {% render 'halo-popup' %}
        {% render 'halo-sidebar' %}
        {% render 'halo-gdpr-cookie-consent' %}
        <div class="background-overlay"></div>
        {%- if settings.show_background_effect -%}
            <div class="background-effect {{ settings.background_effect }}" style="--duration-timing: {{ settings.background_effect_timing | append: 's' }};--opacity: {{ settings.background_effect_opacity | times: 0.01 }};"></div>
        {%- endif -%}
        <ul hidden>
            <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
        </ul>
        {% render 'global-script-2' %}
        {% capture notification %}{% render 'translation-lab-theme-editor-notification' %}{% endcapture %}{% unless notification contains "Liquid error" %}{{ notification }}{% endunless %}
        {% render 'theme-editor-notification' %}
        {% render 'theme-demo-notification' %}
        <script src="{{ 'halo-quick-search.js' | asset_url }}" defer="defer"></script>
        {% render 'ff-affiliate-trust-link' %}
        <script>
          (function () {
            function renameShopByStyle() {
              document.querySelectorAll('.menu-lv-1 .text, .menu-lv-2.nav-title-mobile .text, .menu-lv-2.nav-all-mobile .text').forEach(function (el) {
                var t = (el.textContent || '').replace(/\s+/g, ' ').trim();
                if (/^shop by style$/i.test(t)) el.textContent = 'WHEELS';
                else if (/^go to shop by style$/i.test(t)) el.textContent = 'Go to WHEELS';
              });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', renameShopByStyle);
            else renameShopByStyle();
          })();
        </script>
    </body>
</html>
