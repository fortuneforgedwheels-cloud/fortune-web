            function renameShopByStyle() {
              document.querySelectorAll('.menu-lv-1 .text, .menu-lv-2.nav-title-mobile .text, .menu-lv-2.nav-all-mobile .text').forEach(function (el) {
                var t = (el.textContent || '').replace(/\s+/g, ' ').trim();
