{%- liquid
  assign ff_wheel_pricing_type = ''
  assign product_title_up = product.title | upcase
  assign product_handle = product.handle | downcase

  if product.tags contains 'BEADLOCK' or product.tags contains 'beadlock'
    assign ff_wheel_pricing_type = 'beadlock'
  elsif product_handle contains 'beadlock' or product_title_up contains 'BEADLOCK'
    assign ff_wheel_pricing_type = 'beadlock'
  endif

  if ff_wheel_pricing_type == blank
    for col in product.collections
      assign col_handle = col.handle | downcase
      if col_handle contains 'beadlock'
        assign ff_wheel_pricing_type = 'beadlock'
        break
      endif
    endfor
  endif

  if ff_wheel_pricing_type == blank
    for col in product.collections
      assign col_handle = col.handle | downcase
      if col_handle contains 'two-piece' or col_handle contains 'two_piece'
        assign ff_wheel_pricing_type = 'two-piece'
        break
      elsif col_handle contains 'monoblock'
        assign ff_wheel_pricing_type = 'monoblock'
        break
      endif
    endfor
  endif

  if ff_wheel_pricing_type == blank
    if product.tags contains 'TWO-PIECE' or product.tags contains 'two-piece' or product.tags contains 'TWO PIECE'
      assign ff_wheel_pricing_type = 'two-piece'
    elsif product.tags contains 'MONOBLOCK' or product.tags contains 'monoblock'
      assign ff_wheel_pricing_type = 'monoblock'
    endif
  endif

  if ff_wheel_pricing_type == blank
    if product_title_up contains 'TWO-PIECE' or product_title_up contains '2-PIECE' or product_handle contains 'two-piece' or product_handle contains '2-piece'
      assign ff_wheel_pricing_type = 'two-piece'
    elsif product_title_up contains 'MONOBLOCK' or product_handle contains 'monoblock'
      assign ff_wheel_pricing_type = 'monoblock'
    endif
  endif

  assign ff_wheel_pricing_note = ''
  if ff_wheel_pricing_type == 'beadlock'
    assign ff_wheel_pricing_note = '(priced by the pair)'
  elsif ff_wheel_pricing_type == 'monoblock' or ff_wheel_pricing_type == 'two-piece'
    assign ff_wheel_pricing_note = '(priced per wheel)'
  endif
-%}{{- ff_wheel_pricing_note -}}
