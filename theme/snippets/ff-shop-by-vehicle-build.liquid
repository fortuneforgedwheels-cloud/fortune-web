{{ 'ff-shop-by-vehicle.css' | asset_url | stylesheet_tag }}

<section
  class="ff-sbv ff-sbv--page"
  id="ff-sbv-build"
  data-ff-sbv
  data-sbv-mode="build"
  data-catalog-url="{{ 'ff-vehicle-catalog.json' | asset_url }}"
  data-fitment-url="{{ 'ff-vehicle-fitments.json' | asset_url }}"
  data-ff-fitments-url="{{ 'ff-ff-fitments.json' | asset_url }}"
  data-collection-mono="/collections/monoblock-wheels"
  data-collection-two="/collections/two-piece-wheels"
  data-collection-bead="/collections/beadlock-wheels"
  data-home-url="/"
>
  <div class="ff-sbv__page-wrap">
    <header class="ff-sbv__page-head">
      <a class="ff-sbv__back" href="/">&larr; Back to home</a>
      <h1 class="ff-sbv__page-title">Build your wheels</h1>
      <p class="ff-sbv__page-vehicle" data-ff-sbv-page-vehicle>Select a vehicle to begin.</p>
    </header>

    <div class="ff-sbv__specs ff-sbv__specs--page" data-ff-sbv-specs hidden>
      <p class="ff-sbv__specs-line" data-ff-sbv-specs-line></p>
    </div>

    <div class="ff-sbv__layout-chooser" data-ff-sbv-layout-chooser hidden>
      <p class="ff-sbv__layout-chooser-label">Choose your fitment layout</p>
      <div class="ff-sbv__layout-options">
        <button type="button" class="ff-sbv__layout-option" data-ff-sbv-layout="staggered">Staggered</button>
        <button type="button" class="ff-sbv__layout-option" data-ff-sbv-layout="square">Square</button>
        <button type="button" class="ff-sbv__layout-option" data-ff-sbv-layout="beadlock">Beadlock</button>
      </div>
    </div>

    <div class="ff-sbv__fitment-card" data-ff-sbv-fitment hidden></div>

    <div class="ff-sbv__builder" data-ff-sbv-builder hidden>
      <div class="ff-sbv__builder-head">
        <h2 class="ff-sbv__builder-title" data-ff-sbv-builder-title>Configure your set</h2>
        <p class="ff-sbv__builder-sub" data-ff-sbv-builder-sub></p>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="style">
        <p class="ff-sbv__builder-label">Wheel style</p>
        <div class="ff-sbv__styles">
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="mono">Monoblock</button>
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="two">2-Piece</button>
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="bead">Beadlock</button>
        </div>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="design" hidden>
        <p class="ff-sbv__builder-label">Wheel design</p>
        <div class="ff-sbv__designs" data-ff-sbv-designs>
          <p class="ff-sbv__loading">Loading designs…</p>
        </div>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="finish" hidden>
        <div class="ff-sbv__finish-panel" data-ff-sbv-finish-single>
          <label class="ff-sbv__builder-label" for="ff-sbv-finish-select">Finish</label>
          <select id="ff-sbv-finish-select" class="ff-sbv__select" data-ff-sbv-finish-select>
            <option value="">Select finish…</option>
          </select>
        </div>

        <div class="ff-sbv__finish-panel" data-ff-sbv-finish-twopiece hidden>
          <label class="ff-sbv__builder-label" for="ff-sbv-face-finish-select">Face finish</label>
          <select id="ff-sbv-face-finish-select" class="ff-sbv__select" data-ff-sbv-face-finish-select>
            <option value="">Select face finish…</option>
          </select>

          <label class="ff-sbv__builder-label" for="ff-sbv-barrel-finish-select">Barrel finish</label>
          <select id="ff-sbv-barrel-finish-select" class="ff-sbv__select" data-ff-sbv-barrel-finish-select>
            <option value="">Select barrel finish…</option>
          </select>
        </div>

        <div class="ff-sbv__finish-panel" data-ff-sbv-hardware-panel hidden>
          <label class="ff-sbv__builder-label" for="ff-sbv-hardware-select">Hardware</label>
          <select id="ff-sbv-hardware-select" class="ff-sbv__select" data-ff-sbv-hardware-select>
            <option value="Silver">Silver</option>
            <option value="Black">Black</option>
            <option value="Hidden">Hidden</option>
          </select>
        </div>
      </div>

      <div class="ff-sbv__builder-actions">
        <button type="button" class="ff-sbv__add-cart" data-ff-sbv-add-cart disabled>Add to cart</button>
        <p class="ff-sbv__error" data-ff-sbv-error hidden></p>
      </div>
    </div>

    <p class="ff-sbv__helper ff-sbv__helper--page">Start with staggered, square, or beadlock — then pick a fitment, wheel style, and design.</p>
  </div>
</section>

<script src="{{ 'ff-shop-by-vehicle-v3.js' | asset_url }}" defer></script>
