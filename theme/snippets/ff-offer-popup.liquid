{%- unless ff_offer_popup_included -%}
{%- assign ff_offer_popup_included = true -%}
{{ 'ff-offer-popup-v2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign delay_ms = 5 | times: 1000
  assign expire_days = 14
  assign offer_heading = 'Get $100 Off Your Entire Order'
  assign offer_subheading = 'Limited time offer for first-time customers. Premium mods, fast support and zero regrets. Built for real enthusiasts.'
  assign offer_button = 'Claim Offer'
  assign offer_tags = 'newsletter, first-time-100-off, email100'
  assign offer_code = 'EMAIL100'
  assign offer_disclaimer = 'By signing up, you agree to receive marketing emails. View our privacy policy and terms of service for more info.'
  assign offer_success_title = 'Your $100 off code'
  assign offer_success = 'Use this code at checkout for $100.00 off your order.'
  assign offer_image = images['BMW_F80_25MP_HighQuality.jpg']
  if offer_image == blank and settings.newsletter_popup_image != blank
    assign offer_image = settings.newsletter_popup_image
  endif
-%}

<div
  class="ff-offer"
  id="ff-offer-popup"
  data-ff-offer
  data-ff-offer-delay="{{ delay_ms }}"
  data-ff-offer-expire="{{ expire_days }}"
  data-ff-offer-code="{{ offer_code | escape }}"
  hidden
  aria-hidden="true"
>
  <div class="ff-offer__backdrop" data-ff-offer-close tabindex="-1"></div>
  <div class="ff-offer__dialog" role="dialog" aria-modal="true" aria-labelledby="ff-offer-title">
    <button type="button" class="ff-offer__close" data-ff-offer-close aria-label="Close offer">
      <span class="ff-offer__close-icon" aria-hidden="true">&times;</span>
    </button>
    <div class="ff-offer__media" aria-hidden="true">
      {%- if offer_image != blank -%}
        {{
          offer_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '480, 720, 960, 1200',
            sizes: '(max-width: 749px) 100vw, 42vw',
            alt: ''
        }}
      {%- else -%}
        <img
          class="ff-offer__fallback-img"
          src="{{ 'BMW_F80_25MP_HighQuality.jpg' | file_url }}"
          alt=""
          loading="lazy"
          width="800"
          height="1000"
        >
      {%- endif -%}
    </div>
    <div class="ff-offer__panel">
      <div class="ff-offer__content" data-ff-offer-content>
        <h2 class="ff-offer__title" id="ff-offer-title">{{ offer_heading | escape }}</h2>
        <p class="ff-offer__sub">{{ offer_subheading | escape }}</p>
        {%- form 'customer', class: 'ff-offer__form', id: 'ff-offer-contact' -%}
          <input type="hidden" name="contact[tags]" value="{{ offer_tags | escape }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <input class="ff-offer__input" type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name">
          <input class="ff-offer__input" type="email" name="contact[email]" placeholder="Email" autocomplete="email" required>
          <button type="submit" class="ff-offer__submit">{{ offer_button | escape }}</button>
        {%- endform -%}
        <p class="ff-offer__disclaimer">{{ offer_disclaimer | escape }}</p>
      </div>
      <div class="ff-offer__thanks" data-ff-offer-success hidden>
        <h2 class="ff-offer__title">{{ offer_success_title | escape }}</h2>
        <p class="ff-offer__sub">{{ offer_success | escape }}</p>
        <div class="ff-offer__code-box">
          <code class="ff-offer__code" data-ff-offer-code-text>{{ offer_code | escape }}</code>
          <button type="button" class="ff-offer__copy" data-ff-offer-copy>Copy code</button>
        </div>
        <a class="ff-offer__apply" href="/discount/{{ offer_code | url_encode }}?redirect=/collections/all">
          Apply $100 off &amp; shop
        </a>
        <p class="ff-offer__thanks-hint">We’ll also email this code if your welcome automation is on. Tap the X to close.</p>
      </div>
    </div>
  </div>
</div>
<script src="{{ 'ff-offer-boot-v2.js' | asset_url }}" defer></script>
{%- endunless -%}
