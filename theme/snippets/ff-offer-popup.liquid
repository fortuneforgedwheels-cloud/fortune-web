{{ 'ff-offer-popup.css' | asset_url | stylesheet_tag }}

{%- assign delay_ms = 5000 -%}
{%- assign expire_days = 14 -%}
{%- assign offer_image = images['IMG_2176.jpg'] -%}

<div
  class="ff-offer"
  id="ff-offer-global"
  data-ff-offer
  data-ff-offer-delay="{{ delay_ms }}"
  data-ff-offer-expire="{{ expire_days }}"
  hidden
  aria-hidden="true"
>
  <div class="ff-offer__backdrop" data-ff-offer-close tabindex="-1"></div>
  <div class="ff-offer__dialog" role="dialog" aria-modal="true" aria-labelledby="ff-offer-title">
    <button type="button" class="ff-offer__close" data-ff-offer-close aria-label="Close offer">
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="ff-offer__media" aria-hidden="true">
      {%- if offer_image != blank -%}
        {{
          offer_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '480, 720, 960, 1200',
            sizes: '(max-width: 749px) 100vw, 42vw',
            alt: ''
        }}
      {%- else -%}
        <div class="ff-offer__media-placeholder"></div>
      {%- endif -%}
    </div>

    <div class="ff-offer__panel">
      <h2 class="ff-offer__title" id="ff-offer-title">Limited time: $100 off your entire order</h2>
      <p class="ff-offer__sub">First-time customers only. Premium forged wheels, fast support, and zero regrets.</p>

      {%- form 'customer', class: 'ff-offer__form', id: 'ff-offer-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, first-time-100-off">
        <label class="visually-hidden" for="ff-offer-first">First name</label>
        <input
          id="ff-offer-first"
          class="ff-offer__input"
          type="text"
          name="contact[first_name]"
          placeholder="First name"
          autocomplete="given-name"
        >
        <label class="visually-hidden" for="ff-offer-email">Email</label>
        <input
          id="ff-offer-email"
          class="ff-offer__input"
          type="email"
          name="contact[email]"
          placeholder="Email"
          autocomplete="email"
          required
        >
        <button type="submit" class="ff-offer__submit">Claim Offer</button>
      {%- endform -%}

      <p class="ff-offer__disclaimer">By signing up, you agree to receive marketing emails. View our privacy policy and terms of service for more info.</p>
      <p class="ff-offer__success" data-ff-offer-success hidden>You're in - check your email for your $100 off code.</p>
    </div>
  </div>
</div>

<script src="{{ 'ff-offer-popup.js' | asset_url }}" defer></script>
