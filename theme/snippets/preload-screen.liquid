{%- comment -%}
  Page-transition preload. Visual loader is intentionally invisible
  (replaces the previous tire/wheel GIF) so navigations stay clean.
{%- endcomment -%}
{%- unless request.design_mode -%}
  {%- if settings.enable_preloading_screen -%}
    <preload-screen
      class="preload-screen preload-screen--invisible pos-fixed top-0 left-0 w-100v h-100v di-flex a-i-center j-c-center gradient o-h e-none no-js-hidden di-block"
      style="--color-background: {{ settings.preloading_screen_bg | default: 'transparent' }};"
      aria-hidden="true"
    >
      <span class="loading-bar loading-bar--invisible pos-relative o-h"></span>
    </preload-screen>
  {%- endif -%}
{%- endunless -%}
