{% comment %}
  Recommended vs advanced fitment preference (cart property only).
  Does not remove existing width/offset option UIs — those stay available for advanced customers.
{% endcomment %}
{%- liquid
  assign ff_is_fullset_priced = false
  if product != blank
    assign ff_tags_up = product.tags | join: ',' | upcase
    assign ff_type_up = product.type | upcase
    assign ff_handle_up = product.handle | upcase
    unless ff_tags_up contains 'BEADLOCK' or ff_handle_up contains 'BEADLOCK' or ff_type_up contains 'BEADLOCK'
      if ff_tags_up contains 'MONOBLOCK' or ff_type_up contains 'MONOBLOCK' or ff_handle_up contains 'MONOBLOCK'
        assign ff_is_fullset_priced = true
      elsif ff_tags_up contains 'TWO PIECE' or ff_tags_up contains 'TWO-PIECE' or ff_tags_up contains '2-PIECE' or ff_tags_up contains '2 PIECE' or ff_type_up contains 'TWO' or ff_handle_up contains 'TWO-PIECE'
        assign ff_is_fullset_priced = true
      endif
    endunless
  endif
-%}
{%- if ff_is_fullset_priced -%}
  <div class="ff-fitment-path" data-ff-fitment-path>
    <p class="ff-fitment-path__title">Fitment preference</p>
    <div class="ff-fitment-path__options">
      <label class="ff-fitment-path__option">
        <input type="radio" name="properties[Fitment Method]" value="Have Fortune Forged build my fitment" checked data-ff-fitment-mode="recommended">
        <span>
          <strong>Have Fortune Forged build my fitment</strong>
          <em>Recommended — tell us your vehicle, diameter, and finish. We determine width &amp; offset.</em>
        </span>
      </label>
      <label class="ff-fitment-path__option">
        <input type="radio" name="properties[Fitment Method]" value="I know my wheel specs" data-ff-fitment-mode="advanced">
        <span>
          <strong>I know my wheel specs</strong>
          <em>Advanced — enter exact width, offset, and other measurements below if you prefer.</em>
        </span>
      </label>
    </div>
    <input type="hidden" name="properties[Order Type]" value="Full Set">
  </div>
{%- endif -%}
