{%- comment -%}
  Renders a product grid for one quote style collection.
  Accepts: collection, style_name, price_range
  Embeds live Shopify variant prices for diameter/width steps.
{%- endcomment -%}
{%- if collection != blank and collection.products_count > 0 -%}
  <div class="ff-build__wheels" data-wheels-panel="{{ style_name | escape }}" hidden>
    {%- for product in collection.products limit: 48 -%}
      {%- assign card_image = product.featured_media.preview_image | default: product.featured_image -%}
      {%- assign card_price = product.price | money -%}
      {%- capture variants_json -%}[{%- for variant in product.variants -%}{"o":{{ variant.option1 | json }},"p":{{ variant.price }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
      <button
        type="button"
        class="ff-build__wheel"
        data-wheel-select
        data-style="{{ style_name | escape }}"
        data-wheel-title="{{ product.title | escape }}"
        data-wheel-handle="{{ product.handle | escape }}"
        data-wheel-url="{{ product.url }}"
        data-wheel-price="{{ card_price | escape }}"
        data-wheel-price-cents="{{ product.price }}"
        data-wheel-unit="{% if style_name == 'Beadlock' %}pair{% else %}wheel{% endif %}"
        data-wheel-variants="{{ variants_json | escape }}"
        data-price-range="{{ price_range | escape }}"
      >
        <span class="ff-build__wheel-media">
          {%- if card_image != blank -%}
            {{
              card_image
              | image_url: width: 480
              | image_tag:
                loading: 'lazy',
                widths: '160,240,320,480',
                sizes: '(min-width: 750px) 140px, 42vw',
                alt: product.title
            }}
          {%- else -%}
            <span class="ff-build__wheel-placeholder" aria-hidden="true">FF</span>
          {%- endif -%}
        </span>
        <span class="ff-build__wheel-meta">
          <span class="ff-build__wheel-title">{{ product.title | escape }}</span>
          <span class="ff-build__wheel-price">{{ card_price }}</span>
        </span>
      </button>
    {%- endfor -%}
  </div>
{%- else -%}
  <div class="ff-build__wheels ff-build__wheels--empty" data-wheels-panel="{{ style_name | escape }}" hidden>
    <p class="ff-build__hint">No wheels found for this setup yet. You can still continue with {{ style_name | escape }}.</p>
  </div>
{%- endif -%}
