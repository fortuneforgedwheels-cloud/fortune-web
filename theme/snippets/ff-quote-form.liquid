{%- assign contact_form_id = 'FFQuoteForm-' | append: section.id -%}

{%- form 'contact', id: contact_form_id, class: 'ff-quote' -%}
  {%- if form.posted_successfully? -%}
    <div class="ff-quote__success" role="status" data-ff-quote-success>
      Thanks — we received your quote request. If you left fitment blank, a specialist will email or call you back to help.
    </div>
  {%- elsif form.errors -%}
    <div class="ff-quote__error" role="alert">
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}

  <input type="hidden" name="contact[form_name]" value="Fortune Forged Build Quote">
  <input type="hidden" name="contact[selected_vehicle]" id="ff-selected-vehicle-{{ section.id }}" value="">
  <input type="hidden" name="contact[selected_style]" id="ff-selected-style-{{ section.id }}" value="">
  <input type="hidden" name="contact[custom_design_reference]" id="ff-custom-design-reference-{{ section.id }}" value="">
  <input type="hidden" name="contact[vehicle]" id="ff-ymm-{{ section.id }}" value="" required>
  <input type="hidden" name="contact[design]" id="ff-design-{{ section.id }}" value="">

  <div class="ff-quote__summary" data-build-summary>
    <p class="ff-build__label ff-quote__summary-title">Your build</p>
    <dl class="ff-quote__summary-list">
      <div class="ff-quote__summary-row">
        <dt>Vehicle</dt>
        <dd data-summary-vehicle>—</dd>
      </div>
      <div class="ff-quote__summary-row">
        <dt>Wheel Type</dt>
        <dd data-summary-style>—</dd>
      </div>
      <div class="ff-quote__summary-row">
        <dt>Design</dt>
        <dd data-summary-design>—</dd>
      </div>
    </dl>
  </div>

  <p class="ff-build__label ff-quote__section-label">Contact information</p>
  <div class="ff-quote__grid">
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-name-{{ section.id }}">Name*</label>
      <input class="ff-build__input" id="ff-name-{{ section.id }}" type="text" name="contact[name]" required
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        autocomplete="name">
    </div>
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-phone-{{ section.id }}">Phone*</label>
      <input class="ff-build__input" id="ff-phone-{{ section.id }}" type="tel" name="contact[phone]" required
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        autocomplete="tel">
    </div>
    <div class="ff-quote__field ff-quote__field--full">
      <label class="ff-build__label" for="ff-email-{{ section.id }}">Email*</label>
      <input class="ff-build__input" id="ff-email-{{ section.id }}" type="email" name="contact[email]" required
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        autocomplete="email">
    </div>
  </div>

  <fieldset class="ff-quote__timeline">
    <legend class="ff-build__label">When are you looking to order? (optional)</legend>
    <div class="ff-quote__timeline-options">
      <label class="ff-quote__timeline-option">
        <input type="radio" name="contact[purchase_timeline]" value="Ready now">
        <span>Ready now</span>
      </label>
      <label class="ff-quote__timeline-option">
        <input type="radio" name="contact[purchase_timeline]" value="Within 1–2 weeks">
        <span>Within 1–2 weeks</span>
      </label>
      <label class="ff-quote__timeline-option">
        <input type="radio" name="contact[purchase_timeline]" value="A few months out">
        <span>A few months out</span>
      </label>
    </div>
  </fieldset>

  <div class="ff-quote__field ff-quote__field--stack">
    <label class="ff-build__label" for="ff-finish-{{ section.id }}">Finish (optional)</label>
    <input class="ff-build__input" id="ff-finish-{{ section.id }}" type="text" name="contact[finish]"
      placeholder="Brushed silver, polished, gloss black, etc." value="">
  </div>

  <div class="ff-quote__field ff-quote__field--stack">
    <label class="ff-build__label" for="ff-notes-{{ section.id }}">Additional notes (optional)</label>
    <textarea class="ff-build__input ff-build__textarea" id="ff-notes-{{ section.id }}" name="contact[body]" rows="3"
      placeholder="Know your specs? Add your desired diameter, widths, offsets, tire setup, or anything else we should know."></textarea>
  </div>

  <div class="ff-quote__actions">
    <button type="button" class="ff-build__back" data-back="2">Back</button>
    <button type="submit" class="button button--primary ff-build__submit">
      GET MY CUSTOM QUOTE
    </button>
  </div>
{%- endform -%}
