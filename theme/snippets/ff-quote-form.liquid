{%- assign contact_form_id = 'FFQuoteForm-' | append: section.id -%}

{%- form 'contact', id: contact_form_id, class: 'ff-quote' -%}
  {%- if form.posted_successfully? -%}
    <div class="ff-quote__success" role="status" data-ff-quote-success>
      Thanks — we received your quote request. Our team will follow up shortly.
    </div>
  {%- elsif form.errors -%}
    <div class="ff-quote__error" role="alert">
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}

  <input type="hidden" name="contact[form_name]" value="Fortune Forged Build Quote">
  <input type="hidden" name="contact[selected_vehicle]" id="ff-selected-vehicle-{{ section.id }}" value="">
  <input type="hidden" name="contact[selected_style]" id="ff-selected-style-{{ section.id }}" value="">
  <input type="hidden" name="contact[selected_price_range]" id="ff-selected-price-{{ section.id }}" value="">
  <input type="hidden" name="contact[help_preference]" id="ff-help-preference-{{ section.id }}" value="I know my specs">
  <input type="hidden" name="contact[budget_range]" id="ff-budget-value-{{ section.id }}" value="" data-budget-value>
  <input type="hidden" name="contact[purchase_timeline]" id="ff-timeline-value-{{ section.id }}" value="" data-timeline-value>
  <input type="hidden" name="contact[serious_buyer]" id="ff-intent-value-{{ section.id }}" value="" data-intent-value>

  <fieldset class="ff-quote__qualify" data-budget-field>
    <legend class="ff-build__label">{{ section.settings.budget_legend | default: 'What’s your budget for a full set?' | escape }}*</legend>
    <div class="ff-quote__picks" role="list">
      <label class="ff-quote__pick">
        <input type="radio" name="ff_budget" value="Under $2,500" data-budget-pick required>
        <span>Under $2,500</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_budget" value="$2,500–$4,000" data-budget-pick>
        <span>$2,500–$4,000</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_budget" value="$4,000–$6,000" data-budget-pick>
        <span>$4,000–$6,000</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_budget" value="$6,000+" data-budget-pick>
        <span>$6,000+</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_budget" value="Not sure yet — educate me" data-budget-pick>
        <span>Not sure yet — educate me</span>
      </label>
    </div>
    <p class="ff-quote__budget-warn" data-budget-warn hidden>
      That budget is usually below a full Fortune Forged set for the setup you picked. You can still continue — we’ll be honest about options.
    </p>
  </fieldset>

  <fieldset class="ff-quote__qualify" data-timeline-field>
    <legend class="ff-build__label">{{ section.settings.timeline_legend | default: 'When do you want to order?' | escape }}*</legend>
    <div class="ff-quote__picks" role="list">
      <label class="ff-quote__pick">
        <input type="radio" name="ff_timeline" value="Ready to order in the next 2 weeks" data-timeline-pick required>
        <span>Ready in the next 2 weeks</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_timeline" value="Planning for the next 1–3 months" data-timeline-pick>
        <span>Planning for 1–3 months</span>
      </label>
      <label class="ff-quote__pick">
        <input type="radio" name="ff_timeline" value="Just researching for now" data-timeline-pick>
        <span>Just researching for now</span>
      </label>
    </div>
  </fieldset>

  <fieldset class="ff-quote__path">
    <legend class="ff-build__label">How should we help?</legend>
    <label class="ff-quote__choice">
      <input type="radio" name="ff_help_mode" value="specs" checked data-help-mode>
      <span>
        <strong>I know my sizes / finish</strong>
        <em>I’ll type them below (optional but helpful)</em>
      </span>
    </label>
    <label class="ff-quote__choice">
      <input type="radio" name="ff_help_mode" value="specialist" data-help-mode>
      <span>
        <strong>Have a specialist guide me</strong>
        <em>We’ll email or call you back to assist</em>
      </span>
    </label>
  </fieldset>

  <div class="ff-quote__grid">
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-name-{{ section.id }}">Name*</label>
      <input class="ff-build__input" id="ff-name-{{ section.id }}" type="text" name="contact[name]" required
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        autocomplete="name">
    </div>
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-phone-{{ section.id }}">Phone*</label>
      <input class="ff-build__input" id="ff-phone-{{ section.id }}" type="tel" name="contact[phone]" required
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        autocomplete="tel">
    </div>
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-email-{{ section.id }}">Email*</label>
      <input class="ff-build__input" id="ff-email-{{ section.id }}" type="email" name="contact[email]" required
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        autocomplete="email">
    </div>
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-contact-pref-{{ section.id }}">Preferred callback</label>
      <select class="ff-build__input" id="ff-contact-pref-{{ section.id }}" name="contact[callback_preference]">
        <option value="Email or phone — whichever is fastest">Email or phone — whichever is fastest</option>
        <option value="Email me">Email me</option>
        <option value="Call me back">Call me back</option>
      </select>
    </div>
    <div class="ff-quote__field">
      <label class="ff-build__label" for="ff-ymm-{{ section.id }}">Year / Make / Model*</label>
      <input class="ff-build__input" id="ff-ymm-{{ section.id }}" type="text" name="contact[vehicle]" required
        placeholder="e.g. 2024 BMW G80 M3" value="">
    </div>
    <div class="ff-quote__field ff-quote__specs">
      <label class="ff-build__label" for="ff-design-{{ section.id }}">Desired design</label>
      <input class="ff-build__input" id="ff-design-{{ section.id }}" type="text" name="contact[design]"
        placeholder="Wheel model / design name (optional)" value="">
    </div>
    <div class="ff-quote__field ff-quote__specs">
      <label class="ff-build__label" for="ff-front-{{ section.id }}">Front size</label>
      <input class="ff-build__input" id="ff-front-{{ section.id }}" type="text" name="contact[front_size]"
        placeholder="e.g. 20x9.5" value="" data-spec-field>
    </div>
    <div class="ff-quote__field ff-quote__specs">
      <label class="ff-build__label" for="ff-rear-{{ section.id }}">Rear size</label>
      <input class="ff-build__input" id="ff-rear-{{ section.id }}" type="text" name="contact[rear_size]"
        placeholder="e.g. 20x11" value="" data-spec-field>
    </div>
    <div class="ff-quote__field ff-quote__specs">
      <label class="ff-build__label" for="ff-finish-{{ section.id }}">Finish</label>
      <input class="ff-build__input" id="ff-finish-{{ section.id }}" type="text" name="contact[finish]"
        placeholder="Brushed, polished, gloss black…" value="" data-spec-field>
    </div>
    <div class="ff-quote__field ff-quote__field--full">
      <label class="ff-build__label" for="ff-notes-{{ section.id }}">Anything else?</label>
      <textarea class="ff-build__input ff-build__textarea" id="ff-notes-{{ section.id }}" name="contact[body]" rows="3"
        placeholder="Optional — goals, deadlines, or questions."></textarea>
    </div>
  </div>

  <p class="ff-quote__assist-note" data-assist-note hidden>
    Leave sizes and finish blank if you’re unsure. A Fortune Forged fitment specialist will email or call you back to assist.
  </p>

  <label class="ff-quote__intent">
    <input type="checkbox" name="ff_intent" value="yes" data-intent-check required>
    <span>{{ section.settings.intent_label | default: 'I understand Fortune Forged wheels are a premium forged product, I’ve seen the typical price range, and I’m requesting this quote because I’m seriously considering a purchase.' | escape }}</span>
  </label>

  <div class="ff-quote__actions">
    <button type="submit" class="button button--primary ff-build__submit" data-submit-label disabled>
      {{ section.settings.submit_label | default: 'Submit my quote request' | escape }}
    </button>
    <p class="ff-quote__submit-hint" data-submit-hint>
      Choose budget, timing, and confirm you’re ready to continue.
    </p>
  </div>
{%- endform -%}
