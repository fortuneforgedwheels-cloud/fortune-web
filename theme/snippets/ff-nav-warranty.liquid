{%- comment -%}
  Adds WARRANTY to nav when the page is not already present in the menu.
  Optional: level (default 1) for desktop vs mobile list styling.
{%- endcomment -%}
{%- liquid
  assign ff_warranty_level = level | default: 1
  assign ff_warranty_url = '/pages/warranty'
  assign ff_warranty_page = pages['warranty']
  if ff_warranty_page != blank
    assign ff_warranty_url = ff_warranty_page.url
  endif
  assign ff_warranty_in_menu = false
  for link in menu
    if link.url == ff_warranty_url or link.url contains '/pages/warranty' or link.title == 'Warranty' or link.title == 'WARRANTY'
      assign ff_warranty_in_menu = true
      break
    endif
  endfor
-%}
{%- unless ff_warranty_in_menu -%}
  <li class="menu-lv-item menu-lv-{{ ff_warranty_level }} text-left{% if ff_warranty_level == 1 %} no-megamenu{% endif %}">
    <a
      href="{{ ff_warranty_url }}"
      class="menu-lv-{{ ff_warranty_level }}__action list-menu__item list-menu__item--end link focus-inset{% if request.path == ff_warranty_url or request.path contains '/pages/warranty' %} is-active{% endif %}"
      role="button"
      {% if request.path == ff_warranty_url or request.path contains '/pages/warranty' %}aria-current="page"{% endif %}
    >
      <span class="text">WARRANTY</span>
    </a>
  </li>
{%- endunless -%}
