{{ 'ff-826m-certified.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign path_label = path_label | default: 'Beadlock checkout'
  assign certified_fitment = certified_fitment | default: '18x11 ET15'
  assign certified_size = certified_size | default: '18X11'
  assign certified_width = certified_width | default: '11"'
  assign certified_offset = certified_offset | default: '+15'
  assign certified_lug = certified_lug | default: "PLUG N' PLAY || KEEP OEM SPECS"
  assign ymm_make_placeholder = ymm_make_placeholder | default: 'BMW'
  assign ymm_model_placeholder = ymm_model_placeholder | default: 'M3'
  assign ymm_placeholder = 'e.g. 2023 ' | append: ymm_make_placeholder | append: ' ' | append: ymm_model_placeholder

  assign certified_size_key = certified_size | upcase | replace: ' ', ''
  assign certified_variant_id = blank
  for variant in product.variants
    assign size_key = variant.option1 | upcase | replace: ' ', ''
    if size_key == certified_size_key
      assign certified_variant_id = variant.id
    endif
  endfor
-%}

<div
  class="ff-826m-path"
  id="ff-826m-path-{{ product.id }}"
  data-ff-826m-path
  data-product-id="{{ product.id }}"
  data-form-id="{{ form_id }}"
  data-certified-variant-id="{{ certified_variant_id }}"
  data-certified-size="{{ certified_size | escape }}"
  data-certified-width="{{ certified_width | escape }}"
  data-certified-offset="{{ certified_offset | escape }}"
  data-certified-lug="{{ certified_lug | escape }}"
>
  <p class="ff-826m-path__eyebrow">{{ path_label | escape }}</p>
  <h2 class="ff-826m-path__heading">How do you want to spec this pair?</h2>

  <div class="ff-826m-path__choices" role="radiogroup" aria-label="Spec path">
    <label class="ff-826m-path__choice">
      <input type="radio" name="ff_826m_path_{{ product.id }}" value="certified" checked>
      <span class="ff-826m-path__choice-card">
        <span class="ff-826m-path__choice-title">Fortune Certified Specs</span>
        <span class="ff-826m-path__choice-meta">
          Fitment locked to <strong>{{ certified_fitment | escape }}</strong>. Enter year / make / model, then choose ring, face, and bolt colors.
        </span>
      </span>
    </label>
    <label class="ff-826m-path__choice">
      <input type="radio" name="ff_826m_path_{{ product.id }}" value="custom">
      <span class="ff-826m-path__choice-card">
        <span class="ff-826m-path__choice-title">Select my own specs</span>
        <span class="ff-826m-path__choice-meta">Choose size, width, offset, lug pattern, colors, and vehicle details yourself.</span>
      </span>
    </label>
  </div>

  <div class="ff-826m-path__certified" data-ff-826m-certified-panel>
    <div class="ff-826m-path__badge">
      <span>Certified fitment locked</span>
      <strong>{{ certified_fitment | escape }}</strong>
    </div>

    <div class="ff-826m-path__ymm">
      <label class="ff-826m-path__field">
        <span>Year / Make / Model</span>
        <input
          type="text"
          name="properties[Year / Make / Model]"
          form="{{ form_id }}"
          autocomplete="off"
          placeholder="{{ ymm_placeholder | escape }}"
          data-ff-826m-required-certified
        >
      </label>
    </div>

    <div class="ff-826m-path__colors" data-ff-826m-color-slot>
      <p class="ff-826m-path__hint">Choose face, ring, and bolt color:</p>
      <label class="ff-826m-path__field" data-ff-826m-color-field="FACE COLOR">
        <span>Face color</span>
        <select class="ff-826m-path__select" data-ff-826m-color-select="FACE COLOR" required>
          <option value="">Choose one</option>
        </select>
      </label>
      <label class="ff-826m-path__field" data-ff-826m-color-field="RING COLOR">
        <span>Ring color</span>
        <select class="ff-826m-path__select" data-ff-826m-color-select="RING COLOR" required>
          <option value="">Choose one</option>
        </select>
      </label>
      <label class="ff-826m-path__field" data-ff-826m-color-field="BOLT COLOR">
        <span>Bolt color</span>
        <select class="ff-826m-path__select" data-ff-826m-color-select="BOLT COLOR" required>
          <option value="">Choose one</option>
        </select>
      </label>
    </div>

    <input type="hidden" name="properties[Spec Path]" value="Fortune Certified Specs" form="{{ form_id }}" data-ff-826m-certified-prop>
    <input type="hidden" name="properties[Certified Fitment]" value="{{ certified_fitment | escape }}" form="{{ form_id }}" data-ff-826m-certified-prop>
  </div>

  <div class="ff-826m-path__custom" data-ff-826m-custom-panel hidden>
    <p class="ff-826m-path__hint">Use the size, width, offset, lug pattern, color, and vehicle fields below to build your own spec.</p>
    <input type="hidden" name="properties[Spec Path]" value="Select my own specs" form="{{ form_id }}" data-ff-826m-custom-prop disabled>
  </div>
</div>

<script src="{{ 'ff-826m-certified.js' | asset_url }}" defer></script>
