{{ 'ff-shop-by-vehicle.css' | asset_url | stylesheet_tag }}

<section
  class="ff-sbv ff-sbv--compact"
  id="ff-sbv-home"
  data-ff-sbv
  data-sbv-mode="compact"
  data-catalog-url="{{ 'ff-vehicle-catalog.json' | asset_url }}"
  data-build-url="/pages/shop-by-vehicle?view=shop-by-vehicle-build"
>
<script>
  (function () {
    var el = document.getElementById('ff-sbv-home');
    if (!el) return;
    el.style.setProperty('--ff-sbv-bg', '#0a0a0a');
    el.style.setProperty('--ff-sbv-pad-y', '10px');
  })();
</script>
  <div class="ff-sbv__inner">
    <button
      type="button"
      class="ff-sbv__toggle"
      data-ff-sbv-toggle
      aria-expanded="false"
      aria-controls="ff-sbv-home-panel"
    >
      <span class="ff-sbv__heading">SHOP BY VEHICLE</span>
      <svg class="ff-sbv__chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M3 6 L8 11 L13 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"/>
      </svg>
    </button>

    <div class="ff-sbv__collapse" id="ff-sbv-home-panel" data-ff-sbv-collapse>
      <form class="ff-sbv__form" data-ff-sbv-form novalidate>
        <label class="ff-sbv__field">
          <span class="visually-hidden">Year</span>
          <select name="year" data-ff-sbv-year required>
            <option value="">Year</option>
          </select>
        </label>

        <label class="ff-sbv__field">
          <span class="visually-hidden">Make</span>
          <select name="make" data-ff-sbv-make required disabled>
            <option value="">Make</option>
          </select>
        </label>

        <label class="ff-sbv__field">
          <span class="visually-hidden">Model</span>
          <select name="model" data-ff-sbv-model required disabled>
            <option value="">Model</option>
          </select>
        </label>

        <label class="ff-sbv__field">
          <span class="visually-hidden">Chassis / trim</span>
          <select name="chassis" data-ff-sbv-chassis required disabled>
            <option value="">Chassis</option>
          </select>
        </label>

        <button type="submit" class="ff-sbv__go" data-ff-sbv-go disabled>
          <span>GO</span>
          <svg class="ff-sbv__go-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 13 L13 3 M6 3 H13 V10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/>
          </svg>
        </button>
      </form>

      <p class="ff-sbv__helper">Select your vehicle and click GO to choose fitment, wheel style, and finish.</p>
    </div>
  </div>
</section>

<script>
  (function () {
    var el = document.getElementById('ff-sbv-home');
    if (!el) return;
    var toggle = el.querySelector('[data-ff-sbv-toggle]');
    if (!toggle) return;

    function isMobile() {
      return window.matchMedia('(max-width: 900px)').matches;
    }

    toggle.addEventListener('click', function () {
      if (!isMobile()) return;
      var open = el.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    window.addEventListener('resize', function () {
      if (!isMobile()) {
        el.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

<script src="{{ 'ff-shop-by-vehicle-v3.js' | asset_url }}" defer></script>
