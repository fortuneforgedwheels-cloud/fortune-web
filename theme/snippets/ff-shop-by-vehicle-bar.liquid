{{ 'ff-shop-by-vehicle.css' | asset_url | stylesheet_tag }}

<section
  class="ff-sbv"
  id="ff-sbv-home"
  data-ff-sbv
  data-catalog-url="{{ 'ff-vehicle-catalog.json' | asset_url }}"
  data-fitment-url="{{ 'ff-vehicle-fitments.json' | asset_url }}"
  data-ff-fitments-url="{{ 'ff-ff-fitments.json' | asset_url }}"
  data-collection-mono="/collections/monoblock-wheels"
  data-collection-two="/collections/two-piece-wheels"
  data-collection-bead="/collections/beadlock-wheels"
  data-go-target="/#order"
>
<script>
  (function () {
    var el = document.getElementById('ff-sbv-home');
    if (!el) return;
    el.style.setProperty('--ff-sbv-bg', '#0a0a0a');
    el.style.setProperty('--ff-sbv-pad-y', '10px');
  })();
</script>
  <div class="ff-sbv__inner">
    <h2 class="ff-sbv__heading">SHOP BY VEHICLE</h2>

    <form class="ff-sbv__form" data-ff-sbv-form novalidate>
      <label class="ff-sbv__field">
        <span class="visually-hidden">Year</span>
        <select name="year" data-ff-sbv-year required>
          <option value="">Year</option>
        </select>
      </label>

      <label class="ff-sbv__field">
        <span class="visually-hidden">Make</span>
        <select name="make" data-ff-sbv-make required disabled>
          <option value="">Make</option>
        </select>
      </label>

      <label class="ff-sbv__field">
        <span class="visually-hidden">Model</span>
        <select name="model" data-ff-sbv-model required disabled>
          <option value="">Model</option>
        </select>
      </label>

      <label class="ff-sbv__field">
        <span class="visually-hidden">Chassis / trim</span>
        <select name="chassis" data-ff-sbv-chassis required disabled>
          <option value="">Chassis</option>
        </select>
      </label>

      <button type="submit" class="ff-sbv__go" data-ff-sbv-go disabled>
        <span>GO</span>
        <svg class="ff-sbv__go-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 13 L13 3 M6 3 H13 V10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/>
        </svg>
      </button>
    </form>

    <div class="ff-sbv__specs" data-ff-sbv-specs hidden>
      <p class="ff-sbv__specs-line" data-ff-sbv-specs-line></p>
    </div>

    <div class="ff-sbv__fitment-card" data-ff-sbv-fitment hidden></div>

    <div class="ff-sbv__builder" data-ff-sbv-builder hidden>
      <div class="ff-sbv__builder-head">
        <h3 class="ff-sbv__builder-title" data-ff-sbv-builder-title>Build your wheels</h3>
        <p class="ff-sbv__builder-sub" data-ff-sbv-builder-sub></p>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="style">
        <p class="ff-sbv__builder-label">Wheel style</p>
        <div class="ff-sbv__styles">
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="mono">Monoblock</button>
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="two">2-Piece</button>
          <button type="button" class="ff-sbv__style" data-ff-sbv-style="bead">Beadlock</button>
        </div>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="design" hidden>
        <p class="ff-sbv__builder-label">Wheel design</p>
        <div class="ff-sbv__designs" data-ff-sbv-designs>
          <p class="ff-sbv__loading">Loading designs…</p>
        </div>
      </div>

      <div class="ff-sbv__builder-step" data-ff-sbv-step="finish" hidden>
        <p class="ff-sbv__builder-label">Finish</p>
        <div class="ff-sbv__finishes" data-ff-sbv-finishes>
          <button type="button" class="ff-sbv__finish is-selected" data-ff-sbv-finish="Brushed Clear">Brushed Clear</button>
          <button type="button" class="ff-sbv__finish" data-ff-sbv-finish="Polished Clear">Polished Clear</button>
          <button type="button" class="ff-sbv__finish" data-ff-sbv-finish="Gloss Black">Gloss Black</button>
          <button type="button" class="ff-sbv__finish" data-ff-sbv-finish="Satin Black">Satin Black</button>
        </div>
      </div>

      <div class="ff-sbv__builder-actions">
        <button type="button" class="ff-sbv__add-cart" data-ff-sbv-add-cart disabled>Add to cart</button>
        <p class="ff-sbv__error" data-ff-sbv-error hidden></p>
      </div>
    </div>

    <p class="ff-sbv__helper">Select your vehicle, choose a fitment, pick a wheel style and design — specs are added to your cart automatically.</p>
  </div>
</section>

<script src="{{ 'ff-shop-by-vehicle.js' | asset_url }}" defer></script>
