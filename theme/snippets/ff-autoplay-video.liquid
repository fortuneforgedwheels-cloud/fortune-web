{%- comment -%}
  Autoplay-friendly video markup for hero / lifestyle sections.
  Prefer MP4 over HLS (.m3u8). Chrome desktop does not play HLS in a
  plain <video> tag without hls.js, which made the hero look frozen.
  No nested poster <img>, preload=auto, muted + playsinline for mobile.
{%- endcomment -%}
{%- liquid
  assign video = video | default: blank
  assign class_name = class | default: ''
  assign poster_url = poster | default: blank
  assign mp4_url = blank
  if video != blank
    if poster_url == blank and video.preview_image != blank
      assign poster_url = video.preview_image | image_url: width: 2400
    endif
    assign mp4_sources = video.sources | where: 'format', 'mp4'
    if mp4_sources.size > 0
      assign mp4_url = mp4_sources.last.url
    endif
  endif
-%}
{%- if video != blank and mp4_url != blank -%}
<video
  class="{{ class_name }}"
  data-ff-autoplay-v="mp4-only-1"
  {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
  src="{{ mp4_url }}"
  autoplay
  muted
  loop
  playsinline
  webkit-playsinline
  preload="auto"
  disablepictureinpicture
></video>
{%- elsif video != blank -%}
{%- comment -%} Fallback: first non-HLS source if format filter returns nothing {%- endcomment -%}
<video
  class="{{ class_name }}"
  data-ff-autoplay-v="mp4-fallback-1"
  {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
  autoplay
  muted
  loop
  playsinline
  webkit-playsinline
  preload="auto"
  disablepictureinpicture
>
  {%- for source in video.sources -%}
    {%- if source.format == 'mp4' -%}
      <source src="{{ source.url }}" type="video/mp4">
    {%- endif -%}
  {%- endfor -%}
</video>
{%- endif -%}
