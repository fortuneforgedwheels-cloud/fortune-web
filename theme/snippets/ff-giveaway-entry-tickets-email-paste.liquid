{%- comment -%}
  ============================================================================
  PASTE THIS INTO SHOPIFY ADMIN (theme cannot inject notification Liquid)
  ============================================================================
  1) Settings → Notifications → Order confirmation → Edit code
  2) DELETE any older "giveaway entry tickets" / paid_entries / bonus_entries block
  3) Paste EVERYTHING between FF_TICKETS_EMAIL_START and FF_TICKETS_EMAIL_END
     as the FIRST thing inside {% capture email_body %}
     (must NOT be inside any {% if financial_status %} / payment branch)
  4) Save
  5) Also paste FF_TICKETS_STATUS_START…END into:
     Settings → Checkout → Order status page → Additional scripts
     (this powers “View your order” after checkout)

  How tickets are counted (in order):
  A) Line property "Invasion Bonus Entries" or "Giveaway ticket count"
  B) Cart attribute "Giveaway ticket count"
  C) Title fallback: "bmw" / "giveaway" → qty; "exclusive" → +5
  ============================================================================
{%- endcomment -%}

{%- comment -%} FF_TICKETS_EMAIL_START {%- endcomment -%}
{% assign ff_ticket_total = 0 %}
{% assign ff_ticket_bonus = false %}
{% for line_item in line_items %}
  {% assign ff_line_tickets = 0 %}
  {% for property in line_item.properties %}
    {% assign ff_pk = property.first | downcase %}
    {% assign ff_pv = property.last | plus: 0 %}
    {% if ff_pk == 'invasion bonus entries' %}
      {% if ff_pv > ff_line_tickets %}
        {% assign ff_line_tickets = ff_pv %}
        {% assign ff_ticket_bonus = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if ff_line_tickets == 0 %}
    {% for property in line_item.properties %}
      {% assign ff_pk = property.first | downcase %}
      {% assign ff_pv = property.last | plus: 0 %}
      {% if ff_pk == 'giveaway ticket count' %}
        {% if ff_pv > 0 %}
          {% assign ff_line_tickets = ff_pv %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if ff_line_tickets == 0 %}
    {% assign ff_title = line_item.title | downcase %}
    {% if ff_title contains 'exclusive' %}
      {% assign ff_line_tickets = 5 %}
      {% assign ff_ticket_bonus = true %}
    {% else %}
      {% if ff_title contains 'bmw' %}
        {% assign ff_line_tickets = line_item.quantity %}
      {% else %}
        {% if ff_title contains 'giveaway' %}
          {% assign ff_line_tickets = line_item.quantity %}
        {% else %}
          {% if ff_title contains 'm3' %}
            {% assign ff_line_tickets = line_item.quantity %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
  {% assign ff_ticket_total = ff_ticket_total | plus: ff_line_tickets %}
{% endfor %}
{% if ff_ticket_total == 0 %}
  {% for attribute in attributes %}
    {% assign ff_ak = attribute.first | downcase %}
    {% if ff_ak == 'giveaway ticket count' %}
      {% assign ff_ticket_total = attribute.last | plus: 0 %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if ff_ticket_total > 0 %}
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin:24px 0;border:2px solid #111;border-radius:8px;background:#fff;">
  <tr>
    <td style="padding:20px;font-family:Arial,Helvetica,sans-serif;color:#111;">
      <h2 style="margin:0 0 8px;font-size:20px;line-height:1.3;">Your giveaway entry tickets</h2>
      <p style="margin:0 0 14px;font-size:14px;line-height:1.5;">
        Master order: <strong>{{ name }}</strong>
        · {{ ff_ticket_total }} drawing ticket{% if ff_ticket_total != 1 %}s{% endif %}
      </p>
      <ol style="margin:0;padding-left:22px;font-size:16px;line-height:1.8;font-weight:700;">
        {% for i in (1..ff_ticket_total) %}
          <li style="margin:0 0 4px;">{{ name }}-{{ i }}</li>
        {% endfor %}
      </ol>
      {% if ff_ticket_bonus %}
      <p style="margin:14px 0 0;font-size:13px;line-height:1.45;color:#444;">Includes Invasion wheel-set bonus entries.</p>
      {% endif %}
      <p style="margin:12px 0 0;font-size:12px;line-height:1.4;color:#666;">
        Save these numbers ({{ name }}-1 … {{ name }}-{{ ff_ticket_total }}). They are what we use for the drawing — not separate Shopify orders.
      </p>
    </td>
  </tr>
</table>
{% endif %}
{%- comment -%} FF_TICKETS_EMAIL_END {%- endcomment -%}

{%- comment -%} FF_TICKETS_STATUS_START {%- endcomment -%}
{% assign ff_ticket_total = 0 %}
{% assign ff_ticket_bonus = false %}
{% assign ff_order_label = order_name | default: name %}
{% for line_item in line_items %}
  {% assign ff_line_tickets = 0 %}
  {% for property in line_item.properties %}
    {% assign ff_pk = property.first | downcase %}
    {% assign ff_pv = property.last | plus: 0 %}
    {% if ff_pk == 'invasion bonus entries' %}
      {% if ff_pv > ff_line_tickets %}
        {% assign ff_line_tickets = ff_pv %}
        {% assign ff_ticket_bonus = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if ff_line_tickets == 0 %}
    {% for property in line_item.properties %}
      {% assign ff_pk = property.first | downcase %}
      {% assign ff_pv = property.last | plus: 0 %}
      {% if ff_pk == 'giveaway ticket count' %}
        {% if ff_pv > 0 %}{% assign ff_line_tickets = ff_pv %}{% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if ff_line_tickets == 0 %}
    {% assign ff_title = line_item.title | downcase %}
    {% if ff_title contains 'exclusive' %}
      {% assign ff_line_tickets = 5 %}
      {% assign ff_ticket_bonus = true %}
    {% else %}
      {% if ff_title contains 'bmw' %}
        {% assign ff_line_tickets = line_item.quantity %}
      {% else %}
        {% if ff_title contains 'giveaway' %}
          {% assign ff_line_tickets = line_item.quantity %}
        {% else %}
          {% if ff_title contains 'm3' %}
            {% assign ff_line_tickets = line_item.quantity %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
  {% assign ff_ticket_total = ff_ticket_total | plus: ff_line_tickets %}
{% endfor %}
{% if ff_ticket_total == 0 %}
  {% for attribute in attributes %}
    {% assign ff_ak = attribute.first | downcase %}
    {% if ff_ak == 'giveaway ticket count' %}
      {% assign ff_ticket_total = attribute.last | plus: 0 %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if ff_ticket_total > 0 %}
<div id="ff-giveaway-tickets" style="margin:24px 0;padding:18px;border:2px solid #c5a46a;background:#111;color:#fff;font-family:Arial,Helvetica,sans-serif;">
  <h2 style="margin:0 0 8px;font-size:20px;color:#c5a46a;">Your giveaway entry tickets</h2>
  <p style="margin:0 0 12px;">Master order: <strong>{{ ff_order_label }}</strong> · {{ ff_ticket_total }} tickets</p>
  <ol style="margin:0;padding-left:22px;font-size:16px;font-weight:700;line-height:1.7;">
    {% for i in (1..ff_ticket_total) %}
      <li>{{ ff_order_label }}-{{ i }}</li>
    {% endfor %}
  </ol>
  {% if ff_ticket_bonus %}
  <p style="margin:12px 0 0;opacity:.85;font-size:13px;">Includes Invasion wheel-set bonus entries.</p>
  {% endif %}
</div>
{% endif %}
{%- comment -%} FF_TICKETS_STATUS_END {%- endcomment -%}
