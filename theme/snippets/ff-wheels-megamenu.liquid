{%- comment -%}
  Apex-style side-by-side mega menu for the WHEELS (Shop by Style) nav item.
  Columns: View all | Beadlock | Monoblock | Two Piece | Manufacturing
{%- endcomment -%}
{{ 'ff-wheels-megamenu.css' | asset_url | stylesheet_tag }}
<style id="ff-wheels-mega-critical">
  /* Inline critical rules — keep popup open when cursor is under WHEELS */
  @media (min-width: 1025px) {
    [data-navigation] .ff-wheels-mega > .ff-wheels-mega__panel,
    [data-navigation] .ff-wheels-mega > .menu-lv__megamenu.ff-wheels-mega__panel {
      display: block !important;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      margin-top: -8px !important;
      padding-top: 8px !important;
      transform: none !important;
      z-index: 120 !important;
    }
    [data-navigation] .ff-wheels-mega > .ff-wheels-mega__panel::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: -96px;
      height: 96px;
      background: transparent;
      pointer-events: none;
    }
    [data-navigation] .ff-wheels-mega > .ff-wheels-mega__panel > .ff-wheels-mega__bridge {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: -96px;
      height: 96px;
      background: transparent;
      pointer-events: none;
    }
    [data-navigation] .ff-wheels-mega:hover > .ff-wheels-mega__panel,
    [data-navigation] .ff-wheels-mega:focus-within > .ff-wheels-mega__panel,
    [data-navigation] .ff-wheels-mega.is-open > .ff-wheels-mega__panel {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    [data-navigation] .ff-wheels-mega:hover > .ff-wheels-mega__panel::before,
    [data-navigation] .ff-wheels-mega:focus-within > .ff-wheels-mega__panel::before,
    [data-navigation] .ff-wheels-mega.is-open > .ff-wheels-mega__panel::before,
    [data-navigation] .ff-wheels-mega:hover > .ff-wheels-mega__panel > .ff-wheels-mega__bridge,
    [data-navigation] .ff-wheels-mega:focus-within > .ff-wheels-mega__panel > .ff-wheels-mega__bridge,
    [data-navigation] .ff-wheels-mega.is-open > .ff-wheels-mega__panel > .ff-wheels-mega__bridge {
      pointer-events: auto !important;
    }
    .ff-wheels-mega__heading,
    .ff-wheels-mega__heading--static,
    .ff-wheels-mega__list a,
    .ff-wheels-mega__cta,
    .ff-wheels-mega__arrow {
      color: #ffffff !important;
    }
    .ff-wheels-mega__cta {
      background: transparent !important;
      border: 1px solid #ffffff !important;
      font-size: 1.25rem !important;
    }
    .ff-wheels-mega__heading,
    .ff-wheels-mega__heading--static { font-size: 1.4rem !important; }
    .ff-wheels-mega__list a { font-size: 1.28rem !important; }
  }
</style>

<li class="menu-lv-item menu-lv-1 text-left has-megamenu ff-wheels-mega dropdown" data-ff-wheels-mega>
  <a
    class="menu-lv-1__action list-menu__item link focus-inset"
    href="/collections/all"
    role="button"
    aria-haspopup="true"
    aria-expanded="false"
    data-ff-wheels-trigger
  >
    <span class="text">WHEELS</span>
    <span class="icon-dropdown" data-toggle-menu-mb>
      {% render 'icon-caret-right' %}
    </span>
  </a>

  <div class="menu-lv__megamenu ff-wheels-mega__panel" data-ff-wheels-panel>
    <div class="ff-wheels-mega__bridge" data-ff-wheels-bridge aria-hidden="true"></div>
    <div class="ff-wheels-mega__inner">
      <div class="ff-wheels-mega__col ff-wheels-mega__col--cta">
        <a class="ff-wheels-mega__cta" href="/collections/all">View all Wheels</a>
      </div>

      <div class="ff-wheels-mega__col">
        <a class="ff-wheels-mega__heading" href="/collections/beadlock-wheels">
          <span>All Beadlock Wheels</span>
          <span class="ff-wheels-mega__arrow" aria-hidden="true">↗</span>
        </a>
        <ul class="ff-wheels-mega__list">
          <li>
            <a href="/collections/oem-beadlock-wheels">OEM Beadlock Wheels</a>
          </li>
          <li>
            <a href="/collections/ff-beadlock-wheels">FF Beadlock Wheels</a>
          </li>
        </ul>
      </div>

      <div class="ff-wheels-mega__col">
        <a class="ff-wheels-mega__heading" href="/collections/monoblock-wheels">
          <span>All Monoblock Wheels</span>
          <span class="ff-wheels-mega__arrow" aria-hidden="true">↗</span>
        </a>
        <ul class="ff-wheels-mega__list">
          <li>
            <a href="/collections/oem-monoblock-wheels">OEM Monoblock Wheels</a>
          </li>
          <li>
            <a href="/collections/ff-monoblock-wheels">FF Monoblock Wheels</a>
          </li>
        </ul>
      </div>

      <div class="ff-wheels-mega__col">
        <a class="ff-wheels-mega__heading" href="/collections/two-piece-wheels">
          <span>All Two Piece Wheels</span>
          <span class="ff-wheels-mega__arrow" aria-hidden="true">↗</span>
        </a>
        <ul class="ff-wheels-mega__list">
          <li>
            <a href="/collections/oem-two-piece-wheels">OEM Two Piece Wheels</a>
          </li>
          <li>
            <a href="/collections/ff-two-piece-wheels">FF Two Piece Wheels</a>
          </li>
        </ul>
      </div>

      <div class="ff-wheels-mega__col">
        <p class="ff-wheels-mega__heading ff-wheels-mega__heading--static">Manufacturing</p>
        <ul class="ff-wheels-mega__list">
          <li>
            <a href="/pages/faq?view=forgeflow" data-ff-forging-link>The Forging Process</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</li>
<script>
  (function () {
    if (window.__ffWheelsMegaBound) return;
    window.__ffWheelsMegaBound = true;

    function bind(root) {
      if (!root || root.dataset.ffMegaBound === '1') return;
      root.dataset.ffMegaBound = '1';

      var panel = root.querySelector('[data-ff-wheels-panel]');
      var trigger = root.querySelector('[data-ff-wheels-trigger]');
      var bridge = root.querySelector('[data-ff-wheels-bridge]');
      var timer = null;
      var CLOSE_MS = 450;

      function open() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
        root.classList.add('is-open');
        if (trigger) trigger.setAttribute('aria-expanded', 'true');
      }

      function closeSoon() {
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () {
          // Stay open if the cursor is still over the trigger, bridge, or panel.
          if (root.matches(':hover') || (panel && panel.matches(':hover'))) {
            timer = null;
            return;
          }
          root.classList.remove('is-open');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          timer = null;
        }, CLOSE_MS);
      }

      function onLeave(e) {
        var next = e.relatedTarget;
        if (next && root.contains(next)) {
          open();
          return;
        }
        closeSoon();
      }

      root.addEventListener('mouseenter', open);
      root.addEventListener('mouseleave', onLeave);
      if (panel) {
        panel.addEventListener('mouseenter', open);
        panel.addEventListener('mouseleave', onLeave);
      }
      if (bridge) {
        bridge.addEventListener('mouseenter', open);
        bridge.addEventListener('mouseleave', onLeave);
      }
      if (trigger) {
        trigger.addEventListener('mouseenter', open);
      }

      root.addEventListener('focusin', open);
      root.addEventListener('focusout', function (e) {
        if (!root.contains(e.relatedTarget)) closeSoon();
      });
    }

    function boot() {
      document.querySelectorAll('[data-ff-wheels-mega]').forEach(bind);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('shopify:section:load', boot);
  })();
</script>
